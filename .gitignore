# Byte-compiled / optimized / DLL files
__pycache__/
.idea
.playwright-mcp
.playwright-cli/
.claude/skills/ecpay/
.claude/scheduled_tasks.lock
odoo_env
xdg-utils-1.1.3.tar.gz
xdg-utils-1.1.3
muk_web_*
settings.local.json
resource/stitch_*

# Environment variables
.env
.env.local
.env.*.local
.DS_Store

# Generated config (from template)
config/odoo/odoo.conf

# Docker override
docker-compose.override.yml

# Third-party addons (mount from paas-odoo-ci repo via PAAS_CI_ADDONS_PATH)
extra/extra-addons/

# Python virtual environment
.venv/
venv/

# IDE
.vscode/*.log
.idea/

# SuperClaude_Framework auto-generated namespace (/sc:workflow, /sc:research)
claudedocs/

# helm values (exclude real, keep examples)
*values.yaml
*values.yml
!*values.example.yml
!*values.example.yaml
# Allow chart default values (no secrets, only defaults)
!charts/*/values.yaml
!charts/*/values-*.yaml
.maestri

# Local symlink to meeting notes (absolute path, machine-specific — never commit)
docs/meeting

# docs 內 explain-by-html 衍生產物不入版控（.md 源檔才是文件本體）
docs/**/*.html

# #411 盤點 raw values dump（含明文 secret）—— 防呆：預設落點在 repo 外 tmp，
# 此條攔截誤把 --raw-dir 指到 repo 內的情況（audit_411_reset_values.py）
audit-411-raw*/

