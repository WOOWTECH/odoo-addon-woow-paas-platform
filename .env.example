# Worktree 配置（自動生成，請勿手動修改）
# 這些值會由 scripts/setup-worktree-env.sh 自動設定

# Docker Compose 專案名稱（基於目錄名稱）
COMPOSE_PROJECT_NAME=woow_paas_platform

# Git 分支名稱
BRANCH_NAME=main

# Odoo Web 服務 Port（自動計算以避免衝突）
ODOO_PORT=8069

# Odoo 資料庫名稱（基於分支名稱）
ODOO_DB_NAME=woow_main

# PostgreSQL 配置
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo

# 共享資料庫模式（可選）
# 設為 true 時，所有 worktree 使用同一個 PostgreSQL 容器
# 設為 false 時，每個 worktree 有獨立的 PostgreSQL 容器
USE_SHARED_DB=false

# 共享資料庫網路名稱（僅在 USE_SHARED_DB=true 時使用）
SHARED_DB_NETWORK=odoo_network

# PgAdmin 配置（可選）
PGADMIN_DEFAULT_EMAIL=admin@woow.com
PGADMIN_DEFAULT_PASSWORD=admin

# Debug Port（用於 VS Code 遠端調試，可選）
DEBUG_PORT=5678

# 第三方 addon 路徑（mount 進 /mnt/extra-addons-ext）
# 預設指向 paas-odoo-ci repo 的 addons/，與 stg/prod image 共用同一份 source of truth
# 路徑相對於本 repo 根目錄；若你的 checkout 不同，覆蓋為絕對路徑
# 例: PAAS_CI_ADDONS_PATH=/Users/me/repos/paas-odoo-ci/addons
PAAS_CI_ADDONS_PATH=../../../woow-paas-repo/paas-odoo-ci/addons
