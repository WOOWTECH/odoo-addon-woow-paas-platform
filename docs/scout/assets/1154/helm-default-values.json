{
 "global": {
  "security": {
   "allowInsecureImages": true
  }
 },
 "image": {
  "registry": "jcr-prod.woowtech.io",
  "repository": "woow-paas-docker-local/cloud-odoo-proto",
  "tag": "1154",
  "pullPolicy": "Always"
 },
 "args": [
  "odoo",
  "-d",
  "bitnami_odoo",
  "--proxy-mode",
  "--no-database-list",
  "--db-filter=^bitnami_odoo$",
  "--workers=2",
  "--max-cron-threads=1",
  "--limit-time-real=120"
 ],
 "service": {
  "type": "ClusterIP",
  "ports": {
   "http": 80
  },
  "extraPorts": [
   {
    "name": "websocket",
    "port": 8072,
    "targetPort": "websocket",
    "protocol": "TCP"
   }
  ]
 },
 "volumePermissions": {
  "enabled": false
 },
 "podSecurityContext": {
  "enabled": true,
  "fsGroup": 101,
  "fsGroupChangePolicy": "OnRootMismatch"
 },
 "containerSecurityContext": {
  "enabled": true,
  "runAsUser": 101,
  "runAsGroup": 101,
  "runAsNonRoot": true,
  "privileged": false,
  "readOnlyRootFilesystem": false,
  "allowPrivilegeEscalation": false,
  "capabilities": {
   "drop": [
    "ALL"
   ]
  },
  "seccompProfile": {
   "type": "RuntimeDefault"
  }
 },
 "livenessProbe": {
  "enabled": true,
  "path": "/web/health",
  "initialDelaySeconds": 120,
  "periodSeconds": 30,
  "timeoutSeconds": 5,
  "failureThreshold": 6
 },
 "readinessProbe": {
  "enabled": true,
  "path": "/web/health",
  "initialDelaySeconds": 20,
  "periodSeconds": 10,
  "timeoutSeconds": 5,
  "failureThreshold": 12
 },
 "resources": {
  "requests": {
   "cpu": "200m",
   "memory": "512Mi"
  },
  "limits": {
   "cpu": "2",
   "memory": "2Gi"
  }
 },
 "persistence": {
  "enabled": true,
  "storageClass": "longhorn-delete",
  "size": "5Gi"
 },
 "updateStrategy": {
  "type": "Recreate"
 },
 "extraEnvVars": [
  {
   "name": "HOST",
   "value": "{{ .Release.Name }}-postgresql"
  },
  {
   "name": "PORT",
   "value": "5432"
  },
  {
   "name": "USER",
   "value": "bn_odoo"
  },
  {
   "name": "PASSWORD",
   "valueFrom": {
    "secretKeyRef": {
     "name": "{{ .Release.Name }}-postgresql",
     "key": "password"
    }
   }
  },
  {
   "name": "ODOO_DB",
   "value": "bitnami_odoo"
  }
 ],
 "extraVolumeMounts": [
  {
   "name": "odoo-data",
   "mountPath": "/var/lib/odoo"
  }
 ],
 "initContainers": [
  {
   "name": "bootstrap",
   "image": "docker.io/odoo:18.0",
   "imagePullPolicy": "IfNotPresent",
   "securityContext": {
    "runAsUser": 101,
    "runAsGroup": 101,
    "runAsNonRoot": true,
    "allowPrivilegeEscalation": false,
    "capabilities": {
     "drop": [
      "ALL"
     ]
    }
   },
   "command": [
    "/bin/bash",
    "-c",
    "set -euo pipefail\nexport PGPASSWORD=\"$PASSWORD\"\necho \"[bootstrap] 等待 DB 可連線\"\nfor i in $(seq 1 60); do\n  pg_isready -h \"$HOST\" -p \"$PORT\" -U \"$USER\" -d \"$ODOO_DB\" && break\n  sleep 2\ndone\nINITED=$(psql -h \"$HOST\" -p \"$PORT\" -U \"$USER\" -d \"$ODOO_DB\" -tAc \"SELECT to_regclass('public.ir_module_module')\" || echo \"\")\nDB_ARGS=\"--db_host=$HOST --db_port=$PORT --db_user=$USER --db_password=$PASSWORD --data-dir=/var/lib/odoo\"\nif [ -n \"$INITED\" ]; then\n  echo \"[bootstrap] DB 已 init（ir_module_module 存在），略過 -i base\"\nelse\n  echo \"[bootstrap] 首次 init：odoo -d $ODOO_DB -i base\"\n  odoo -d \"$ODOO_DB\" -i base --stop-after-init --no-http $DB_ARGS --without-demo=all\n  echo \"[bootstrap] init 完成，用 ORM 設定 admin 密碼\"\n  printf '%s\\n' \"env['res.users'].browse(2).write({'login': env['ir.config_parameter'].sudo().get_param('x') or 'admin', 'password': '$ADMIN_PASSWORD'})\" \"env.cr.commit()\" \\\n    | odoo shell -d \"$ODOO_DB\" --no-http $DB_ARGS\n  echo \"[bootstrap] admin 密碼已設定\"\nfi\n"
   ],
   "env": [
    {
     "name": "HOST",
     "value": "{{ .Release.Name }}-postgresql"
    },
    {
     "name": "PORT",
     "value": "5432"
    },
    {
     "name": "USER",
     "value": "bn_odoo"
    },
    {
     "name": "ODOO_DB",
     "value": "bitnami_odoo"
    },
    {
     "name": "ADMIN_PASSWORD",
     "value": "Prototype1136!"
    },
    {
     "name": "PASSWORD",
     "valueFrom": {
      "secretKeyRef": {
       "name": "{{ .Release.Name }}-postgresql",
       "key": "password"
      }
     }
    }
   ],
   "volumeMounts": [
    {
     "name": "odoo-data",
     "mountPath": "/var/lib/odoo"
    }
   ]
  }
 ],
 "postgresql": {
  "enabled": true,
  "architecture": "standalone",
  "auth": {
   "username": "bn_odoo",
   "password": "odoo1136pass",
   "database": "bitnami_odoo",
   "postgresPassword": "postgres1136pass",
   "usePasswordFiles": false
  },
  "image": {
   "registry": "docker.io",
   "repository": "pgvector/pgvector",
   "tag": "pg17"
  },
  "primary": {
   "persistence": {
    "storageClass": "longhorn-delete",
    "size": "8Gi"
   },
   "podSecurityContext": {
    "enabled": true,
    "fsGroup": 999
   },
   "containerSecurityContext": {
    "enabled": true,
    "runAsUser": 999,
    "runAsGroup": 999,
    "runAsNonRoot": true,
    "readOnlyRootFilesystem": false,
    "allowPrivilegeEscalation": false,
    "capabilities": {
     "drop": [
      "ALL"
     ]
    },
    "seccompProfile": {
     "type": "RuntimeDefault"
    }
   },
   "command": [
    "docker-entrypoint.sh"
   ],
   "args": [
    "postgres"
   ],
   "extraEnvVars": [
    {
     "name": "POSTGRES_DB",
     "value": "bitnami_odoo"
    }
   ]
  }
 },
 "extraContainerPorts": [
  {
   "name": "websocket",
   "containerPort": 8072,
   "protocol": "TCP"
  }
 ]
}