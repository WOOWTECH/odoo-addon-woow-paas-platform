# PaaS Operator Service Configuration

# API Security - CHANGE THIS!
API_KEY=your-secret-api-key-here

# Service Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Kubernetes
NAMESPACE_PREFIX=paas-ws-

# Helm
HELM_BINARY=/usr/local/bin/helm
HELM_TIMEOUT=300

# CORS - comma-separated list of allowed origins
# Empty = block all external origins (recommended for internal services)
# Example: https://odoo.example.com,https://admin.example.com
CORS_ORIGINS=

# Cloudflare for SaaS custom hostnames. Secure default: disabled. When enabled,
# CUSTOM_DOMAINS_API_TOKEN needs SSL and Certificates Write on the provider zone.
# Leave it empty only when CLOUDFLARE_API_TOKEN already has that permission.
# The existing Tunnel/DNS token stays separate; zone/domain identify the origin.
CUSTOM_DOMAINS_ENABLED=false
CUSTOM_DOMAINS_API_TOKEN=
CUSTOM_DOMAINS_TARGET_HOSTNAME=
CUSTOM_DOMAINS_GATEWAY_URL=
CUSTOM_DOMAINS_GATEWAY_TOKEN=
CUSTOM_DOMAINS_GATEWAY_TUNNEL_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_DOMAIN=
