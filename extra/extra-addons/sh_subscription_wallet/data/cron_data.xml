<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 訂閱錢包扣款排程 -->
        <record id="ir_cron_subscription_wallet_charge" model="ir.cron">
            <field name="name">訂閱錢包扣款</field>
            <field name="model_id" ref="sh_subscription.model_sh_subscription_subscription"/>
            <field name="state">code</field>
            <field name="code">model._cron_wallet_charge()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- 扣款失敗重試排程 -->
        <record id="ir_cron_subscription_wallet_retry" model="ir.cron">
            <field name="name">訂閱錢包扣款重試</field>
            <field name="model_id" ref="sh_subscription.model_sh_subscription_subscription"/>
            <field name="state">code</field>
            <field name="code">model._cron_wallet_charge_retry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
