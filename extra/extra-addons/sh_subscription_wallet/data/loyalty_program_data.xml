<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ========================================
             eWallet Trigger Product (用於報價單儲值)
             Odoo 18 sale_loyalty: SO 確認時自動加點
             ======================================== -->
        <record id="product_ewallet_topup" model="product.product">
            <field name="name">電子錢包儲值</field>
            <field name="type">service</field>
            <field name="list_price">0</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="categ_id" ref="product.product_category_all"/>
            <field name="description_sale">此為錢包儲值專用商品，請在報價單中輸入儲值金額作為單價。</field>
        </record>

        <!-- 錢包點數計畫 (eWallet program) -->
        <record id="loyalty_program_wallet" model="loyalty.program">
            <field name="name">錢包點數</field>
            <field name="program_type">ewallet</field>
            <field name="applies_on">future</field>
            <field name="trigger">auto</field>
            <field name="portal_visible">True</field>
        </record>

        <!-- eWallet Rule: 1 NT$ spent on trigger product = 1 point -->
        <record id="loyalty_rule_wallet_topup" model="loyalty.rule">
            <field name="program_id" ref="loyalty_program_wallet"/>
            <field name="reward_point_amount">1</field>
            <field name="reward_point_mode">money</field>
            <field name="product_ids" eval="[(4, ref('product_ewallet_topup'))]"/>
            <field name="minimum_qty">1</field>
            <field name="minimum_amount">0</field>
        </record>

        <!-- eWallet Reward: 1 point = NT$ 1 discount -->
        <record id="loyalty_reward_wallet" model="loyalty.reward">
            <field name="program_id" ref="loyalty_program_wallet"/>
            <field name="reward_type">discount</field>
            <field name="discount">1</field>
            <field name="discount_mode">per_point</field>
            <field name="discount_applicability">order</field>
            <field name="required_points">1</field>
        </record>

        <!-- 交易編號序列 -->
        <record id="seq_wallet_transaction" model="ir.sequence">
            <field name="name">錢包交易編號</field>
            <field name="code">wallet.transaction</field>
            <field name="prefix">WT</field>
            <field name="padding">8</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- 儲值編號序列 -->
        <record id="seq_wallet_topup" model="ir.sequence">
            <field name="name">錢包儲值編號</field>
            <field name="code">wallet.topup</field>
            <field name="prefix">WTP</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
