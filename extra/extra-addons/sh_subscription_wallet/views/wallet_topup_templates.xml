<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Topup Page -->
    <template id="portal_wallet_topup" name="Wallet Topup">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">點數儲值</t>
            </t>

            <div class="wo-page wo-container">
                <div class="wo-alert wo-alert-info">
                    <i class="fa fa-wallet"></i>
                    目前點數餘額: <strong t-esc="int(wallet_balance)"/> 點
                </div>

                <t t-if="not ecpay_available">
                    <div class="wo-alert wo-alert-warning">
                        <i class="fa fa-exclamation-triangle"></i>
                        付款服務暫時無法使用，請稍後再試。
                    </div>
                </t>
                <t t-else="">
                    <div class="wo-card">
                        <div class="wo-card-header">
                            <i class="fa fa-plus-circle"></i>
                            <h3>選擇儲值金額</h3>
                        </div>
                        <div class="wo-card-body">
                            <form action="/my/wallet/topup/submit" method="post" id="topup_form">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                <div class="row g-3 mb-4">
                                    <t t-foreach="topup_options" t-as="option">
                                        <div class="col-md-4 col-6">
                                            <div class="card h-100 wo-topup-option" t-att-data-amount="option['amount']">
                                                <div class="card-body text-center">
                                                    <h4 style="color: var(--wo-primary); font-weight: 700; margin-bottom: 0.5rem;" t-esc="option['label']"/>
                                                    <t t-if="option['bonus'] > 0">
                                                        <p style="color: var(--wo-green); margin: 0; font-size: 0.85rem;">
                                                            <i class="fa fa-gift me-1"></i>
                                                            贈送 <span t-esc="option['bonus']"/> 點
                                                        </p>
                                                    </t>
                                                    <input type="radio" name="amount" t-att-value="option['amount']"
                                                           class="d-none topup-radio"/>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </div>

                                <div class="mb-4">
                                    <label for="custom_amount" class="form-label" style="font-weight: 600;">或輸入自訂金額</label>
                                    <div class="input-group">
                                        <span class="input-group-text" style="border-radius: var(--wo-radius) 0 0 var(--wo-radius);">NT$</span>
                                        <input type="number" class="form-control" id="custom_amount"
                                               name="custom_amount" min="100" step="100" placeholder="最低 100 元"
                                               style="border-radius: 0 var(--wo-radius) var(--wo-radius) 0;"/>
                                    </div>
                                    <small style="color: var(--wo-gray);">自訂金額不適用贈點優惠</small>
                                </div>

                                <div class="d-grid">
                                    <button type="submit" class="wo-btn wo-btn-primary wo-btn-block" id="topup_submit" style="padding: 0.75rem;">
                                        <i class="fa fa-credit-card"></i>前往付款
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="wo-card" style="margin-top: 1rem;">
                        <div class="wo-card-header">
                            <i class="fa fa-info-circle"></i>
                            <h3>儲值說明</h3>
                        </div>
                        <div class="wo-card-body">
                            <ul style="margin: 0; padding-left: 1.25rem; color: var(--wo-gray); line-height: 1.8;">
                                <li>1 點 = NT$ 1，點數可用於支付訂閱費用</li>
                                <li>儲值金額達一定門檻可獲得贈點優惠</li>
                                <li>支援信用卡、ATM 轉帳、超商付款</li>
                                <li>付款完成後，點數將即時入帳</li>
                            </ul>
                        </div>
                    </div>
                </t>

                <div class="mt-3">
                    <a href="/my/sh_subscription" class="wo-btn wo-btn-ghost">
                        <i class="fa fa-arrow-left"></i>返回訂閱
                    </a>
                </div>
            </div>
        </t>
    </template>
</odoo>
