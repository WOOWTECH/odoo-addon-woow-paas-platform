<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- 擴展訂閱方案表單視圖，新增強制綁定信用卡選項 -->
        <record id="sh_subscription_plan_form_view_wallet" model="ir.ui.view">
            <field name="name">sh.subscription.plan.form.wallet</field>
            <field name="model">sh.subscription.plan</field>
            <field name="inherit_id" ref="sh_subscription.sh_subscription_plan_form_view"/>
            <field name="arch" type="xml">
                <!-- 在 "允許客戶關閉" 欄位後新增 "強制綁定信用卡" -->
                <xpath expr="//field[@name='sh_is_close_by_customer']" position="after">
                    <field name="require_credit_card"/>
                </xpath>
            </field>
        </record>

        <!-- 擴展列表視圖 -->
        <record id="sh_subscription_plan_tree_view_wallet" model="ir.ui.view">
            <field name="name">sh.subscription.plan.tree.wallet</field>
            <field name="model">sh.subscription.plan</field>
            <field name="inherit_id" ref="sh_subscription.sh_subscription_plan_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='sh_override_product']" position="after">
                    <field name="require_credit_card" optional="show"/>
                </xpath>
            </field>
        </record>

        <!-- 擴展搜尋視圖 -->
        <record id="sh_subscription_plan_search_view_wallet" model="ir.ui.view">
            <field name="name">sh.subscription.plan.search.wallet</field>
            <field name="model">sh.subscription.plan</field>
            <field name="inherit_id" ref="sh_subscription.sh_subscription_plan_search_view"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='sh_never_expire']" position="after">
                    <filter string="強制綁定信用卡"
                            domain="[('require_credit_card', '=', True)]"
                            name="require_credit_card"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
