<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 錢包交易記錄 Tree View -->
    <record id="wallet_transaction_tree_view" model="ir.ui.view">
        <field name="name">wallet.transaction.tree</field>
        <field name="model">wallet.transaction</field>
        <field name="arch" type="xml">
            <list string="錢包交易記錄">
                <field name="create_date" string="日期"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="transaction_type"/>
                <field name="amount" sum="總計"/>
                <field name="balance_after"/>
                <field name="subscription_id" optional="show"/>
                <field name="card_charge_amount" optional="hide"/>
                <field name="card_charge_status" optional="hide"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- 錢包交易記錄 Form View -->
    <record id="wallet_transaction_form_view" model="ir.ui.view">
        <field name="name">wallet.transaction.form</field>
        <field name="model">wallet.transaction</field>
        <field name="arch" type="xml">
            <form string="錢包交易記錄">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="基本資訊">
                            <field name="partner_id"/>
                            <field name="transaction_type"/>
                            <field name="amount"/>
                            <field name="balance_after"/>
                            <field name="description"/>
                        </group>
                        <group string="關聯">
                            <field name="subscription_id"/>
                            <field name="payment_transaction_id"/>
                        </group>
                    </group>
                    <group string="信用卡扣款" invisible="not card_charge_amount">
                        <group>
                            <field name="card_charge_amount"/>
                            <field name="card_charge_status"/>
                            <field name="card_charge_error" invisible="card_charge_status != 'failed'"/>
                        </group>
                        <group>
                            <field name="ecpay_merchant_trade_no"/>
                            <field name="ecpay_trade_no"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 錢包交易記錄 Search View -->
    <record id="wallet_transaction_search_view" model="ir.ui.view">
        <field name="name">wallet.transaction.search</field>
        <field name="model">wallet.transaction</field>
        <field name="arch" type="xml">
            <search string="搜尋交易記錄">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="subscription_id"/>
                <filter string="儲值" name="topup" domain="[('transaction_type', '=', 'topup')]"/>
                <filter string="訂閱扣款" name="deduct" domain="[('transaction_type', '=', 'deduct')]"/>
                <filter string="信用卡扣款" name="card_charge" domain="[('transaction_type', '=', 'card_charge')]"/>
                <separator/>
                <filter string="成功" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="失敗" name="failed" domain="[('state', '=', 'failed')]"/>
                <group expand="0" string="分組">
                    <filter string="客戶" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="類型" name="group_type" context="{'group_by': 'transaction_type'}"/>
                    <filter string="日期" name="group_date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- 錢包交易記錄 Action -->
    <record id="wallet_transaction_action" model="ir.actions.act_window">
        <field name="name">錢包交易記錄</field>
        <field name="res_model">wallet.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="wallet_transaction_search_view"/>
        <field name="context">{'search_default_done': 1}</field>
    </record>

    <!-- 選單項目 -->
    <menuitem id="menu_wallet_transaction"
              name="錢包交易記錄"
              parent="sh_subscription.sh_subscription_main_menu"
              action="wallet_transaction_action"
              sequence="50"/>
</odoo>
