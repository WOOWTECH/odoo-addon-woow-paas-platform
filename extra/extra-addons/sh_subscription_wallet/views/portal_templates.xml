<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================
         Wallet info is merged into subscription pages.
         No standalone /my/wallet portal home entry.
         ================================================ -->

    <!-- Override subscription DETAIL page: inject wallet/card/payment stats -->
    <template id="sh_subscription_portal_content_wallet" name="Subscription Detail + Wallet Info"
              inherit_id="sh_subscription.sh_subscription_portal_content" priority="99">
        <!-- Inject stats grid BEFORE the info-grid -->
        <xpath expr="//div[hasclass('wo-info-grid')]" position="before">
            <!-- Quick Stats: Wallet / Credit Card / Next Payment -->
            <div class="wo-stats-grid">
                <!-- Wallet Balance -->
                <div class="wo-stat wo-stat-wallet">
                    <div class="wo-stat-title">
                        <i class="fa fa-wallet me-1"></i> 錢包餘額
                    </div>
                    <div class="wo-stat-value">
                        <t t-esc="int(sh_subscription.sh_partner_id.wallet_balance)"/> 點
                    </div>
                    <div class="wo-stat-note">
                        <a href="/my/wallet/topup">儲值 →</a>
                    </div>
                </div>

                <!-- Credit Card -->
                <div class="wo-stat wo-stat-card">
                    <div class="wo-stat-title">
                        <i class="fa fa-credit-card me-1"></i> 綁定信用卡
                    </div>
                    <t t-if="sh_subscription.sh_partner_id.ecpay_card_token">
                        <div class="wo-stat-value" style="font-size: 1.25rem;">
                            **** <t t-esc="sh_subscription.sh_partner_id.ecpay_card_last4 or '****'"/>
                        </div>
                        <div class="wo-stat-note" t-if="sh_subscription.sh_partner_id.ecpay_card_expiry">
                            有效期: <t t-esc="sh_subscription.sh_partner_id.ecpay_card_expiry"/>
                        </div>
                        <div class="wo-stat-note">
                            <a t-attf-href="/my/wallet/bind_card?subscription_id=#{sh_subscription.id}">更換信用卡 →</a>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="wo-no-card">
                            <i class="fa fa-credit-card-alt"></i>
                            <span style="font-size: 0.85rem;">尚未綁定</span>
                            <a t-attf-href="/my/wallet/bind_card?subscription_id=#{sh_subscription.id}" class="wo-bind-link">
                                <i class="fa fa-plus"></i>立即綁定
                            </a>
                        </div>
                    </t>
                </div>

                <!-- Next Payment -->
                <div class="wo-stat wo-stat-payment">
                    <div class="wo-stat-title">
                        <i class="fa fa-calendar me-1"></i> 下次扣款
                    </div>
                    <t t-if="sh_subscription.sh_date_of_next_payment">
                        <div class="wo-stat-value" style="font-size: 1.1rem;">
                            <t t-esc="sh_subscription.sh_date_of_next_payment"/>
                        </div>
                        <div class="wo-stat-note">
                            扣款金額: <t t-esc="int(sh_subscription.sh_plan_price)"/> 元
                        </div>
                    </t>
                    <t t-else="">
                        <div class="wo-stat-value" style="font-size: 1rem;">--</div>
                        <div class="wo-stat-note">尚無排程</div>
                    </t>
                </div>
            </div>
        </xpath>

        <!-- Inject wallet balance + card info into payment card -->
        <xpath expr="//div[hasclass('wo-info-grid')]/div[2]//div[hasclass('wo-card-body')]" position="inside">
            <div class="wo-info-row">
                <span class="wo-info-label">錢包餘額</span>
                <span class="wo-info-value wo-info-value--success">
                    <t t-esc="int(sh_subscription.sh_partner_id.wallet_balance)"/> 點
                </span>
            </div>
            <div class="wo-info-row">
                <span class="wo-info-label">綁定信用卡</span>
                <span class="wo-info-value">
                    <t t-if="sh_subscription.sh_partner_id.ecpay_card_token">
                        **** <t t-esc="sh_subscription.sh_partner_id.ecpay_card_last4 or '****'"/>
                        <a t-attf-href="/my/wallet/bind_card?subscription_id=#{sh_subscription.id}" class="ms-2" style="font-size: 0.85rem;">更換</a>
                    </t>
                    <t t-else="">
                        <span class="wo-info-value--warning">未綁定</span>
                        <a t-attf-href="/my/wallet/bind_card?subscription_id=#{sh_subscription.id}" class="ms-2" style="font-size: 0.85rem;">綁定</a>
                    </t>
                </span>
            </div>
        </xpath>

        <!-- Inject product info + transaction history before message thread -->
        <xpath expr="//div[hasclass('wo-message-section')]" position="before">
            <!-- Product Info -->
            <t t-if="sh_subscription.product_id">
                <div class="wo-card" style="margin-bottom: 1rem;">
                    <div class="wo-card-header">
                        <i class="fa fa-shopping-bag"></i>
                        <h3>訂閱商品</h3>
                    </div>
                    <div class="wo-card-body">
                        <div style="display: flex; gap: 1rem; align-items: flex-start;">
                            <div style="flex-shrink: 0;">
                                <t t-if="sh_subscription.product_id.image_128">
                                    <img t-att-src="'/web/image/product.product/%s/image_128' % sh_subscription.product_id.id"
                                         alt="Product" style="width: 72px; height: 72px; object-fit: cover; border-radius: var(--wo-radius); border: 1px solid var(--wo-bg);"/>
                                </t>
                                <t t-else="">
                                    <div style="width: 72px; height: 72px; background: var(--wo-bg); border-radius: var(--wo-radius); display: flex; align-items: center; justify-content: center;">
                                        <i class="fa fa-cube" style="font-size: 1.8rem; color: var(--wo-gray);"></i>
                                    </div>
                                </t>
                            </div>
                            <div style="flex: 1; min-width: 0;">
                                <h4 style="font-size: 1rem; font-weight: 700; color: var(--wo-deep); margin: 0 0 0.4rem;">
                                    <t t-esc="sh_subscription.product_id.name"/>
                                </h4>
                                <t t-if="sh_subscription.product_id.default_code">
                                    <div style="font-size: 0.8rem; color: var(--wo-gray);">
                                        <i class="fa fa-barcode me-1"></i><t t-esc="sh_subscription.product_id.default_code"/>
                                    </div>
                                </t>
                            </div>
                        </div>
                        <div style="margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--wo-bg);">
                            <div class="wo-info-row">
                                <span class="wo-info-label">訂閱數量</span>
                                <span class="wo-info-value">
                                    <t t-esc="int(sh_subscription.sh_qty)"/>
                                    <t t-if="sh_subscription.product_id.uom_id">
                                        <t t-esc="sh_subscription.product_id.uom_id.name"/>
                                    </t>
                                </span>
                            </div>
                            <div class="wo-info-row">
                                <span class="wo-info-label">單價</span>
                                <span class="wo-info-value wo-info-value--primary">
                                    NT$ <t t-esc="int(sh_subscription.product_id.list_price)"/>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </t>

            <!-- Transaction History -->
            <div class="wo-card" style="margin-bottom: 1rem;">
                <div class="wo-card-header">
                    <i class="fa fa-history"></i>
                    <h3>扣款記錄</h3>
                </div>
                <div class="wo-card-body" style="padding: 0;">
                    <t t-set="subscription_transactions" t-value="request.env['wallet.transaction'].sudo().search([('partner_id', '=', sh_subscription.sh_partner_id.id), ('subscription_id', '=', sh_subscription.id)], limit=10, order='create_date desc')"/>
                    <t t-if="subscription_transactions">
                        <table class="wo-table">
                            <thead>
                                <tr>
                                    <th>日期</th>
                                    <th>類型</th>
                                    <th>描述</th>
                                    <th class="wo-text-end">金額</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="subscription_transactions" t-as="tx">
                                    <tr>
                                        <td style="color: var(--wo-gray);">
                                            <span t-field="tx.create_date" t-options='{"format": "MM/dd HH:mm"}'/>
                                        </td>
                                        <td>
                                            <span t-if="tx.transaction_type == 'topup'" class="wo-badge wo-badge-topup">儲值</span>
                                            <span t-if="tx.transaction_type == 'deduct'" class="wo-badge wo-badge-deduct">扣款</span>
                                            <span t-if="tx.transaction_type == 'card_charge'" class="wo-badge wo-badge-card">信用卡</span>
                                            <span t-if="tx.transaction_type == 'refund'" class="wo-badge wo-badge-refund">退款</span>
                                        </td>
                                        <td t-esc="tx.description or '-'"/>
                                        <td class="wo-text-end">
                                            <span t-attf-class="#{tx.amount >= 0 and 'wo-amount-plus' or 'wo-amount-minus'}">
                                                <t t-if="tx.amount >= 0">+</t>
                                                <span t-field="tx.amount" t-options='{"widget": "float", "precision": 0}'/>
                                            </span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                    <t t-else="">
                        <div class="wo-empty" style="border: none; border-radius: 0;">
                            <i class="fa fa-inbox" style="font-size: 2rem;"></i>
                            <p>尚無扣款記錄</p>
                        </div>
                    </t>
                </div>
            </div>
        </xpath>
    </template>

    <!-- Wallet Transactions Page (standalone, accessed from detail page link) -->
    <template id="portal_wallet_transactions" name="Wallet Transactions">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">交易記錄</t>
            </t>

            <div class="wo-page wo-container">
                <div class="wo-alert wo-alert-info">
                    <i class="fa fa-wallet"></i>
                    目前點數餘額: <strong t-esc="int(wallet_balance)"/> 點
                </div>

                <t t-if="transactions">
                    <div class="wo-card">
                        <div class="wo-card-body" style="padding: 0;">
                            <table class="wo-table">
                                <thead>
                                    <tr>
                                        <th>日期</th>
                                        <th>編號</th>
                                        <th>類型</th>
                                        <th>描述</th>
                                        <th class="wo-text-end">金額</th>
                                        <th class="wo-text-end">餘額</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="transactions" t-as="tx">
                                        <tr>
                                            <td><span t-field="tx.create_date" t-options='{"format": "yyyy/MM/dd HH:mm"}'/></td>
                                            <td t-esc="tx.name"/>
                                            <td>
                                                <span t-if="tx.transaction_type == 'topup'" class="wo-badge wo-badge-topup">儲值</span>
                                                <span t-if="tx.transaction_type == 'deduct'" class="wo-badge wo-badge-deduct">扣款</span>
                                                <span t-if="tx.transaction_type == 'card_charge'" class="wo-badge wo-badge-card">信用卡</span>
                                                <span t-if="tx.transaction_type == 'refund'" class="wo-badge wo-badge-refund">退款</span>
                                                <span t-if="tx.transaction_type == 'card_bind'" class="wo-badge wo-badge-bind">綁卡</span>
                                                <span t-if="tx.transaction_type == 'card_unbind'" class="wo-badge wo-badge-unbind">解綁</span>
                                            </td>
                                            <td t-esc="tx.description or '-'"/>
                                            <td class="wo-text-end">
                                                <span t-attf-class="#{tx.amount >= 0 and 'wo-amount-plus' or 'wo-amount-minus'}">
                                                    <t t-if="tx.amount >= 0">+</t>
                                                    <span t-field="tx.amount" t-options='{"widget": "float", "precision": 0}'/>
                                                </span>
                                            </td>
                                            <td class="wo-text-end" t-esc="int(tx.balance_after)"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="d-flex justify-content-center mt-3">
                        <t t-call="portal.pager"/>
                    </div>
                </t>
                <t t-else="">
                    <div class="wo-empty">
                        <i class="fa fa-info-circle"></i>
                        <h4>尚無交易記錄</h4>
                    </div>
                </t>

                <div class="mt-3">
                    <a href="/my/sh_subscription" class="wo-btn wo-btn-ghost">
                        <i class="fa fa-arrow-left"></i>返回訂閱
                    </a>
                </div>
            </div>
        </t>
    </template>

    <!-- Credit Card Binding Page -->
    <template id="portal_bind_card" name="Bind Credit Card">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">信用卡綁定</t>
            </t>

            <div class="wo-page wo-container">
                <t t-if="success">
                    <div class="wo-alert wo-alert-success">
                        <i class="fa fa-check-circle"></i>
                        <t t-if="success == 'unbind'">信用卡已解除綁定</t>
                        <t t-else="">信用卡綁定成功！</t>
                    </div>
                </t>
                <t t-if="error">
                    <div class="wo-alert wo-alert-danger">
                        <i class="fa fa-exclamation-circle"></i>
                        <span t-esc="error"/>
                    </div>
                </t>

                <div class="wo-card">
                    <div class="wo-card-header">
                        <i class="fa fa-credit-card"></i>
                        <h3>信用卡綁定</h3>
                    </div>
                    <div class="wo-card-body">
                        <t t-if="has_bound_card">
                            <div class="row align-items-center mb-4">
                                <div class="col-md-6">
                                    <h5 style="font-weight: 700; color: var(--wo-deep);">目前綁定的信用卡</h5>
                                    <p class="mb-1">
                                        <i class="fa fa-credit-card me-2"></i>
                                        **** **** **** <span t-esc="card_last4"/>
                                    </p>
                                    <p style="color: var(--wo-gray); margin: 0;" t-if="card_expiry">
                                        有效期限: <span t-esc="card_expiry"/>
                                    </p>
                                    <p style="color: var(--wo-gray); margin: 0;" t-if="card_bound_date">
                                        綁定日期: <span t-esc="str(card_bound_date)[:10] if card_bound_date else ''"/>
                                    </p>
                                </div>
                                <div class="col-md-6 text-md-end">
                                    <form action="/my/wallet/unbind_card" method="post" class="d-inline">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button type="submit" class="wo-btn wo-btn-danger" onclick="return confirm('確定要解除信用卡綁定嗎？')">
                                            <i class="fa fa-times"></i>解除綁定
                                        </button>
                                    </form>
                                </div>
                            </div>
                            <hr style="border-color: var(--wo-bg);"/>
                            <h5 style="font-weight: 700; color: var(--wo-deep);">更換信用卡</h5>
                            <p style="color: var(--wo-gray);">綁定新的信用卡將自動取代目前的信用卡。</p>
                        </t>
                        <t t-else="">
                            <p style="color: var(--wo-gray); margin-bottom: 1rem;">
                                綁定信用卡後，當您的點數餘額不足支付訂閱費用時，系統將自動從綁定的信用卡扣款。
                            </p>
                        </t>

                        <form action="/my/wallet/bind_card/submit" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <button type="submit" class="wo-btn wo-btn-primary" style="padding: 0.75rem 2rem;">
                                <i class="fa fa-credit-card"></i>
                                <t t-if="has_bound_card">更換信用卡</t>
                                <t t-else="">綁定信用卡</t>
                            </button>
                        </form>

                        <div class="mt-3">
                            <small style="color: var(--wo-gray);">
                                <i class="fa fa-shield me-1"></i>
                                您的信用卡資料由綠界科技（ECPay）安全處理，我們不會儲存您的完整卡號。
                            </small>
                        </div>
                    </div>
                </div>

                <div class="mt-3">
                    <t t-if="back_subscription_id">
                        <a t-attf-href="/my/sh_subscription/#{back_subscription_id}" class="wo-btn wo-btn-ghost">
                            <i class="fa fa-arrow-left"></i>返回訂閱
                        </a>
                    </t>
                    <t t-else="">
                        <a href="/my/sh_subscription" class="wo-btn wo-btn-ghost">
                            <i class="fa fa-arrow-left"></i>返回訂閱
                        </a>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <!-- ECPay Redirect Page -->
    <template id="redirect_to_ecpay" name="Redirect to ECPay">
        <t t-call="web.frontend_layout">
            <div class="container py-5 text-center">
                <h2 class="mb-4" style="font-weight: 700; color: var(--wo-deep, #212121);">正在導向 ECPay...</h2>
                <p style="color: var(--wo-gray, #646262);">請稍候，系統正在將您導向綠界科技進行信用卡授權。</p>
                <div class="spinner-border" style="color: var(--wo-primary, #714B67);" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <form id="ecpay_form" t-att-action="ecpay_url" method="post">
                    <t t-foreach="params.items()" t-as="param">
                        <input type="hidden" t-att-name="param[0]" t-att-value="param[1]"/>
                    </t>
                </form>
                <script>
                    document.getElementById('ecpay_form').submit();
                </script>
            </div>
        </t>
    </template>
</odoo>
