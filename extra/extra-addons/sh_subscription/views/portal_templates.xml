<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Breadcrumbs -->
    <template id="sh_subsciption_portal_my_home_menu" name="Portal layout : Subscription menu entries" inherit_id="portal.portal_breadcrumbs" priority="20">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'sh_subscription' or sh_subscription" t-attf-class="breadcrumb-item #{'active ' if not tender else ''}">
                <a t-if="sh_subscription" t-attf-href="/my/sh_subscription?{{ keep_query() }}">Subscriptions</a>
                <t t-else="">Subscriptions</t>
            </li>
            <li t-if="sh_subscription" class="breadcrumb-item active">
                <span t-out="sh_subscription.name" />
            </li>
        </xpath>
    </template>

    <!-- Portal Home Entry -->
    <template id="sh_subscription_my_home" name="Portal My Home : Subscription entries" customize_show="True" inherit_id="portal.portal_my_home" priority="20">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/sh_subscription/static/src/img/subscription.svg'"/>
                <t t-set="title">Subscriptions</t>
                <t t-set="url" t-value="'/my/sh_subscription'" />
                <t t-set="text">View your subscription</t>
                <t t-set="placeholder_count" t-value="'subscription_count'" />
            </t>
        </div>
    </template>

    <!-- Subscription List Page -->
    <template id="sh_portal_my_subscriptions" name="My Subscriptions">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Subscriptions</t>
            </t>

            <div class="sh_subscription_portal wo-page wo-container">
                <t t-if="not subscriptions">
                    <div class="wo-empty">
                        <i class="fa fa-inbox"></i>
                        <h4>尚無訂閱</h4>
                        <p>目前沒有任何訂閱方案</p>
                    </div>
                </t>
                <t t-if="subscriptions">
                    <t t-foreach="subscriptions" t-as="subscription">
                        <div class="wo-list-card">
                            <input type="hidden" class="subscription_id" name="subscription_id" t-att-value="subscription.id"/>
                            <div class="wo-list-card-header">
                                <div>
                                    <h3 class="wo-list-card-title">
                                        <a t-att-href="'/my/sh_subscription/' + str(subscription.id)">
                                            <t t-esc="subscription.name"/>
                                        </a>
                                    </h3>
                                    <div class="wo-list-card-subtitle">
                                        <t t-esc="subscription.sh_subscription_plan_id.name"/>
                                    </div>
                                </div>
                                <t t-if="subscription.state == 'draft'">
                                    <span class="wo-badge wo-badge-draft">待啟用</span>
                                </t>
                                <t t-if="subscription.state == 'in_progress'">
                                    <span class="wo-badge wo-badge-active">
                                        <i class="fa fa-check-circle me-1"></i>啟用中
                                    </span>
                                </t>
                                <t t-if="subscription.state == 'cancel'">
                                    <span class="wo-badge wo-badge-cancel">已取消</span>
                                </t>
                                <t t-if="subscription.state == 'expire'">
                                    <span class="wo-badge wo-badge-expire">已過期</span>
                                </t>
                                <t t-if="subscription.state == 'close'">
                                    <span class="wo-badge wo-badge-close">已結束</span>
                                </t>
                                <t t-if="subscription.state == 'renewed'">
                                    <span class="wo-badge wo-badge-renewed">已續約</span>
                                </t>
                            </div>
                            <div class="wo-list-card-body">
                                <div class="wo-list-card-meta">
                                    <div>
                                        <span class="wo-meta-label">開始日期</span>
                                        <span class="wo-meta-value"><t t-esc="subscription.sh_start_date"/></span>
                                    </div>
                                    <div>
                                        <span class="wo-meta-label">結束日期</span>
                                        <span class="wo-meta-value">
                                            <t t-if="subscription.sh_no_of_billing_cycle == -1 and not subscription.sh_end_date">永不過期</t>
                                            <t t-else=""><t t-esc="subscription.sh_end_date"/></t>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <t t-if="subscription.state in ['draft', 'in_progress', 'cancel', 'close', 'expire'] or subscription.sh_renew_stage in ['time_to_renew']">
                                <div class="wo-card-footer">
                                    <t t-if="subscription.state in ['draft']">
                                        <a class="wo-btn wo-btn-cancel wo-btn-block sh_cancel_btn">
                                            <i class="fa fa-times"></i>取消訂閱
                                        </a>
                                    </t>
                                    <t t-if="subscription.state in ['in_progress'] and subscription.sh_subscription_plan_id.sh_is_close_by_customer">
                                        <a class="wo-btn wo-btn-danger wo-btn-block sh_close_btn">
                                            <i class="fa fa-power-off"></i>終止訂閱
                                        </a>
                                    </t>
                                    <t t-if="subscription.state in ['cancel','close','expire'] or (subscription.sh_renew_stage in ['time_to_renew'] and subscription.state not in ['renewed'])">
                                        <a class="wo-btn wo-btn-primary wo-btn-block sh_renew_btn">
                                            <i class="fa fa-refresh"></i>續訂
                                        </a>
                                    </t>
                                </div>
                            </t>
                        </div>
                    </t>
                </t>

                <!-- Cancel Modal -->
                <div id="cancel_subscription_modal" class="modal fade sh_cancel_subscription_modal_list wo-modal" role="dialog">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h4 class="modal-title">取消訂閱</h4>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <input type="hidden" id="cancel_subscription_id" class="cancel_subscription_id" name="cancel_subscription_id" value=""/>
                                <div class="mb-3">
                                    <label for="sh_reason_id" class="form-label fw-bold">取消原因</label>
                                    <select id="sh_reason_id" name="sh_reason_id" class="form-select">
                                        <option value="reason">-- 請選擇原因 --</option>
                                        <t t-foreach="request.env['sh.subscription.reason'].sudo().search([])" t-as="reason">
                                            <option t-att-value="reason.id"><t t-esc="reason.name"/></option>
                                        </t>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label for="sh_description" class="form-label fw-bold">補充說明</label>
                                    <textarea id="sh_description" name="sh_description" class="form-control" rows="3"></textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button class="wo-btn wo-btn-primary sh_cancel_now_cls" id="sh_cancel_now">確認取消</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Subscription Detail Page -->
    <template id="sh_subscription_portal_content" name="Subscription Portal Content">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Subscriptions</t>
            </t>

            <div class="sh_subscription_portal wo-page wo-container">
                <input type="hidden" id="subscription_id" class="subscription_id" name="subscription_id_form" t-att-value="sh_subscription.id"/>

                <!-- Status Header -->
                <div class="wo-status-header">
                    <div class="wo-status-title">
                        <h2>我的訂閱</h2>
                        <t t-if="sh_subscription.state == 'in_progress'">
                            <span class="wo-badge wo-badge-active"><i class="fa fa-check-circle me-1"></i>啟用中</span>
                        </t>
                        <t t-if="sh_subscription.state == 'draft'">
                            <span class="wo-badge wo-badge-draft">待啟用</span>
                        </t>
                        <t t-if="sh_subscription.state == 'close'">
                            <span class="wo-badge wo-badge-close">已結束</span>
                        </t>
                        <t t-if="sh_subscription.state == 'cancel'">
                            <span class="wo-badge wo-badge-cancel">已取消</span>
                        </t>
                        <t t-if="sh_subscription.state == 'expire'">
                            <span class="wo-badge wo-badge-expire">已過期</span>
                        </t>
                        <t t-if="sh_subscription.state == 'renewed'">
                            <span class="wo-badge wo-badge-renewed">已續約</span>
                        </t>
                    </div>
                    <div>
                        <t t-if="sh_subscription.state in ['draft']">
                            <a class="wo-btn wo-btn-cancel sh_cancel_btn"><i class="fa fa-times me-1"></i>取消</a>
                        </t>
                        <t t-if="sh_subscription.state in ['in_progress'] and sh_subscription.sh_subscription_plan_id.sh_is_close_by_customer">
                            <a class="wo-btn wo-btn-danger sh_close_btn"><i class="fa fa-power-off me-1"></i>終止</a>
                        </t>
                        <t t-if="sh_subscription.state in ['cancel','close','expire']">
                            <a class="wo-btn wo-btn-primary sh_renew_btn"><i class="fa fa-refresh me-1"></i>續訂</a>
                        </t>
                    </div>
                </div>

                <!-- Plan + Payment Info -->
                <div class="wo-info-grid">
                    <div class="wo-card">
                        <div class="wo-card-header">
                            <i class="fa fa-cube"></i>
                            <h3>方案資訊</h3>
                        </div>
                        <div class="wo-card-body">
                            <div class="wo-info-row">
                                <span class="wo-info-label">訂閱方案</span>
                                <span class="wo-info-value"><t t-esc="sh_subscription.sh_subscription_plan_id.name"/></span>
                            </div>
                            <div class="wo-info-row">
                                <span class="wo-info-label">週期</span>
                                <span class="wo-info-value">
                                    <t t-esc="sh_subscription.sh_recurrency"/>
                                    <t t-if="sh_subscription.sh_unit == 'day'">天</t>
                                    <t t-if="sh_subscription.sh_unit == 'week'">週</t>
                                    <t t-if="sh_subscription.sh_unit == 'month'">月</t>
                                    <t t-if="sh_subscription.sh_unit == 'year'">年</t>
                                </span>
                            </div>
                            <div class="wo-info-row">
                                <span class="wo-info-label">方案價格</span>
                                <span class="wo-info-value wo-info-value--primary">
                                    NT$ <t t-esc="int(sh_subscription.sh_plan_price)"/>
                                </span>
                            </div>
                            <div class="wo-info-row">
                                <span class="wo-info-label">開始日期</span>
                                <span class="wo-info-value"><span t-field="sh_subscription.sh_start_date"/></span>
                            </div>
                            <div class="wo-info-row">
                                <span class="wo-info-label">結束日期</span>
                                <span class="wo-info-value">
                                    <t t-if="sh_subscription.sh_end_date">
                                        <span t-field="sh_subscription.sh_end_date"/>
                                    </t>
                                    <t t-else="">
                                        <span class="wo-info-value--success">永不過期</span>
                                    </t>
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="wo-card">
                        <div class="wo-card-header">
                            <i class="fa fa-money"></i>
                            <h3>付款資訊</h3>
                        </div>
                        <div class="wo-card-body">
                            <div class="wo-info-row">
                                <span class="wo-info-label">試用期</span>
                                <span class="wo-info-value">
                                    <t t-if="sh_subscription.sh_trial_duration">
                                        <t t-esc="sh_subscription.sh_trial_duration"/>
                                        <t t-if="sh_subscription.sh_trial_unit == 'day'">天</t>
                                        <t t-if="sh_subscription.sh_trial_unit == 'week'">週</t>
                                        <t t-if="sh_subscription.sh_trial_unit == 'month'">月</t>
                                    </t>
                                    <t t-else="">無</t>
                                </span>
                            </div>
                            <div class="wo-info-row">
                                <span class="wo-info-label">計費週期數</span>
                                <span class="wo-info-value">
                                    <t t-if="sh_subscription.sh_no_of_billing_cycle == -1">無限</t>
                                    <t t-else=""><t t-esc="sh_subscription.sh_no_of_billing_cycle"/> 期</t>
                                </span>
                            </div>
                            <div class="wo-info-row">
                                <span class="wo-info-label">下次扣款日</span>
                                <span class="wo-info-value">
                                    <t t-if="sh_subscription.sh_date_of_next_payment">
                                        <span t-field="sh_subscription.sh_date_of_next_payment"/>
                                    </t>
                                    <t t-else="">--</t>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Message Thread -->
                <div class="wo-message-section">
                    <h3><i class="fa fa-comments"></i>訊息與附件</h3>
                    <t t-call="portal.message_thread">
                        <t t-set="object" t-value="sh_subscription"/>
                    </t>
                </div>

                <!-- Cancel Modal -->
                <div id="cancel_subscription_modal" class="modal fade wo-modal" role="dialog">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h4 class="modal-title">取消訂閱</h4>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <input type="hidden" id="cancel_subscription_id" class="cancel_subscription_id" name="cancel_subscription_id" value=""/>
                                <div class="mb-3">
                                    <label for="sh_reason_id" class="form-label fw-bold">取消原因</label>
                                    <select id="sh_reason_id" name="sh_reason_id" class="form-select">
                                        <option value="reason">-- 請選擇原因 --</option>
                                        <t t-foreach="request.env['sh.subscription.reason'].sudo().search([])" t-as="reason">
                                            <option t-att-value="reason.id"><t t-esc="reason.name"/></option>
                                        </t>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label for="sh_description" class="form-label fw-bold">補充說明</label>
                                    <textarea id="sh_description" name="sh_description" class="form-control" rows="3"></textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button class="wo-btn wo-btn-primary sh_cancel_now_cls" id="sh_cancel_now">確認取消</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
