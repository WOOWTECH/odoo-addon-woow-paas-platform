{
  "permissions": {
    "allow": [
      "Bash(maestri list)",
      "Bash(maestri check *)",
      "Bash(maestri note read *)",
      "Bash(maestri --help)",
      "Bash(plutil -lint *)",
      "Bash(tmux capture-pane *)",
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl wait *)",
      "Bash(kubectl config get-contexts*)",
      "Bash(npm view *)",
      "mcp__MongoDB__find",
      "mcp__MongoDB__count",
      "mcp__MongoDB__aggregate",
      "mcp__MongoDB__collection-indexes",
      "mcp__MongoDB__collection-schema",
      "mcp__wallaby__wallaby_failingTests",
      "mcp__wallaby__wallaby_runtimeValues",
      "mcp__serena__get_symbols_overview",
      "mcp__serena__find_symbol",
      "mcp__serena__read_memory",
      "mcp__serena__check_onboarding_performed"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/pattern-guard.py\"",
            "timeout": 10,
            "statusMessage": "pattern-guard：檢查守護路徑"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/audit/repo-lint.py\" --hook",
            "timeout": 15,
            "statusMessage": "repo-lint：假綠 gate 檢查"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/memory-links-guard.py\"",
            "timeout": 10,
            "statusMessage": "memory-links-guard：memory 索引對帳（僅 memory 目錄寫入時）"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "plan-review@eugene": true
  }
}
