#. module: woow_paas_platform
#: model:mail.template,subject:woow_paas_platform.mail_template_subscription_status
msgid ""
"[Woow PaaS] {{ ctx.get('status_title') or object.name }} ({{ object.name }})"
msgstr ""
"[Woow PaaS] {{ ctx.get('status_title') or object.name }}（{{ object.name }}）"

#. module: woow_paas_platform
#: model:mail.template,body_html:woow_paas_platform.mail_template_subscription_status
msgid ""
"<div style=\"font-family: Arial, sans-serif; max-width: 600px;\">\n"
"                    <p>Hi <t t-out=\"object.sh_partner_id.name\"/>,</p>\n"
"                    <p t-if=\"object.state == 'in_progress' and object.sh_renewed\">\n"
"                        Your subscription <strong t-out=\"object.name\"/>\n"
"                        (<t t-out=\"object.sh_subscription_plan_id.name or ''\"/>) has been renewed.\n"
"                    </p>\n"
"                    <p t-elif=\"object.state == 'in_progress'\">\n"
"                        Your subscription <strong t-out=\"object.name\"/>\n"
"                        (<t t-out=\"object.sh_subscription_plan_id.name or ''\"/>) is active.\n"
"                    </p>\n"
"                    <p t-elif=\"object.state == 'cancel'\">\n"
"                        Your subscription <strong t-out=\"object.name\"/>\n"
"                        (<t t-out=\"object.sh_subscription_plan_id.name or ''\"/>) has been cancelled.\n"
"                    </p>\n"
"                    <p t-elif=\"object.state in ('close', 'expire', 'renewed')\">\n"
"                        Your subscription <strong t-out=\"object.name\"/>\n"
"                        (<t t-out=\"object.sh_subscription_plan_id.name or ''\"/>) has ended.\n"
"                    </p>\n"
"                    <p t-if=\"object.state == 'in_progress' and ctx.get('trial_end_date')\">\n"
"                        Your free trial runs until <strong t-out=\"format_date(ctx.get('trial_end_date'))\"/>.\n"
"                        The first charge is on <strong t-out=\"format_date(object.sh_date_of_next_payment)\"/>.\n"
"                    </p>\n"
"                    <p t-elif=\"object.state == 'in_progress' and object.sh_date_of_next_payment\">\n"
"                        Your next charge is on <strong t-out=\"format_date(object.sh_date_of_next_payment)\"/>.\n"
"                        The subscription renews automatically until you cancel it.\n"
"                    </p>\n"
"                    <p t-if=\"ctx.get('has_invoice')\">\n"
"                        The invoice for this payment is attached.\n"
"                    </p>\n"
"                    <p style=\"color:#6b7280;font-size:12px;\">\n"
"                        If you have any questions, please contact support. Thank you for using\n"
"                        WoowTech PaaS.\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; max-width: 600px;\">\n"
"                    <p><t t-out=\"object.sh_partner_id.name\"/> 您好：</p>\n"
"                    <p t-if=\"object.state == 'in_progress' and object.sh_renewed\">\n"
"                        您的訂閱 <strong t-out=\"object.name\"/>\n"
"                        （<t t-out=\"object.sh_subscription_plan_id.name or ''\"/>）已續訂。\n"
"                    </p>\n"
"                    <p t-elif=\"object.state == 'in_progress'\">\n"
"                        您的訂閱 <strong t-out=\"object.name\"/>\n"
"                        （<t t-out=\"object.sh_subscription_plan_id.name or ''\"/>）已啟用。\n"
"                    </p>\n"
"                    <p t-elif=\"object.state == 'cancel'\">\n"
"                        您的訂閱 <strong t-out=\"object.name\"/>\n"
"                        （<t t-out=\"object.sh_subscription_plan_id.name or ''\"/>）已取消。\n"
"                    </p>\n"
"                    <p t-elif=\"object.state in ('close', 'expire', 'renewed')\">\n"
"                        您的訂閱 <strong t-out=\"object.name\"/>\n"
"                        （<t t-out=\"object.sh_subscription_plan_id.name or ''\"/>）已結束。\n"
"                    </p>\n"
"                    <p t-if=\"object.state == 'in_progress' and ctx.get('trial_end_date')\">\n"
"                        免費試用到 <strong t-out=\"format_date(ctx.get('trial_end_date'))\"/> 為止，\n"
"                        第一次扣款日是 <strong t-out=\"format_date(object.sh_date_of_next_payment)\"/>。\n"
"                    </p>\n"
"                    <p t-elif=\"object.state == 'in_progress' and object.sh_date_of_next_payment\">\n"
"                        下次扣款日是 <strong t-out=\"format_date(object.sh_date_of_next_payment)\"/>。\n"
"                        訂閱會自動續期，直到您取消為止。\n"
"                    </p>\n"
"                    <p t-if=\"ctx.get('has_invoice')\">\n"
"                        本次付款的發票附在這封信中。\n"
"                    </p>\n"
"                    <p style=\"color:#6b7280;font-size:12px;\">\n"
"                        如有任何問題，請與客服聯絡。感謝您使用 WoowTech PaaS。\n"
"                    </p>\n"
"                </div>\n"
"            "

