#. module: woow_paas_platform
#: model:mail.template,body_html:woow_paas_platform.mail_template_subscription_cancelled
msgid ""
"<div style=\"font-family: Arial, sans-serif; max-width: 600px;\">\n"
"                    <p>Hi <t t-out=\"object.name\"/>,</p>\n"
"                    <p>\n"
"                        Your subscription\n"
"                        <strong t-out=\"ctx.get('plan_name', '')\"/>\n"
"                        (<t t-out=\"ctx.get('subscription_name', '')\"/>)\n"
"                        has been <strong>auto-cancelled</strong> after\n"
"                        <t t-out=\"ctx.get('failures', '')\"/> consecutive\n"
"                        payment failures on the outstanding invoice\n"
"                        <strong t-out=\"ctx.get('invoice_name', '')\"/>\n"
"                        (<t t-out=\"ctx.get('amount_text', '')\"/>).\n"
"                    </p>\n"
"                    <p>\n"
"                        Your associated services have been suspended. Your\n"
"                        data will be preserved for\n"
"                        <strong><t t-out=\"ctx.get('preservation_months', "
"6)\"/> months</strong>;\n"
"                        starting a fresh subscription within that window "
"may\n"
"                        re-attach to your existing storage.\n"
"                    </p>\n"
"                    <p>\n"
"                        To resume service, please subscribe again from the\n"
"                        Woow PaaS marketplace.\n"
"                    </p>\n"
"                    <p style=\"color:#6b7280;font-size:12px;\">\n"
"                        If this cancellation is unexpected, contact "
"support.\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

#. module: woow_paas_platform
#: model:mail.template,body_html:woow_paas_platform.mail_template_low_balance
msgid ""
"<div style=\"font-family: Arial, sans-serif; max-width: 600px;\">\n"
"                    <p>Hi <t t-out=\"object.name\"/>,</p>\n"
"                    <p>\n"
"                        Your subscription invoice\n"
"                        <strong t-out=\"ctx.get('invoice_name', '')\"/>\n"
"                        of\n"
"                        <strong t-out=\"ctx.get('amount_text', '')\"/>\n"
"                        could not be paid because your wallet balance is "
"insufficient.\n"
"                    </p>\n"
"                    <p>Current wallet balance: <strong t-"
"out=\"ctx.get('balance_text', '')\"/></p>\n"
"                    <p>\n"
"                        Please top up your wallet to keep your service "
"active.\n"
"                        You have a grace period before the service is "
"suspended.\n"
"                    </p>\n"
"                    <p>\n"
"                        <a t-att-href=\"ctx.get('topup_url', '#')\" "
"style=\"display:inline-block;background:#6366f1;color:#ffffff;padding:10px "
