            <field name="domain_force">[('project_id.project_access_ids', 'any', [('user_id', '=', user.id), ('role', '=', 'guest')])]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="skill_rule_admin_full" model="ir.rule">
            <field name="name">Skill: admin full CRUD (group_system bypass)</field>
            <field name="model_id" ref="model_woow_paas_platform_skill"/>
            <field name="domain_force">[(1, '=', 1)]</field>
