        <!-- project_access (design §4.3 — 4 rules) -->

        <record id="project_access_rule_member_read" model="ir.rule">
            <field name="name">ProjectAccess: project member read</field>
            <field name="model_id" ref="model_woow_paas_platform_project_access"/>
            <field name="domain_force">[('project_id.project_access_ids', 'any', [('user_id', '=', user.id)])]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
