<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Workspace: Users can read/write workspaces where they are members -->
        <record id="workspace_rule_member_access" model="ir.rule">
            <field name="name">Workspace: member access only</field>
            <field name="model_id" ref="model_woow_paas_platform_workspace"/>
            <field name="domain_force">[('access_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Workspace: Any user can create new workspaces -->
        <record id="workspace_rule_create" model="ir.rule">
            <field name="name">Workspace: anyone can create</field>
            <field name="model_id" ref="model_woow_paas_platform_workspace"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- WorkspaceAccess: Users can read/write access records for workspaces they're members of -->
        <record id="workspace_access_rule_member_access" model="ir.rule">
            <field name="name">WorkspaceAccess: member access only</field>
            <field name="model_id" ref="model_woow_paas_platform_workspace_access"/>
            <field name="domain_force">[('workspace_id.access_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- WorkspaceAccess: Any user can create access records (for invitations) -->
        <record id="workspace_access_rule_create" model="ir.rule">
            <field name="name">WorkspaceAccess: anyone can create</field>
            <field name="model_id" ref="model_woow_paas_platform_workspace_access"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>

    <!-- Refactor-managed rules (noupdate=0): module owns the definitive domain,
         so module updates re-apply edits. Admin tweaks here will be reverted on
         `-u` — that is the intended behaviour for the three security-critical
         rules introduced by the CloudService ↔ Project decouple refactor
         (project_rule_workspace_member, cloud_service_rule_workspace_member,
         project_task_rule_workspace_member). -->
    <data noupdate="0">
        <!-- Project visibility (decoupled CloudService ↔ Project):
             - bound project → visible to workspace members (via cloud_service.workspace)
             - unbound project → visible to project members (user_ids / follower partner / creator)
             Replaces the legacy ('|', ('cloud_service_id', '=', False), ...) short-circuit
             that leaked every unbound project to all base.group_user accounts. -->
        <record id="project_rule_workspace_member" model="ir.rule">
            <field name="name">Project: workspace member (bound) or project member (unbound)</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="domain_force">['|', ('cloud_service_id.workspace_id.access_ids.user_id', '=', user.id), '&amp;', ('cloud_service_id', '=', False), '|', ('message_partner_ids', 'in', [user.partner_id.id]), ('create_uid', '=', user.id)]</field>
            <!-- Apply to both base.group_user and project.group_project_user: Odoo
                 evaluates per-group rules with OR semantics, so a user that has
                 group_project_user (e.g. project admins) would otherwise bypass the
                 workspace filter via that group's unrestricted ruleset. -->
            <field name="groups" eval="[(4, ref('base.group_user')), (4, ref('project.group_project_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- CloudService: only workspace members may see / mutate services in that ws.
             Plugs the pre-existing ACL gap surfaced by D2=A — Task form's M2M widget
             walks ORM directly, so a controller-only filter is insufficient. -->
        <record id="cloud_service_rule_workspace_member" model="ir.rule">
            <field name="name">CloudService: workspace member access only</field>
            <field name="model_id" ref="model_woow_paas_platform_cloud_service"/>
            <field name="domain_force">[('workspace_id.access_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Task: workspace member (bound project) or project member (unbound) — full CRUD.
             Odoo's `task_visibility_rule_project_user` only applies to users with
             project.group_project_user; this rule grants the same surface to plain
             base.group_user accounts when they belong to the task's project workspace
             (bound) or are project followers/creator (unbound). Required for D3=A
             so workspace members can manage tasks on their own projects.

             Partners with the symmetric deactivation in migrations/18.0.1.0.23/
             post-migrate.py, which turns off Odoo's `task_visibility_rule` and
             `task_visibility_rule_project_user`. If a future maintainer re-enables
             either std rule, the OR-combined per-group ruleset will reopen the
             cross-workspace task leak that CAQA B1 caught. Keep the three-way
             deactivation (project_public_members_rule + the two task rules) and
             this scoped task rule in lockstep. -->
        <record id="project_task_rule_workspace_member" model="ir.rule">
            <field name="name">Task: workspace member (bound) or project member (unbound)</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">['|', ('project_id.cloud_service_id.workspace_id.access_ids.user_id', '=', user.id), '&amp;', ('project_id.cloud_service_id', '=', False), '|', ('project_id.message_partner_ids', 'in', [user.partner_id.id]), ('project_id.create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- MAJOR 1 fix (rule split): the original dual-leg single-rule design
             (mcp_server_rule_workspace_member + mcp_tool_rule_workspace_member)
             let base.group_user ORM-create scope='system' MCP rows because the
             ('scope', '=', 'system') leg is True for newly-built rows. Split
             into two rules per model so read direction stays universally true
             for system-scope (Invariant #6) while create/write/unlink are
             scoped to user-scope rows in the caller's own workspace. Pattern
             mirrors workspace_rule_member_access + workspace_rule_create
             above. Migration 18.0.1.0.24 step 5 retires the old two xmlids
             to prevent OR-combine with these new rules on `-u`. -->

        <!-- McpServer: system-scope is universally READABLE only (Invariant #6).
             perm_create/write/unlink False here blocks ORM create({'scope':
             'system', ...}) attacks — only sudo, group_system, and demo data
             XML may seed system MCP. -->
        <record id="mcp_server_rule_system_readonly" model="ir.rule">
            <field name="name">McpServer: system-scope read-only (all internal users)</field>
            <field name="model_id" ref="model_woow_paas_platform_mcp_server"/>
            <field name="domain_force">[('scope', '=', 'system')]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- McpServer: workspace members get full CRUD on user-scope MCP in
             their own workspace. scope='user' in the domain ensures this rule
             cannot be used to create scope='system' rows (domain match fails
             on a system-scope new record). -->
        <record id="mcp_server_rule_workspace_user" model="ir.rule">
            <field name="name">McpServer: workspace member CRUD on user-scope</field>
            <field name="model_id" ref="model_woow_paas_platform_mcp_server"/>
            <field name="domain_force">[('scope', '=', 'user'), ('project_id.cloud_service_id.workspace_id.access_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- McpTool: B1 sub-model parity — system-scope tools read-only via
             server_id walk. perm_create=False blocks tool definition forgery
             on existing system MCPs. -->
        <record id="mcp_tool_rule_system_readonly" model="ir.rule">
            <field name="name">McpTool: system-scope read-only (all internal users)</field>
            <field name="model_id" ref="model_woow_paas_platform_mcp_tool"/>
            <field name="domain_force">[('server_id.scope', '=', 'system')]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- McpTool: B1 sub-model parity — workspace member full CRUD on
             tools whose server is in their workspace. -->
        <record id="mcp_tool_rule_workspace_user" model="ir.rule">
            <field name="name">McpTool: workspace member CRUD on user-scope</field>
            <field name="model_id" ref="model_woow_paas_platform_mcp_tool"/>
            <field name="domain_force">[('server_id.scope', '=', 'user'), ('server_id.project_id.cloud_service_id.workspace_id.access_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Admin (group_system) backend bypass. Required because
             group_system inherits group_user via implied_ids — without an
             explicit group_system rule, the system_readonly perm_create=False
             blocks admin from seeding scope='system' MCP through the backend
             UI. Odoo resolves rules per-group with OR semantics, so this
             rule short-circuits the deny for admins. Same bypass for
             mcp_tool below (B1 sub-model parity). -->
        <record id="mcp_server_rule_admin_full" model="ir.rule">
            <field name="name">McpServer: admin full CRUD (group_system bypass)</field>
            <field name="model_id" ref="model_woow_paas_platform_mcp_server"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="mcp_tool_rule_admin_full" model="ir.rule">
            <field name="name">McpTool: admin full CRUD (group_system bypass)</field>
            <field name="model_id" ref="model_woow_paas_platform_mcp_tool"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- CAQA B1 fresh-install fix (D9 / AC #29): deactivate the three Odoo
             std project/task rules whose always-true `privacy_visibility !=
             'followers'` legs would OR-bypass our workspace-scoped rules
             (project_rule_workspace_member + project_task_rule_workspace_member).

             3-way symmetric deactivation matches migrations/18.0.1.0.23/post-migrate.py:
               - project.project_public_members_rule  → project.project leak
               - project.task_visibility_rule         → project.task leak (base.group_user)
               - project.task_visibility_rule_project_user → project.task leak (project_user)

             Migration only runs on upgrade (`if not version: return` early-out at
             post-migrate.py:35), so fresh-install path needs this XML declaration
             to land all three at install time too. CAQA B-1 (re-loop 2026-05-20)
             caught the missing project_public_members_rule entry — keep the
             ref list in 1:1 sync with the migration's UPDATE ... WHERE name IN (...).

             We can't use `<record id="project.task_visibility_rule">` because the
             std rules were loaded by project module under `<data noupdate="1">`
             (project/security/project_security.xml:48), so their ir_model_data
             rows carry noupdate=true and Odoo's XML loader skips updates from
             other modules. The `<function>` call bypasses this — it goes
             straight through ORM write. Re-enabling any of the three std rules
             re-opens the original B1 leak surfaced in CAQA. -->
        <function model="ir.rule" name="write" eval="[
            [ref('project.project_public_members_rule'),
             ref('project.task_visibility_rule'),
             ref('project.task_visibility_rule_project_user')],
            {'active': False}
        ]"/>
    </data>
</odoo>
