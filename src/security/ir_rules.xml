        <record id="project_access_rule_owner_admin_manage" model="ir.rule">
            <field name="name">ProjectAccess: project owner/admin manage</field>
            <field name="model_id" ref="model_woow_paas_platform_project_access"/>
            <field name="domain_force">[('project_id.project_access_ids', 'any', [('user_id', '=', user.id), ('role', 'in', ['owner', 'admin'])])]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="project_access_rule_self" model="ir.rule">
            <field name="name">ProjectAccess: self introspection</field>
            <field name="model_id" ref="model_woow_paas_platform_project_access"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="project_access_rule_admin_full" model="ir.rule">
            <field name="name">ProjectAccess: admin full CRUD (group_system bypass)</field>
            <field name="model_id" ref="model_woow_paas_platform_project_access"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ============================================================== -->
        <!-- HC-4 (reviewer 2026-05-22) — ir.attachment side-channel deny    -->
        <!--                                                                 -->
        <!-- Attack: ``skill.bundle_attachment_id`` is field-level masked    -->
        <!-- (B1.SK-6), but a non-admin who knows the attachment id can hit  -->
        <!-- ``/web/content/<id>?download=1`` to stream the bytes —          -->
        <!-- delegation through ``ir.attachment._check()`` falls back to the -->
        <!-- skill model's permissive R rule for project members. We gate    -->
        <!-- the attachment row directly here.                               -->
        <!--                                                                 -->
        <!-- Odoo 18 ships NO default ir.rule on ir.attachment for           -->
        <!-- base.group_user (verified via DB query at impl time) — meaning  -->
        <!-- there is no std rule to deactivate; adding a group_user rule    -->
        <!-- introduces row-level filtering for the first time, narrowing   -->
        <!-- base.group_user from "all attachments" to "all non-skill        -->
        <!-- attachments". The second rule re-grants group_system            -->
        <!-- unrestricted access (mirrors the admin_full pattern used by the -->
        <!-- B-1 ACL fix).                                                   -->
        <!-- ============================================================== -->

        <record id="ir_attachment_rule_skill_bundle_user_scope" model="ir.rule">
            <field name="name">ir.attachment: internal user CRUD except skill bundles</field>
            <field name="model_id" ref="base.model_ir_attachment"/>
            <field name="domain_force">[('res_model', '!=', 'woow_paas_platform.skill')]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="ir_attachment_rule_skill_bundle_admin_full" model="ir.rule">
            <field name="name">ir.attachment: admin full CRUD (group_system bypass for skill bundles)</field>
            <field name="model_id" ref="base.model_ir_attachment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
