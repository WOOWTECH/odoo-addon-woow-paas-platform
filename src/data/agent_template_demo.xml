         for the admin enablement surface — it must stay unpublished (draft) and
         its xmlid is a frozen contract: woow_paas_platform.agent_template_demo. -->
    <data noupdate="1">
        <record id="agent_template_demo" model="woow_paas_platform.agent_template">
            <field name="name">Demo Agent Template</field>
            <field name="title">Demo Agent</field>
            <field name="description">Unpublished demo template for the Phase D agent-runtime enablement surface. Not bound to any project.</field>
            <field name="is_public" eval="True"/>
            <field name="state">draft</field>
        </record>
    </data>
</odoo>
