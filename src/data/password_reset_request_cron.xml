<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 商用驗收 X-SEC-007：忘記密碼請求只排隊，由這支 cron 查帳號並寄信（含每帳號寄信節流）。
             請求路徑會 _trigger() 立刻喚醒它；5 分鐘的週期只是保底。 -->
        <record id="ir_cron_password_reset_requests" model="ir.cron">
            <field name="name">PaaS: Process Password Reset Requests</field>
            <field name="model_id" ref="model_woow_paas_platform_password_reset_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_requests()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
