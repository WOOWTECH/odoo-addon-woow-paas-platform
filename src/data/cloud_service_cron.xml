<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron: Deploy pending cloud services -->
        <record id="ir_cron_deploy_cloud_services" model="ir.cron">
            <field name="name">Cloud Service: Deploy Pending</field>
            <field name="model_id" ref="model_woow_paas_platform_cloud_service"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_pending_deploys()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <!-- Cron: 背景短 poll（deploying／upgrading／initializing／deleting）

             #1159 Q1：「由觀測推進、離開轉移狀態」的唯一寫入者（list/get 純讀）。
             它不執行 init，init 在下面那筆獨立的 cron。 -->
        <record id="ir_cron_check_deploying_services" model="ir.cron">
            <field name="name">Cloud Service: Check Deploying</field>
            <field name="model_id" ref="model_woow_paas_platform_cloud_service"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_deploying_services()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <!-- Cron: post-deploy init（#1159 Q4／Q33）

             與上面的短 poll 刻意分成兩筆 ir.cron：core 以 SKIP LOCKED 保證同一筆 cron
             單例 ⇒ init 最多佔 1 個 cron worker，且不與短 poll 同 job、同交易——一筆
             Odoo init 最壞 1020s，不能堵住其他服務的 upgrading→running。
             每 tick 的 wall 預算、n8n 優先、自我 _trigger() 見
             `CloudService._cron_run_post_deploy_inits`。
             ⚠ 承載它的 runtime 必須明設 limit_time_real_cron ≥ 1800（Q12／Q34；prod 見
                woow-paas/paas-app-bundle-cd#154）。
             ⚠ 本檔是 noupdate：新 record 在升級時會建立，日後改 interval 不會生效。 -->
        <record id="ir_cron_run_post_deploy_inits" model="ir.cron">
            <field name="name">Cloud Service: Run Post-deploy Init</field>
            <field name="model_id" ref="model_woow_paas_platform_cloud_service"/>
            <field name="state">code</field>
            <field name="code">model._cron_run_post_deploy_inits()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <!-- Cron: 部署逾時的有限度自癒（#1416）

             #489 的 age timeout 只代表「等太久」：卡住的原因（磁碟排程額度、拉 image 慢）
             解除後 release 會自己起來，但上面那條短 poll 只撈轉移狀態，error 永遠停在
             error。本條低頻重查「逾時造成、仍在時間窗內、未停權」的 error 服務，就緒就
             照正常路徑推進（需要 init 的進 initializing，否則 running）。時間窗由
             woow_paas_platform.timeout_recovery_window_hours（預設 168 小時）調整。
             ⚠ 本檔是 noupdate：日後改 interval 不會生效（改 DB／後台排程動作）。 -->
        <record id="ir_cron_recover_timed_out_services" model="ir.cron">
            <field name="name">Cloud Service: Recover Timed-out Deployments</field>
            <field name="model_id" ref="model_woow_paas_platform_cloud_service"/>
            <field name="state">code</field>
            <field name="code">model._cron_recover_timed_out_services()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <!-- Cron: Public URL 未驗證旗標的背景重探（#1159 Q16／D4）

             list/get 純讀之後，放行時寫下的 public_url_dns_unverified 改由這裡清。
             只探帶旗標的 running 服務；每 15 分一次（軟提示，延遲可接受）。 -->
        <record id="ir_cron_reprobe_public_url_dns" model="ir.cron">
            <field name="name">Cloud Service: Re-probe Public URL DNS</field>
            <field name="model_id" ref="model_woow_paas_platform_cloud_service"/>
            <field name="state">code</field>
            <field name="code">model._cron_reprobe_public_url_dns()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <!-- Cron: 對帳 running 服務的 release 事實（#627 (i)）

             上面那條 cron 只掃轉移狀態，抓不到「非由 Odoo 發起的 chart 變動」——
             那種變動發生時服務正是 running。本條補上，且**絕不碰 state**。

             ⚠ 頻率刻意是每日一次：漂移的後果是帳面錯誤不是服務中斷。要不要縮短，
                看 cron 那條 log 累積的資料再決定，不要用直覺。
             ⚠ 本檔是 <data noupdate="1">：這筆 record 在升級時**會**被建立（noupdate
                只擋既有 record 被更新），但**日後改這裡的 interval 不會生效**——要改
                頻率得改 DB 或走 migration。 -->
        <record id="ir_cron_reconcile_release_facts" model="ir.cron">
            <field name="name">Cloud Service: Reconcile Release Facts</field>
            <field name="model_id" ref="model_woow_paas_platform_cloud_service"/>
            <field name="state">code</field>
            <field name="code">model._cron_reconcile_release_facts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <!-- Cron: running 服務的 workload 有沒有 Pod（#1647）

             服務顯示 running，但某個 Deployment／StatefulSet 期望有 Pod、實際一顆都沒有
             （2026-10-10：ReplicaSet FailedCreate exceeded quota，中斷近 6 小時無訊號）。
             短 poll 只看轉移狀態、每日對帳一天一次——本條每 10 分鐘看一次 running 的服務，
             發現時寫 workload_fault_*、通知系統管理員、讓 /woow 顯示提示，恢復後自動清掉。
             **絕不碰 state／error_message**（repo-lint 第 19 條判準 5 機械守）。
             健康的穩態不寫服務列（值真的變了才寫）；輪替位置記在 PaaS Platform Monitor
             單例的 workload_check_cursor，不記在服務列上。

             ⚠ 要調頻率或暫時停用：到後台「設定 → 技術 → 排程動作」改這一筆。
             ⚠ 本檔是 noupdate：這筆 record 在升級時會被建立，但日後改這裡的 interval
                不會生效（改 DB／後台排程動作）。 -->
        <record id="ir_cron_check_running_workloads" model="ir.cron">
            <field name="name">Cloud Service: Check Running Workloads</field>
            <field name="model_id" ref="model_woow_paas_platform_cloud_service"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_running_workloads()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <!-- Cron: 清理 post-deploy init 的 attempt 記錄（#1257 Q39）

             保留每服務最近 20 筆＋目前這一代的全部；超過 90 天者清掉（當代除外）。
             20／90 是保守值，沒有量測依據。 -->
        <record id="ir_cron_purge_init_attempts" model="ir.cron">
            <field name="name">Cloud Service: Purge Init Attempts</field>
            <field name="model_id" ref="model_woow_paas_platform_cloud_service_init_attempt"/>
            <field name="state">code</field>
            <field name="code">model._cron_purge_init_attempts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
