        <!-- Odoo ERP -->
        <record id="cloud_app_odoo" model="woow_paas_platform.cloud_app_template">
            <field name="name">Odoo</field>
            <field name="slug">odoo</field>
            <field name="description">Open-source business apps suite</field>
            <field name="full_description">Odoo is a comprehensive suite of open-source business
                applications including CRM, eCommerce, accounting, inventory, project management,
                and more. It provides an all-in-one management software that is fully integrated and
                customizable.</field>
            <field name="category">web</field>
            <field name="tags">["odoo", "erp", "crm", "web", "business"]</field>

            <field name="documentation_url">https://www.odoo.com/documentation/</field>

            <!-- Helm Configuration (OCI registry format) -->
            <field name="helm_repo_url"></field>
            <field name="helm_chart_name">oci://registry-1.docker.io/bitnamicharts/odoo</field>
            <field name="helm_chart_version"></field>
            <!-- helm_default_values: customPostInitScripts for:
                 1) fix-admin-credentials.sh - hash password with pbkdf2_sha512
                    (Bitnami writes plaintext; login stays as email per user choice)
                 2) odoo-conf-system.sh - inject system odoo.conf settings:
                    proxy_mode, list_db, workers, limit_memory_*, limit_time_* -->
            <field name="helm_default_values">{"global": {"security": {"allowInsecureImages": true}}, "image": {"registry": "jcr-prod.woowtech.io", "repository": "woow-paas-docker-local/cloud-odoo", "tag": "20260407.1522"}, "odooEmail": "user@example.com", "odooSkipInstall": false, "loadDemoData": false, "service": {"type": "ClusterIP"}, "resources": {"requests": {"cpu": "200m", "memory": "512Mi"}, "limits": {"cpu": "2000m", "memory": "2Gi"}}, "postgresql": {"enabled": true, "architecture": "standalone", "auth": {"username": "bn_odoo", "database": "bitnami_odoo"}, "image": {"registry": "docker.io", "repository": "bitnamilegacy/postgresql", "tag": "17.6.0-debian-12-r4"}}, "persistence": {"enabled": true, "size": "10Gi"}, "updateStrategy": {"type": "Recreate"}, "customPostInitScripts": {"fix-admin-credentials.sh": "#!/bin/bash\nset -eo pipefail\necho '[fix-admin-credentials] Hashing Odoo admin password with pbkdf2_sha512'\n[ -z \"${ODOO_PASSWORD:-}\" ] \u0026\u0026 echo 'WARN: ODOO_PASSWORD not set, skipping' \u0026\u0026 exit 0\n/opt/bitnami/odoo/venv/bin/python3 -c \"\nimport os, sys\ntry:\n from passlib.context import CryptContext\n import psycopg2\n ctx = CryptContext(schemes=['pbkdf2_sha512'])\n hashed = ctx.hash(os.environ['ODOO_PASSWORD'])\n conn = psycopg2.connect(\n  host=os.environ['ODOO_DATABASE_HOST'],\n  port=int(os.environ.get('ODOO_DATABASE_PORT_NUMBER', '5432')),\n  user=os.environ['ODOO_DATABASE_USER'],\n  password=os.environ['ODOO_DATABASE_PASSWORD'],\n  dbname=os.environ['ODOO_DATABASE_NAME'])\n cur = conn.cursor()\n cur.execute('UPDATE res_users SET password=%s WHERE id=2', (hashed,))\n conn.commit()\n cur.close()\n conn.close()\n print('[fix-admin-credentials] Password hashed successfully')\nexcept Exception as e:\n print(f'[fix-admin-credentials] ERROR: {e}', file=sys.stderr)\n sys.exit(1)\n\"\n", "odoo-conf-system.sh": "#!/bin/bash\nset -eo pipefail\nCONF=/opt/bitnami/odoo/conf/odoo.conf\necho '[odoo-conf-system] Injecting system-level odoo.conf settings'\n[ ! -f \"$CONF\" ] \u0026\u0026 echo \"WARN: $CONF not found, skipping\" \u0026\u0026 exit 0\ngrep -q '^proxy_mode' \"$CONF\" || echo 'proxy_mode = True' >> \"$CONF\"\ngrep -q '^list_db' \"$CONF\" || echo 'list_db = False' >> \"$CONF\"\nsed -i '/^workers/d' \"$CONF\"\nsed -i '/limit_memory_hard/d' \"$CONF\"\nsed -i '/limit_memory_soft/d' \"$CONF\"\nsed -i '/limit_time_cpu/d' \"$CONF\"\nsed -i '/limit_time_real/d' \"$CONF\"\necho 'workers = 0' >> \"$CONF\"\necho 'limit_memory_hard = 0' >> \"$CONF\"\necho 'limit_memory_soft = 0' >> \"$CONF\"\necho 'limit_time_cpu = 60' >> \"$CONF\"\necho 'limit_time_real = 120' >> \"$CONF\"\necho '[odoo-conf-system] Settings injected'\n"}}</field>
            <field name="helm_value_specs">{"required": [
                {"key": "odooEmail", "label": "Administrator Email", "type": "text",
                "default": "user@example.com",
                "description": "Login email for Odoo administrator"},
                {"key": "odooPassword", "label": "Administrator Password", "type": "password",
                "description": "Minimum 8 characters"}
                ], "optional": [
                {"key": "loadDemoData", "label": "Load Demo Data", "type": "boolean",
                "default": false},
                {"key": "smtpHost", "label": "SMTP Server", "type": "text",
                "placeholder": "smtp.gmail.com",
                "description": "SMTP mail server hostname"},
                {"key": "smtpPort", "label": "SMTP Port", "type": "text",
                "default": "587"},
                {"key": "smtpUser", "label": "SMTP Username", "type": "text",
                "placeholder": "user@gmail.com"},
                {"key": "smtpPassword", "label": "SMTP Password", "type": "password"},
                {"key": "smtpProtocol", "label": "SMTP Protocol", "type": "select",
                "options": ["starttls", "ssl", "none"], "default": "starttls",
                "description": "Email encryption protocol"}
                ]}</field>

            <!-- Service Configuration -->
            <field name="default_port">8069</field>
            <field name="ingress_enabled" eval="True" />

            <!-- Resource Requirements -->
            <field name="min_vcpu">2</field>
            <field name="min_ram_gb">2.0</field>
            <field name="min_storage_gb">10</field>

            <!-- Post-Deploy Init: auto-refresh module list after deployment -->
            <field name="post_deploy_init_type">odoo</field>

            <field name="is_active" eval="True" />
        </record>

        <!-- MCP Server: Hermes (pilot) — MCP capability built into the body, NOT a sidecar -->
        <record id="cloud_app_mcp_hermes" model="woow_paas_platform.cloud_app_template">
            <field name="name">Hermes MCP Server</field>
            <field name="slug">mcp-hermes</field>
            <field name="description">Hermes MCP server with admin GUI</field>
            <field name="full_description">Hermes MCP server — a managed Model Context
                Protocol server with an admin GUI and an MCP client endpoint, persisting
                its configuration on a dedicated volume.</field>
            <field name="category">mcp</field>
            <field name="tags">["mcp", "hermes", "mcp-server", "ai"]</field>

            <!-- Helm Configuration (OCI; chart from woow-paas-docker-local).
                 helm_chart_version 0.1.1 + image tag pinned to git-sha post-merge
                 (PR #5 → CI run 717; was latest at pilot; see design spec 契約補遺/階段3).
                 OCI repo: B 解（pilot 重用 image repo woow-paas-docker-local；
                 GA 遷專用 woow-paas-charts-local，見 spec 階段3 follow-up）. -->
            <field name="helm_repo_url"></field>
            <field name="helm_chart_name">oci://jcr-prod.woowtech.io/woow-paas-docker-local/mcp-server</field>
            <field name="helm_chart_version">0.1.5</field>
            <field name="helm_default_values">{"app": "hermes", "image": {"repository": "jcr-prod.woowtech.io/woow-paas-docker-local/hermes-mcp-admin", "tag": "a16825913ff3e87b829213efb7a9f5a08a18b123@sha256:ee6b296ebd7b2e9e7b72aa442e5119bec6aecd5e6bad6d2dc1d8221024eaa6e6"}, "service": {"port": 8080}, "envPrefix": "HERMES_", "persistence": {"enabled": true, "size": "2Gi"}, "updateStrategy": {"type": "Recreate"}}</field>
            <field name="helm_value_specs">{"required": [], "optional": []}</field>

            <!-- Service Configuration -->
            <field name="default_port">8080</field>
            <field name="ingress_enabled" eval="True" />

            <!-- Resource Requirements -->
            <field name="min_vcpu">1</field>
            <field name="min_ram_gb">1.0</field>
            <field name="min_storage_gb">5</field>

            <!-- MCP capability is built into the service body; NO sidecar -->
            <field name="mcp_enabled" eval="False" />
            <field name="post_deploy_init_type">none</field>

            <field name="is_active" eval="True" />
        </record>

        <!-- MCP Server: Odoo — MCP built into the body, NOT a sidecar. Copies the
             hermes pilot contract; differs only in container internals (image,
             app selector, internal SSE port 8000 handled by the image proxy).
             Image pinned to git-sha 9d10944 (CI run 717), which already includes
             the shared proxy Host+Origin fix (commit 4be649c, verified ancestor)
             — so the design 階段4「複製前必補 proxy Origin」item is satisfied. -->
        <record id="cloud_app_mcp_odoo" model="woow_paas_platform.cloud_app_template">
            <field name="name">Odoo MCP Server</field>
            <field name="slug">mcp-odoo</field>
            <field name="description">Odoo MCP server with admin GUI</field>
            <field name="full_description">Odoo MCP server — a managed Model Context
                Protocol server with an admin GUI and an MCP client endpoint, persisting
                its configuration on a dedicated volume.</field>
            <field name="category">mcp</field>
            <field name="tags">["mcp", "odoo", "mcp-server", "ai"]</field>

            <!-- Helm Configuration (OCI; shared mcp-server chart 0.1.5, values 切 app).
                 envPrefix MUST be camelCase + empty string for odoo (design 階段1 守線).
                 config.nonSensitive.mcp_server OVERRIDES the chart's hermes-shaped
                 default config (chart default command='hermes-mcp-server'); without it
                 odoo's child process never spawns → MCP endpoint silent 502 (GAP-O1).
                 GAP-O1: odoo-mcp-server 0.1.3 is stdio-only (no `odoo-mcp-server`
                 console script, no transport flag); the correct launch wraps the stdio
                 server via mcp-admin-core's mcp_sse_wrapper. Verified by woow-mcp-server
                 (SSE handshake 200 + MCP initialize + list_tools 7 tools). odoo's MCP
                 subprocess needs NO sensitive config to start. -->
            <field name="helm_repo_url"></field>
            <field name="helm_chart_name">oci://jcr-prod.woowtech.io/woow-paas-docker-local/mcp-server</field>
            <field name="helm_chart_version">0.1.5</field>
            <field name="helm_default_values">{"app": "odoo", "image": {"repository": "jcr-prod.woowtech.io/woow-paas-docker-local/odoo-mcp-admin", "tag": "05ffbe7fa5954cb37d4181069f3a76d97c3864b9@sha256:8d6d4d87085e0b9ad362ca4cc55cf3915a34224e2b15e816b85a0123080afa43"}, "service": {"port": 8080}, "envPrefix": "", "persistence": {"enabled": true, "size": "2Gi"}, "updateStrategy": {"type": "Recreate"}, "config": {"nonSensitive": {"mcp_server": {"command": "python", "args": ["-m", "mcp_admin_core.mcp_sse_wrapper", "mcp_server_odoo.server:server", "--port", "8000"], "port": 8000, "env_prefix": ""}}}}</field>
            <field name="helm_value_specs">{"required": [], "optional": []}</field>

            <!-- Service Configuration -->
            <field name="default_port">8080</field>
            <field name="ingress_enabled" eval="True" />

            <!-- Resource Requirements -->
            <field name="min_vcpu">1</field>
            <field name="min_ram_gb">1.0</field>
            <field name="min_storage_gb">5</field>

            <!-- MCP capability is built into the service body; NO sidecar -->
            <field name="mcp_enabled" eval="False" />
            <field name="post_deploy_init_type">none</field>

            <field name="is_active" eval="True" />
        </record>

        <!-- MCP Server: n8n — MCP built into the body, NOT the existing n8n-mcp sidecar.
             ACTIVE. image = launcher sha 2ef1dc16 (n8n-mcp-http), chart 0.1.4.
             n8n-mcp http mode MANDATES a non-empty AUTH_TOKEN (GAP-N2, double-auth) —
             satisfied WITHOUT an operator per-instance Secret: chart 0.1.4's secret.yaml
             self-generates config.authToken (randAlphaNum 48, app=n8n only) and
             deep-merges the SAME value into both mcp_server.env.AUTH_TOKEN and
             proxy.bearer_token (Secret-only, never in these git values). Tenant isolation
             comes from the per-instance proxy path token, NOT AUTH_TOKEN, so a
             chart-generated value is security-equivalent to per-instance (per-instance
             pod + loopback bind; sub-agent architecture review 2026-07-01) — the original
             operator per-instance Secret (task #12) was over-engineering and was dropped.
             Validated layer-3 on stg: operator -> chart 0.1.4 -> pod Running, subprocess
             (n8n-mcp-http) bound 127.0.0.1:3000, AUTH_TOKEN fan-out both places equal
             (len 48), healthz/GUI + CF tunnel 200. Internal transport=/mcp (O-6 實測). -->
        <record id="cloud_app_mcp_n8n" model="woow_paas_platform.cloud_app_template">
            <field name="name">n8n MCP Server</field>
            <field name="slug">mcp-n8n</field>
            <field name="description">n8n MCP server with admin GUI</field>
            <field name="full_description">n8n MCP server — a managed Model Context
                Protocol server with an admin GUI and an MCP client endpoint, persisting
                its configuration on a dedicated volume.</field>
            <field name="category">mcp</field>
            <field name="tags">["mcp", "n8n", "mcp-server", "ai"]</field>

            <!-- Helm Configuration (OCI; shared mcp-server chart 0.1.5, values 切 app).
                 0.1.4 self-generates config.authToken (randAlphaNum, app=n8n only) so n8n
                 needs no externally-supplied token (replaces the dropped operator
                 per-instance Secret). envPrefix MUST be camelCase + empty string for n8n
                 (design 階段1 守線). image tag = real launcher sha 2ef1dc16 (PR #6, CI run
                 741) containing the n8n-mcp-http launcher (GAP-N1). config.nonSensitive.
                 mcp_server overrides the chart's hermes default (transport=/mcp
                 StreamableHTTP, internal port 3000). The sensitive AUTH_TOKEN is NOT here:
                 mandatory for n8n-mcp http mode, the chart self-generates it and
                 deep-merges the same value into mcp_server.env.AUTH_TOKEN +
                 proxy.bearer_token (Secret-only). -->
            <field name="helm_repo_url"></field>
            <field name="helm_chart_name">oci://jcr-prod.woowtech.io/woow-paas-docker-local/mcp-server</field>
            <field name="helm_chart_version">0.1.5</field>
            <field name="helm_default_values">{"app": "n8n", "image": {"repository": "jcr-prod.woowtech.io/woow-paas-docker-local/n8n-mcp-admin", "tag": "05ffbe7fa5954cb37d4181069f3a76d97c3864b9@sha256:c85a4234eec1a280dced549291121f33ae2147ff8960a0751ed05d9dd32a3218"}, "service": {"port": 8080}, "envPrefix": "", "persistence": {"enabled": true, "size": "2Gi"}, "updateStrategy": {"type": "Recreate"}, "config": {"nonSensitive": {"mcp_server": {"command": "n8n-mcp-http", "args": ["--port", "3000"], "port": 3000, "env_prefix": ""}, "proxy": {"timeout": 86400}}}}</field>
            <field name="helm_value_specs">{"required": [], "optional": []}</field>

            <!-- Service Configuration -->
            <field name="default_port">8080</field>
            <field name="ingress_enabled" eval="True" />

            <!-- Resource Requirements -->
            <field name="min_vcpu">1</field>
            <field name="min_ram_gb">1.0</field>
            <field name="min_storage_gb">5</field>

            <!-- MCP capability is built into the service body; NO sidecar -->
            <field name="mcp_enabled" eval="False" />
            <field name="post_deploy_init_type">none</field>

            <field name="is_active" eval="True" />
        </record>

        <!-- Healer: DBs first installed under the historical <data noupdate="1"> block
             carry a sticky ir.model.data.noupdate flag on these seeds, so the corrected
             helm_value_specs above is silently skipped on -u. <function> runs on every
             -u regardless of noupdate; it clears the flag and repairs any dirty specs
             in place so the DB converges to the fixed seed. See fix/n8n-creation-issue
             and docs/tracking/pitfalls/seed-noupdate-sticky-template-links.md. -->
        <function model="woow_paas_platform.cloud_app_template"
                  name="_heal_sticky_helm_value_specs"/>
    </data>
</odoo>
