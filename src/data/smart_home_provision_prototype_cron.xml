<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Prototype must never start remote work merely by installing/upgrading. -->
    <record id="cron_shc_durable_provision_prototype" model="ir.cron">
        <field name="name">Smart Home durable provision prototype (disabled)</field>
        <field name="model_id" ref="model_woow_paas_platform_smart_home_provision_operation"/>
        <field name="state">code</field>
        <field name="code">model._cron_process()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
