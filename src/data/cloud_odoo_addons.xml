<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- Built-in Odoo addons (no initContainer copy needed) -->
        <record id="cloud_odoo_addon_base_setup" model="woow_paas_platform.cloud_odoo_addon">
            <field name="name">Base Setup</field>
            <field name="technical_name">base_setup</field>
            <field name="description">Base configuration module</field>
            <field name="category">other</field>
            <field name="icon">settings</field>
            <field name="source_type">built_in</field>
        </record>

        <record id="cloud_odoo_addon_sale_management" model="woow_paas_platform.cloud_odoo_addon">
            <field name="name">Sales</field>
            <field name="technical_name">sale_management</field>
            <field name="description">Manage your sales pipeline and quotations</field>
            <field name="category">sales</field>
            <field name="icon">point_of_sale</field>
            <field name="source_type">built_in</field>
            <field name="depends_on" eval="[(4, ref('cloud_odoo_addon_base_setup'))]"/>
        </record>

        <!-- Third-party addons (requires initContainer copy from /all-addons/) -->
        <record id="cloud_odoo_addon_sh_subscription" model="woow_paas_platform.cloud_odoo_addon">
            <field name="name">Subscription Management</field>
            <field name="technical_name">sh_subscription</field>
            <field name="description">Subscription plans with daily, weekly, monthly and yearly billing cycles. Customer portal, automated reminders, and detailed reporting.</field>
            <field name="category">subscription</field>
            <field name="icon">autorenew</field>
            <field name="source_type">third_party</field>
            <field name="depends_on" eval="[(4, ref('cloud_odoo_addon_base_setup')), (4, ref('cloud_odoo_addon_sale_management'))]"/>
        </record>

    </data>
</odoo>
