<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- #1540：停權／刪除後的限時唯讀資料取回入口。每 15 分鐘關掉到期的入口、重試只剩
             hostname 沒刪成的（closing）、請 operator sweep 收掉平台漏掉的、刪過了保留期的帳本列。
             入口的 pod 另有 activeDeadlineSeconds，這支 cron 沒跑時資料也會準時停止對外。 -->
        <record id="ir_cron_data_retrieval_maintenance" model="ir.cron">
            <field name="name">PaaS: Close Expired Data Retrieval Links</field>
            <field name="model_id" ref="model_woow_paas_platform_data_retrieval"/>
            <field name="state">code</field>
            <field name="code">model._cron_close_expired()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
