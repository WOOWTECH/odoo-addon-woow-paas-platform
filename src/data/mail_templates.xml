<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_low_balance" model="mail.template">
            <field name="name">PaaS: Low Wallet Balance Notification</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">Action needed: Please top up your wallet</field>
            <field name="email_from">{{ object.company_id.email_formatted or user.company_id.email_formatted }}</field>
            <field name="email_to">{{ object.email }}</field>
            <!-- AUDITFIX dunning-mail-english：依收件人語言渲染（zh_TW 譯文在 i18n/zh_TW.po）。
                 本檔是 noupdate，既有 DB 由 billing_mail_lang_sync.xml 補上這個欄位。 -->
            <field name="lang">{{ object.lang }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; max-width: 600px;">
                    <p>Hi <t t-out="object.name"/>,</p>
                    <p>
                        Your subscription invoice
                        <strong t-out="ctx.get('invoice_name', '')"/>
                        of
                        <strong t-out="ctx.get('amount_text', '')"/>
                        could not be paid because your wallet balance is insufficient.
                    </p>
                    <p>Current wallet balance: <strong t-out="ctx.get('balance_text', '')"/></p>
                    <p>
                        Please top up your wallet to keep your service active.
                        You have a grace period before the service is suspended.
                    </p>
                    <p>
                        <a t-att-href="ctx.get('topup_url', '#')"
                           style="display:inline-block;background:#6366f1;color:#ffffff;padding:10px 16px;text-decoration:none;border-radius:6px;font-weight:600;">
                            Top up now
                        </a>
                    </p>
                    <p style="color:#6b7280;font-size:12px;">
                        Thank you for using WoowTech PaaS.
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="mail_template_subscription_cancelled" model="mail.template">
            <field name="name">PaaS: Subscription Auto-Cancelled (Repeated Payment Failures)</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">[Woow PaaS] Your subscription has been cancelled</field>
            <field name="email_from">{{ object.company_id.email_formatted or user.company_id.email_formatted }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="lang">{{ object.lang }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; max-width: 600px;">
                    <p>Hi <t t-out="object.name"/>,</p>
                    <p>
                        Your subscription
                        <strong t-out="ctx.get('plan_name', '')"/>
                        (<t t-out="ctx.get('subscription_name', '')"/>)
                        has been <strong>auto-cancelled</strong> after
                        <t t-out="ctx.get('failures', '')"/> consecutive
                        payment failures on the outstanding invoice
                        <strong t-out="ctx.get('invoice_name', '')"/>
                        (<t t-out="ctx.get('amount_text', '')"/>).
                    </p>
                    <p>
                        Your associated services have been suspended. Your
                        data will be preserved for
                        <strong><t t-out="ctx.get('preservation_months', 6)"/> months</strong>;
                        starting a fresh subscription within that window may
                        re-attach to your existing storage.
                    </p>
                    <p>
                        To resume service, please subscribe again from the
                        Woow PaaS marketplace.
                    </p>
                    <p style="color:#6b7280;font-size:12px;">
                        If this cancellation is unexpected, contact support.
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- #1424：服務開通後從沒正常運作過（一直停在 error），扣款排程暫停扣它的訂閱，並提醒
             租戶一次（去重：sh.subscription.subscription.woow_billing_hold_notified_at）。
             `lang` 讓信件依收件人語言渲染（zh_TW 翻譯在 i18n/zh_TW.po）。
             auto_delete=False：留下載體，維運才查得到這封有沒有送出去。 -->
        <record id="mail_template_billing_hold_never_running" model="mail.template">
            <field name="name">PaaS: Billing Paused for a Service That Never Worked</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">[Woow PaaS] A service that never started will not be charged</field>
            <field name="email_from">{{ object.company_id.email_formatted or user.company_id.email_formatted }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="lang">{{ object.lang }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; max-width: 600px;">
                    <p>Hi <t t-out="object.name"/>,</p>
                    <p>
                        Your service <strong t-out="ctx.get('service_name', '')"/>
                        (<t t-out="ctx.get('plan_name', '')"/>) has not worked since it was
                        created: its deployment did not complete and it is still in an error state.
                    </p>
                    <p>
                        We are <strong>not charging</strong> its subscription while it stays like
                        this. The payment that was due on
                        <strong t-out="ctx.get('due_date', '')"/> has been put on hold.
                    </p>
                    <p>
                        Please delete this service and deploy it again, or contact support if you
                        would like us to look into it. If the service recovers and starts working,
                        billing resumes: the next payment is taken then, and a new billing period
                        starts on that day.
                    </p>
                    <p>
                        <a t-att-href="ctx.get('service_url', '#')"
                           style="display:inline-block;background:#6366f1;color:#ffffff;padding:10px 16px;text-decoration:none;border-radius:6px;font-weight:600;">
                            Open the service
                        </a>
                    </p>
                    <p style="color:#6b7280;font-size:12px;">
                        This notice is sent only once for this service.
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>

        <!-- AUDITFIX payment-mail-wrong-date／dunning-mail-english：平台訂閱（never-expire 方案）的
             狀態通知（開通、付款成功、續訂、取消、結束）。取代上游
             sh_subscription.sh_subscription_customer_email 在平台訂閱上的用途
             （sh_subscription_fix._sh_send_subscription_email 依 sh_never_expire 分流）：
             上游那封沒有 lang（zh_TW 租戶收到英文），而且寫「Your plan will expire on
             sh_end_date」——平台訂閱的 sh_end_date 是第一期最後一天、續期不推進（#1574），
             付款成功信因此寫著過去的日期。這封改寫「下次扣款日」（sh_date_of_next_payment），
             不提到期日。主旨的狀態句由 Python 依收件人語言產生（ctx status_title）。 -->
        <record id="mail_template_subscription_status" model="mail.template">
            <field name="name">PaaS: Subscription Status (Activated / Paid / Cancelled)</field>
            <field name="model_id" ref="sh_subscription.model_sh_subscription_subscription"/>
            <field name="subject">[Woow PaaS] {{ ctx.get('status_title') or object.name }} ({{ object.name }})</field>
            <field name="email_from">{{ object.sh_company_id.partner_id.email_formatted or user.company_id.email_formatted }}</field>
            <field name="partner_to">{{ object.sh_partner_id.id }}</field>
            <field name="lang">{{ object.sh_partner_id.lang }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; max-width: 600px;">
                    <p>Hi <t t-out="object.sh_partner_id.name"/>,</p>
                    <p t-if="object.state == 'in_progress' and object.sh_renewed">
                        Your subscription <strong t-out="object.name"/>
                        (<t t-out="object.sh_subscription_plan_id.name or ''"/>) has been renewed.
                    </p>
                    <p t-elif="object.state == 'in_progress'">
                        Your subscription <strong t-out="object.name"/>
                        (<t t-out="object.sh_subscription_plan_id.name or ''"/>) is active.
                    </p>
                    <p t-elif="object.state == 'cancel'">
                        Your subscription <strong t-out="object.name"/>
                        (<t t-out="object.sh_subscription_plan_id.name or ''"/>) has been cancelled.
                    </p>
                    <p t-elif="object.state in ('close', 'expire', 'renewed')">
                        Your subscription <strong t-out="object.name"/>
                        (<t t-out="object.sh_subscription_plan_id.name or ''"/>) has ended.
                    </p>
                    <p t-if="object.state == 'in_progress' and ctx.get('trial_end_date')">
                        Your free trial runs until <strong t-out="format_date(ctx.get('trial_end_date'))"/>.
                        The first charge is on <strong t-out="format_date(object.sh_date_of_next_payment)"/>.
                    </p>
                    <p t-elif="object.state == 'in_progress' and object.sh_date_of_next_payment">
                        Your next charge is on <strong t-out="format_date(object.sh_date_of_next_payment)"/>.
                        The subscription renews automatically until you cancel it.
                    </p>
                    <p t-if="ctx.get('has_invoice')">
                        The invoice for this payment is attached.
                    </p>
                    <p style="color:#6b7280;font-size:12px;">
                        If you have any questions, please contact support. Thank you for using
                        WoowTech PaaS.
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>
    </data>
</odoo>
