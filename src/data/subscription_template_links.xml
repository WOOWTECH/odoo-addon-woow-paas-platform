<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- noupdate=0: keep links current on module upgrade -->
    <data noupdate="0">

        <!-- Link cloud_app_templates to their subscription plans -->

        <record id="cloud_app_n8n" model="woow_paas_platform.cloud_app_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_n8n_monthly'), ref('plan_n8n_yearly'),
                                  ref('plan_n8n_t2_monthly'), ref('plan_n8n_t2_yearly'),
                                  ref('plan_n8n_t3_monthly'), ref('plan_n8n_t3_yearly'),
                                  ref('plan_n8n_t4_monthly'), ref('plan_n8n_t4_yearly')])]"/>
        </record>

        <record id="cloud_app_postgresql" model="woow_paas_platform.cloud_app_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_postgresql_monthly'), ref('plan_postgresql_yearly')])]"/>
        </record>

        <record id="cloud_app_odoo" model="woow_paas_platform.cloud_app_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_odoo_monthly'), ref('plan_odoo_yearly'),
                                  ref('plan_odoo_t2_monthly'), ref('plan_odoo_t2_yearly'),
                                  ref('plan_odoo_t3_monthly'), ref('plan_odoo_t3_yearly')])]"/>
        </record>

        <!-- #765 起本 family 有隨 tier 放大的加購變體（T1 1–3／T2 1–6／T3 1–10 席），
             其 (4,) append 在 subscription_template_links_variants.xml（generator 產物）。
             ⚠ 勿與 cloud_app_hermes_agent（Hermes Agent 完整應用）互掛，變體側亦然。 -->
        <record id="cloud_app_mcp_hermes" model="woow_paas_platform.cloud_app_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_mcp_hermes_monthly'), ref('plan_mcp_hermes_yearly'),
                                  ref('plan_mcp_hermes_t2_monthly'), ref('plan_mcp_hermes_t2_yearly'),
                                  ref('plan_mcp_hermes_t3_monthly'), ref('plan_mcp_hermes_t3_yearly')])]"/>
        </record>

        <record id="cloud_app_mcp_odoo" model="woow_paas_platform.cloud_app_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_mcp_odoo_monthly'), ref('plan_mcp_odoo_yearly')])]"/>
        </record>

        <record id="cloud_app_mcp_n8n" model="woow_paas_platform.cloud_app_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_mcp_n8n_monthly'), ref('plan_mcp_n8n_yearly')])]"/>
        </record>

        <!-- #338：Odoo Manage MCP template ↔ 兩 plan（3000/24000） -->
        <record id="cloud_app_mcp_odoo_manage" model="woow_paas_platform.cloud_app_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_mcp_odoo_manage_monthly'), ref('plan_mcp_odoo_manage_yearly')])]"/>
        </record>

        <!-- #375：MCP admin 三型 template ↔ 各兩 base plan（3000/24000）。變體 M2M
             由 subscription_template_links_variants.xml 以 (4,) append。 -->
        <record id="cloud_app_mcp_k8s" model="woow_paas_platform.cloud_app_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_mcp_k8s_monthly'), ref('plan_mcp_k8s_yearly')])]"/>
        </record>

        <record id="cloud_app_mcp_vk" model="woow_paas_platform.cloud_app_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_mcp_vk_monthly'), ref('plan_mcp_vk_yearly')])]"/>
        </record>

        <record id="cloud_app_mcp_opendesign" model="woow_paas_platform.cloud_app_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_mcp_opendesign_monthly'), ref('plan_mcp_opendesign_yearly')])]"/>
        </record>

        <!-- #380：Open Design 完整應用 template ↔ 兩 base plan（4500/36000）。變體 M2M
             由 subscription_template_links_variants.xml 以 (4,) append（noupdate=0 鐵律）。 -->
        <record id="cloud_app_opendesign" model="woow_paas_platform.cloud_app_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_opendesign_monthly'), ref('plan_opendesign_yearly')])]"/>
        </record>

        <!-- #423 W5b：Home Assistant OS（VM 型）template ↔ 兩 base plan（4500/36000）。
             v1 不做加購變體，故本 family 在 subscription_template_links_variants.xml
             沒有對應的 (4,) append。本檔 <data noupdate="0"> ＋ (6, 0, [...]) 全量 reset
             ＝ 每次 -u 都把 DB 的 M2M 重寫成檔案內容（變體 links 必 noupdate=0 鐵律）。 -->
        <record id="cloud_app_haos" model="woow_paas_platform.cloud_app_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_haos_monthly'), ref('plan_haos_yearly')])]"/>
        </record>

        <!-- #661：Home Assistant 完整版（容器型，完整整合集）template ↔ 兩 base plan
             （3000/24000）。#765 起本 family **有** 1–3 席的加購變體，其 (4,) append
             在 subscription_template_links_variants.xml（generator 產物）。
             本檔 <data noupdate="0"> ＋ (6, 0, [...]) 全量 reset
             ＝ 每次 -u 都把 DB 的 M2M 重寫成檔案內容（links 必 noupdate=0 鐵律，見
             docs/tracking/pitfalls/seed-noupdate-sticky-template-links.md）⇒ 既有 DB
             直接生效、無需 migration。
             ⚠ 勿與 cloud_app_ha_paas（免費精簡版，plan 刻意 orphan、見下方註解）或
             cloud_app_haos（VM 型 HAOS，4500/36000）互掛：三者是不同產品。 -->
        <record id="cloud_app_ha_full" model="woow_paas_platform.cloud_app_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_ha_full_monthly'),
                                  ref('plan_ha_full_yearly')])]"/>
        </record>
        <!-- APPORO 線與 ha-full 共用同一組 plan（同價、同規格；卡片本身 is_hidden）。 -->
        <record id="cloud_app_ha_full_apporo" model="woow_paas_platform.cloud_app_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_ha_full_monthly'),
                                  ref('plan_ha_full_yearly')])]"/>
        </record>

        <!-- #494：Hermes Agent 完整應用 template ↔ 兩 base plan（4500/36000）。
             #424① 上架時定價未拍板、刻意不掛 plan；拍板後比照 #431 解封（翻
             is_hidden ＋掛 plan），本檔 noupdate=0 ＋ (6, 0, [...]) 全量 reset ⇒
             -u 直接生效、無需 migration。#765 起本 family **有** 固定 1 席的加購
             變體，其 (4,) append 在 subscription_template_links_variants.xml。
             ⚠ 勿與 cloud_app_mcp_hermes（Hermes MCP Server，上面那筆六 plan）
             互掛：兩者是不同產品——**變體側同樣不得互掛**
             （plan_hermes_agent_ac* 只掛本筆、plan_mcp_hermes*_ac* 只掛那筆；
             檔案層守線在 scripts/seed/test_generate_plan_variants.py 的
             test_hermes_families_never_cross_mount）。 -->
        <record id="cloud_app_hermes_agent" model="woow_paas_platform.cloud_app_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_hermes_agent_monthly'),
                                  ref('plan_hermes_agent_yearly')])]"/>
        </record>
        <record id="cloud_app_pi_agent" model="woow_paas_platform.cloud_app_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_pi_agent_monthly'), ref('plan_pi_agent_yearly')])]"/>
        </record>
        <record id="cloud_app_omnigent" model="woow_paas_platform.cloud_app_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_omnigent_monthly'), ref('plan_omnigent_yearly')])]"/>
        </record>
        <record id="cloud_app_code_server" model="woow_paas_platform.cloud_app_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_code_server_monthly'), ref('plan_code_server_yearly')])]"/>
        </record>

        <record id="cloud_app_emqx" model="woow_paas_platform.cloud_app_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_emqx_monthly'), ref('plan_emqx_yearly')])]"/>
        </record>
        <record id="cloud_app_nextcloud" model="woow_paas_platform.cloud_app_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_nextcloud_monthly'), ref('plan_nextcloud_yearly')])]"/>
        </record>

        <!-- Headscale／Tailscale／LiteLLM：2026-10-04 以隱藏範本＋方案先掛好進 seed（沒掛 plan 會被 _create_service 擋），同日公開上架。 -->
        <record id="cloud_app_headscale" model="woow_paas_platform.cloud_app_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_headscale_monthly'), ref('plan_headscale_yearly')])]"/>
        </record>
        <record id="cloud_app_tailscale" model="woow_paas_platform.cloud_app_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_tailscale_monthly'), ref('plan_tailscale_yearly')])]"/>
        </record>
        <record id="cloud_app_litellm" model="woow_paas_platform.cloud_app_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_litellm_monthly'), ref('plan_litellm_yearly')])]"/>
        </record>

        <!-- MCP：AI 模型閘道（mcp-litellm）：2026-10-05 以隱藏範本＋方案先掛好進 seed（沒掛 plan 會被 _create_service 擋），10-07 公開上架。 -->
        <record id="cloud_app_mcp_litellm" model="woow_paas_platform.cloud_app_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_mcp_litellm_monthly'), ref('plan_mcp_litellm_yearly')])]"/>
        </record>

        <!-- #341（Wave A）撞車收斂：HA PaaS plan（plan_ha_paas_monthly）刻意 orphan——
             不掛任何 template M2M（Wave A test_orphan_no_template_links 斷言 M2M=0，且
             storefront_hidden 已在 plan 層擋前台）。provision 端點直接把 plan ref 傳給
             _create_and_confirm_subscription 建 sub，不經 template↔plan M2M，故本 PR 原有的
             cloud_app_ha_paas ↔ plan M2M link 已移除。cloud_app_ha_paas template 本身仍由
             cloud_app_templates.xml 定義（is_hidden=True／is_active=False）。 -->

        <!-- AnythingLLM template does not exist yet; plans will be linked when created -->

        <!-- Link smart_home_template to its subscription plans -->

        <record id="smart_home_home_assistant" model="woow_paas_platform.smart_home_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_smarthome_monthly'), ref('plan_smarthome_yearly'),
                                  ref('plan_smarthome_mcp_monthly'), ref('plan_smarthome_mcp_yearly')])]"/>
        </record>

        <!-- Link security_access_template to its subscription plans -->
        <record id="security_access_default" model="woow_paas_platform.security_access_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_security_access_r1_monthly'),
                                  ref('plan_security_access_r1_yearly'),
                                  ref('plan_security_access_r3_monthly'),
                                  ref('plan_security_access_r3_yearly'),
                                  ref('plan_security_access_entry_monthly'),
                                  ref('plan_security_access_entry_yearly'),
                                  ref('plan_security_access_pro_monthly'),
                                  ref('plan_security_access_pro_yearly')])]"/>
        </record>

        <!-- Healer for upgraded DBs where security_access_default was created
             under the historical noupdate=1 seed: the sticky ir.model.data
             flag makes -u skip the record above, leaving the template
             plan-less. function elements run on every -u regardless of
             noupdate; the method flips the flag and back-fills the default
             plans only when none are linked (admin-curated lists untouched). -->
        <function model="woow_paas_platform.security_access_template"
                  name="_ensure_default_template_links"/>

    </data>
</odoo>
