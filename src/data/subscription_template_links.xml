<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- noupdate=0: keep links current on module upgrade -->
    <data noupdate="0">

        <!-- Link cloud_app_templates to their subscription plans -->

        <record id="cloud_app_n8n" model="woow_paas_platform.cloud_app_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_n8n_monthly'), ref('plan_n8n_yearly'),
                                  ref('plan_n8n_t2_monthly'), ref('plan_n8n_t2_yearly'),
                                  ref('plan_n8n_t3_monthly'), ref('plan_n8n_t3_yearly'),
                                  ref('plan_n8n_t4_monthly'), ref('plan_n8n_t4_yearly')])]"/>
        </record>

        <record id="cloud_app_postgresql" model="woow_paas_platform.cloud_app_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_postgresql_monthly'), ref('plan_postgresql_yearly')])]"/>
        </record>

        <record id="cloud_app_odoo" model="woow_paas_platform.cloud_app_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_odoo_monthly'), ref('plan_odoo_yearly'),
                                  ref('plan_odoo_t2_monthly'), ref('plan_odoo_t2_yearly'),
                                  ref('plan_odoo_t3_monthly'), ref('plan_odoo_t3_yearly')])]"/>
        </record>

        <record id="cloud_app_mcp_hermes" model="woow_paas_platform.cloud_app_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_mcp_hermes_monthly'), ref('plan_mcp_hermes_yearly'),
                                  ref('plan_mcp_hermes_t2_monthly'), ref('plan_mcp_hermes_t2_yearly'),
                                  ref('plan_mcp_hermes_t3_monthly'), ref('plan_mcp_hermes_t3_yearly')])]"/>
        </record>

        <record id="cloud_app_mcp_odoo" model="woow_paas_platform.cloud_app_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_mcp_odoo_monthly'), ref('plan_mcp_odoo_yearly')])]"/>
        </record>

        <record id="cloud_app_mcp_n8n" model="woow_paas_platform.cloud_app_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_mcp_n8n_monthly'), ref('plan_mcp_n8n_yearly')])]"/>
        </record>

        <!-- #338：Odoo Manage MCP template ↔ 兩 plan（3000/24000） -->
        <record id="cloud_app_mcp_odoo_manage" model="woow_paas_platform.cloud_app_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_mcp_odoo_manage_monthly'), ref('plan_mcp_odoo_manage_yearly')])]"/>
        </record>

        <!-- #375：MCP admin 三型 template ↔ 各兩 base plan（3000/24000）。變體 M2M
             由 subscription_template_links_variants.xml 以 (4,) append。 -->
        <record id="cloud_app_mcp_k8s" model="woow_paas_platform.cloud_app_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_mcp_k8s_monthly'), ref('plan_mcp_k8s_yearly')])]"/>
        </record>

        <record id="cloud_app_mcp_vk" model="woow_paas_platform.cloud_app_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_mcp_vk_monthly'), ref('plan_mcp_vk_yearly')])]"/>
        </record>

        <record id="cloud_app_mcp_opendesign" model="woow_paas_platform.cloud_app_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_mcp_opendesign_monthly'), ref('plan_mcp_opendesign_yearly')])]"/>
        </record>

        <!-- #341（Wave A）撞車收斂：HA PaaS plan（plan_ha_paas_monthly）刻意 orphan——
             不掛任何 template M2M（Wave A test_orphan_no_template_links 斷言 M2M=0，且
             storefront_hidden 已在 plan 層擋前台）。provision 端點直接把 plan ref 傳給
             _create_and_confirm_subscription 建 sub，不經 template↔plan M2M，故本 PR 原有的
             cloud_app_ha_paas ↔ plan M2M link 已移除。cloud_app_ha_paas template 本身仍由
             cloud_app_templates.xml 定義（is_hidden=True／is_active=False）。 -->

        <!-- AnythingLLM template does not exist yet; plans will be linked when created -->

        <!-- Link smart_home_template to its subscription plans -->

        <record id="smart_home_home_assistant" model="woow_paas_platform.smart_home_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_smarthome_monthly'), ref('plan_smarthome_yearly'),
                                  ref('plan_smarthome_mcp_monthly'), ref('plan_smarthome_mcp_yearly')])]"/>
        </record>

        <!-- Link security_access_template to its subscription plans -->
        <record id="security_access_default" model="woow_paas_platform.security_access_template">
            <field name="subscription_plan_ids"
                   eval="[(6, 0, [ref('plan_security_access_r1_monthly'),
                                  ref('plan_security_access_r1_yearly'),
                                  ref('plan_security_access_r3_monthly'),
                                  ref('plan_security_access_r3_yearly'),
                                  ref('plan_security_access_entry_monthly'),
                                  ref('plan_security_access_entry_yearly'),
                                  ref('plan_security_access_pro_monthly'),
                                  ref('plan_security_access_pro_yearly')])]"/>
        </record>

        <!-- Healer for upgraded DBs where security_access_default was created
             under the historical noupdate=1 seed: the sticky ir.model.data
             flag makes -u skip the record above, leaving the template
             plan-less. function elements run on every -u regardless of
             noupdate; the method flips the flag and back-fills the default
             plans only when none are linked (admin-curated lists untouched). -->
        <function model="woow_paas_platform.security_access_template"
                  name="_ensure_default_template_links"/>

    </data>
</odoo>
