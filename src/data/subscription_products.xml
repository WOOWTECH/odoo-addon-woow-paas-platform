        <!-- ============================================================ -->
        <!--  Reminder Templates                                          -->
        <!-- ============================================================ -->

        <record id="reminder_3days_before" model="sh.reminder.template">
            <field name="sh_reminder">3</field>
            <field name="sh_reminder_unit">day(s)</field>
        </record>

        <record id="reminder_1day_before" model="sh.reminder.template">
            <field name="sh_reminder">1</field>
            <field name="sh_reminder_unit">day(s)</field>
        </record>

