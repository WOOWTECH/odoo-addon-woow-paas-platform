<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="0" (default): the <function> below re-executes on every
         module upgrade (-u), regardless of the noupdate flag on the seed
         record it touches. oauth_clients.xml is noupdate="1", so editing the
         seed's scopes only reaches *fresh* installs; existing databases
         (sandbox / stg / prod all run -u) never see the new scopes from XML.

         The merge logic lives on the oauth_client model
         (_ensure_ha_smart_home_sa_scopes) and is idempotent, so re-running it
         on every upgrade is safe. post_init_hook also calls it for the
         fresh-install path. Missing Security Access scopes on the HA public
         client break OAuth token refresh for the HA component (G-H3). -->
    <function
        model="woow_paas_platform.oauth_client"
        name="_ensure_ha_smart_home_sa_scopes"/>
</odoo>
