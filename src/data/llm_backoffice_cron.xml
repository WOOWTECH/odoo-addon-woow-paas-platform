        <record id="ir_cron_llm_manual_credit_monthly_report" model="ir.cron">
            <field name="name">AI Models: queue monthly manual credit report</field>
            <field name="model_id" ref="model_woow_paas_platform_llm_manual_credit_cron"/>
            <field name="state">code</field>
            <field name="code">model._cron_manual_credit_monthly_report()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
