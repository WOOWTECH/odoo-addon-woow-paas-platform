<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="woow_paas_platform.Root">
        <AppShell router="router">
            <t t-if="router.current === 'dashboard'">
                <DashboardPage/>
            </t>
            <t t-elif="router.current === 'workspaces'">
                <WorkspaceListPage/>
            </t>
            <t t-elif="router.current === 'workspace-invitation-accept'">
                <WorkspaceInvitationPage t-key="router.params.invitationRevision"/>
            </t>
            <t t-elif="router.current === 'workspace-detail'">
                <!-- #1647 t-key：同一個分頁把網址的工作區 id 換掉（貼上另一個工作區的網址、
                     上一頁／下一頁）時 route 沒變，元件會被沿用，而 WorkspaceDetailPage 只在
                     掛載時載入資料 ⇒ 標題與服務清單留著上一個工作區的，只有會跟著
                     workspaceId 重讀的配額面板換成新的。以 workspaceId 為 key，工作區一變就
                     整頁重新掛載。 -->
                <WorkspaceDetailPage t-key="workspaceId" workspaceId="workspaceId"/>
            </t>
            <t t-elif="router.current === 'workspace-team'">
                <WorkspaceTeamPage workspaceId="workspaceId"/>
            </t>
            <t t-elif="router.current === 'marketplace'">
                <AppMarketplacePage workspaceId="workspaceId"/>
            </t>
            <t t-elif="router.current === 'configure'">
                <AppConfigurationPage workspaceId="workspaceId" templateId="templateId"/>
            </t>
            <t t-elif="router.current === 'smarthome-detail'">
                <SmartHomeDetailPage t-key="workspaceId + ':' + homeId" workspaceId="workspaceId" homeId="homeId" initialTab="smartHomeTab"/>
            </t>
            <t t-elif="router.current === 'security-access-detail'">
                <SecurityAccessDetailPage workspaceId="workspaceId" saId="securityAccessId" tab="securityAccessTab"/>
            </t>
            <t t-elif="router.current === 'service-detail'">
                <ServiceDetailPage t-key="workspaceId + ':' + serviceId" workspaceId="workspaceId" serviceId="serviceId" initialTab="serviceTab"/>
            </t>
            <t t-elif="router.current === 'project-detail'">
                <ProjectDetailPage projectId="projectId"/>
            </t>
            <t t-elif="router.current === 'ai-projects' or router.current === 'ai-tasks' or router.current === 'ai-task-detail' or router.current === 'ai-chat' or router.current === 'ai-project-kanban'">
                <t t-if="router.current === 'ai-project-kanban'">
                    <ProjectKanbanPage projectId="projectId"/>
                </t>
                <t t-elif="router.current === 'ai-projects'">
                    <SupportProjectsPage/>
                </t>
                <t t-elif="router.current === 'ai-tasks'">
                    <SupportTasksPage/>
                </t>
                <t t-elif="router.current === 'ai-task-detail'">
                    <TaskDetailPage taskId="taskId"/>
                </t>
                <t t-elif="router.current === 'ai-chat'">
                    <AiChatPage conversationId="conversationId"/>
                </t>
            </t>
            <t t-elif="router.current === 'llm'">
                <!-- LLM-01c：子頁由網址決定（LlmPage 不另存 currentTab），切子頁不會重新掛載。 -->
                <LlmPage tab="llmTab"/>
            </t>
            <t t-elif="router.current === 'billing'">
                <BillingOverviewPage/>
            </t>
            <t t-elif="router.current === 'billing-topup'">
                <TopupStorePage/>
            </t>
            <t t-elif="router.current === 'billing-invoices'">
                <InvoiceListPage/>
            </t>
            <t t-elif="router.current === 'billing-invoice-detail'">
                <InvoiceDetailPage invoiceId="invoiceId"/>
            </t>
            <t t-elif="router.current === 'billing-subscriptions'">
                <SubscriptionListPage/>
            </t>
            <t t-elif="router.current === 'billing-transactions'">
                <TransactionListPage/>
            </t>
            <t t-elif="router.current === 'settings'">
                <SettingsPage/>
            </t>
            <t t-elif="router.current === 'settings-profile'">
                <ProfilePage/>
            </t>
            <t t-elif="router.current === 'settings-payment-methods'">
                <PaymentMethodsListPage/>
            </t>
            <t t-elif="router.current === 'settings-payment-methods-add'">
                <AddPaymentMethodPage/>
            </t>
            <t t-elif="router.current === 'reconcile-report'">
                <ReconcileReportPage/>
            </t>
            <t t-elif="router.current === 'not-found'">
                <NotFoundPage/>
            </t>
            <t t-else="">
                <EmptyState/>
            </t>
        </AppShell>
    </t>
</templates>
