<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="woow_paas_platform.Root">
        <AppShell router="router">
            <t t-if="router.current === 'dashboard'">
                <DashboardPage/>
            </t>
            <t t-elif="router.current === 'workspaces'">
                <WorkspaceListPage/>
            </t>
            <t t-elif="router.current === 'workspace-detail'">
                <WorkspaceDetailPage workspaceId="workspaceId"/>
            </t>
            <t t-elif="router.current === 'workspace-team'">
                <WorkspaceTeamPage workspaceId="workspaceId"/>
            </t>
            <t t-elif="router.current === 'marketplace'">
                <AppMarketplacePage workspaceId="workspaceId"/>
            </t>
            <t t-elif="router.current === 'configure'">
                <AppConfigurationPage workspaceId="workspaceId" templateId="templateId"/>
            </t>
            <t t-elif="router.current === 'smarthome-detail'">
                <SmartHomeDetailPage workspaceId="workspaceId" homeId="homeId"/>
            </t>
            <t t-elif="router.current === 'service-detail'">
                <ServiceDetailPage workspaceId="workspaceId" serviceId="serviceId" initialTab="serviceTab"/>
            </t>
            <t t-elif="router.current === 'ai-assistant' or router.current === 'ai-projects' or router.current === 'ai-tasks' or router.current === 'ai-task-detail' or router.current === 'ai-chat' or router.current === 'ai-project-kanban'">
                <t t-if="router.current === 'ai-assistant'">
                    <AiAssistantPage/>
                </t>
                <t t-elif="router.current === 'ai-project-kanban'">
                    <ProjectKanbanPage projectId="projectId"/>
                </t>
                <t t-elif="router.current === 'ai-projects'">
                    <SupportProjectsPage/>
                </t>
                <t t-elif="router.current === 'ai-tasks'">
                    <SupportTasksPage/>
                </t>
                <t t-elif="router.current === 'ai-task-detail'">
                    <TaskDetailPage taskId="taskId"/>
                </t>
                <t t-elif="router.current === 'ai-chat'">
                    <AiChatPage conversationId="conversationId"/>
                </t>
            </t>
            <t t-elif="router.current === 'billing'">
                <BillingOverviewPage/>
            </t>
            <t t-elif="router.current === 'billing-topup'">
                <TopupStorePage/>
            </t>
            <t t-elif="router.current === 'billing-invoices'">
                <InvoiceListPage/>
            </t>
            <t t-elif="router.current === 'billing-invoice-detail'">
                <InvoiceDetailPage invoiceId="invoiceId"/>
            </t>
            <t t-elif="router.current === 'billing-subscriptions'">
                <SubscriptionListPage/>
            </t>
            <t t-elif="router.current === 'billing-transactions'">
                <TransactionListPage/>
            </t>
            <t t-elif="router.current === 'settings'">
                <SettingsPage/>
            </t>
            <t t-elif="router.current === 'settings-profile'">
                <ProfilePage/>
            </t>
            <t t-elif="router.current === 'settings-payment-methods'">
                <PaymentMethodsListPage/>
            </t>
            <t t-elif="router.current === 'settings-payment-methods-add'">
                <AddPaymentMethodPage/>
            </t>
            <t t-else="">
                <EmptyState/>
            </t>
        </AppShell>
    </t>
</templates>
