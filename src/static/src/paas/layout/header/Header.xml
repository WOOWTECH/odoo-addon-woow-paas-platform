<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="woow_paas_platform.Header">
        <header class="o_woow_header">
            <div class="o_woow_header_left">
                <button t-if="parentCrumb" type="button" class="o_woow_mobile_back"
                        t-att-aria-label="backLabel"
                        t-on-click="() => this.onBreadcrumbClick(parentCrumb.path)">
                    <span class="material-symbols-outlined" t-translation="off">arrow_back</span>
                </button>
                <div class="o_woow_mobile_logo">
                    <span class="material-symbols-outlined" t-translation="off">deployed_code</span>
                    <span>WoowTech</span>
                </div>
                <nav class="o_woow_breadcrumb" aria-label="breadcrumb">
                    <t t-foreach="breadcrumbItems" t-as="item" t-key="item_index">
                        <span t-if="item_index > 0" class="material-symbols-outlined o_woow_breadcrumb_sep" t-translation="off">chevron_right</span>
                        <span t-if="item.path"
                              class="o_woow_breadcrumb_item o_woow_breadcrumb_link"
                              t-on-click="() => this.onBreadcrumbClick(item.path)"
                              t-esc="item.label"/>
                        <span t-else=""
                              class="o_woow_breadcrumb_item active"
                              t-esc="item.label"/>
                    </t>
                </nav>
            </div>
            <div class="o_woow_header_actions">
                <!-- Credits 徽章 -->
                <div class="o_woow_credits_badge">
                    <span class="material-symbols-outlined" t-translation="off">payments</span>
                    <span class="o_woow_credits_label">CREDITS</span>
                    <span class="o_woow_credits_amount">
                        <t t-if="billingService.walletLoading">...</t>
                        <t t-else="" t-esc="formattedBalance"/>
                    </span>
                    <button class="o_woow_credits_add"
                            t-on-click="() => this.props.router.navigate('billing/topup')">
                        <span class="material-symbols-outlined" t-translation="off">add</span>
                    </button>
                </div>

                <!-- 通知（#1310：原本無 handler、紅點寫死） -->
                <div class="o_woow_notification_anchor">
                    <button type="button" class="o_woow_notification_btn"
                            t-att-aria-expanded="notifications.open ? 'true' : 'false'"
                            aria-haspopup="dialog"
                            t-att-aria-label="notificationLabel"
                            t-on-click="toggleNotifications">
                        <span class="material-symbols-outlined" t-translation="off">notifications</span>
                        <span t-if="notifications.unseenActionableCount" class="o_woow_notification_badge"/>
                    </button>
                    <NotificationPanel t-if="notifications.open" router="props.router"/>
                </div>

                <!-- 使用者資訊（#1310：改為帳號選單，手機也看得到） -->
                <div class="o_woow_account_anchor">
                    <button type="button" class="o_woow_user_header"
                            aria-haspopup="menu"
                            t-att-aria-expanded="state.accountOpen ? 'true' : 'false'"
                            aria-label="Account"
                            t-on-click="toggleAccount">
                        <div class="o_woow_user_text">
                            <span class="o_woow_user_name" t-esc="partnerName"/>
                        </div>
                        <div class="o_woow_avatar_header">
                            <img t-if="avatarUrl" t-att-src="avatarUrl" alt=""/>
                            <t t-else="" t-esc="initials"/>
                        </div>
                    </button>
                    <AccountMenu t-if="state.accountOpen" router="props.router" onClose.bind="closeAccount"/>
                </div>
            </div>
        </header>
    </t>
</templates>
