<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="woow_paas_platform.Sidebar">
        <aside class="o_woow_sidebar">
            <div class="o_woow_sidebar_header">
                <div class="o_woow_logo">
                    <img class="o_woow_site_logo" src="/woow_paas_platform/static/src/img/brands/woowtech-site-logo.jpg" alt="woowtech" draggable="false"/>
                </div>
            </div>
            <nav class="o_woow_sidebar_nav" aria-label="Primary navigation">
                <t t-foreach="navItems" t-as="item" t-key="item.section or item.path">
                    <t t-if="isSection(item)">
                        <div class="o_woow_nav_section">
                            <span><t t-esc="item.section"/></span>
                        </div>
                    </t>
                    <t t-elif="showItem(item)">
                        <a t-att-class="'o_woow_nav_item ' + (isActive(item) ? 'active' : '')"
                           t-att-href="'#/' + item.path"
                           t-att-aria-current="isActive(item) ? 'page' : false">
                            <span class="material-symbols-outlined"><t t-esc="item.icon"/></span>
                            <span><t t-esc="item.name"/></span>
                        </a>
                    </t>
                </t>
            </nav>
            <div class="o_woow_sidebar_footer">
                <a class="o_woow_nav_item" t-att-href="helpHref" target="_blank" rel="noopener">
                    <span class="material-symbols-outlined" t-translation="off">help</span>
                    <span>Help &amp; Support</span>
                </a>
                <a class="o_woow_nav_item o_woow_logout" href="/web/session/logout">
                    <span class="material-symbols-outlined" t-translation="off">logout</span>
                    <span>Log Out</span>
                </a>
            </div>
        </aside>
    </t>
</templates>
