<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="woow_paas_platform.PlanSelector">
    <div class="o_woow_plan_selector">
      <!-- 週期 toggle（R1：cycles<=1 不渲染） -->
      <div t-if="showCycleToggle" class="o_woow_plan_cycle_toggle">
        <button type="button"
                t-attf-class="o_woow_plan_cycle_toggle__opt {{ state.cycle === 'month' ? 'o_woow_plan_cycle_toggle__opt--active' : '' }}"
                t-on-click="() => this.onCycleToggle('month')">Monthly</button>
        <button type="button"
                t-attf-class="o_woow_plan_cycle_toggle__opt {{ state.cycle === 'year' ? 'o_woow_plan_cycle_toggle__opt--active' : '' }}"
                t-on-click="() => this.onCycleToggle('year')">Yearly · Save 33%</button>
      </div>

      <!-- 方案卡片：當前 cycle 每 tier 一張（R2：單 tier 自然一張，無需特判） -->
      <div class="o_woow_plan_selector__cards">
        <t t-foreach="visibleGroups" t-as="base" t-key="base.id">
          <div t-attf-class="o_woow_plan_card {{ isSelected(base) ? 'o_woow_plan_card--selected' : '' }}"
               t-on-click="() => this.onPlanClick(base)">
            <div class="o_woow_plan_card__name" t-esc="base.name"/>
            <div class="o_woow_plan_card__price" t-esc="formatPrice(base)"/>
            <div t-if="base.has_trial" class="o_woow_plan_card__trial" t-esc="formatTrial(base)"/>
            <!-- 規格（難題 9）：plan.specs 才渲染，service_type 無感 -->
            <div t-if="base.specs and base.specs.length" class="o_woow_plan_card__specs">
              <t t-foreach="base.specs" t-as="spec" t-key="spec_index">
                <span class="o_woow_plan_card__spec" t-esc="spec.label"/>
              </t>
            </div>
          </div>
        </t>
      </div>

      <!-- 席數第二步（R3：選中 base 有變體才顯示；{0,1} 降級 checkbox） -->
      <t t-set="seatBase" t-value="selectedBaseWithVariants()"/>
      <div t-if="seatBase" class="o_woow_plan_selector__seats">
        <t t-if="isSeatCheckbox(seatBase)">
          <!-- mcp 固定 1 席：降級為單一 checkbox -->
          <label class="o_woow_plan_seat_checkbox">
            <input type="checkbox"
                   t-att-checked="isSeatSelected(seatBase, seatBase.variants[0])"
                   t-on-change="() => this.onSeatCheckbox(seatBase)"/>
            <span>+1 access seat (<t t-esc="formatSeatDelta(seatBase, seatBase.variants[0])"/>)</span>
          </label>
        </t>
        <t t-else="">
          <div class="o_woow_plan_selector__label">AC Seats:</div>
          <div class="o_woow_plan_selector__seat_options">
            <!-- #773：裝不下目前用量的席位選項標一行警告（只標註、不 disable；
                 權威攔截在後端 gate，見 PlanSelector.js::isSeatOverCurrentUsage）。 -->
            <div t-attf-class="o_woow_plan_seat {{ isSeatSelected(seatBase, null) ? 'o_woow_plan_seat--selected' : '' }} {{ isSeatOverCurrentUsage(0) ? 'o_woow_plan_seat--over_usage' : '' }}"
                 t-on-click="() => this.onSeatSelect(seatBase, null)">
              <div class="o_woow_plan_seat__label">No extra seats</div>
              <div class="o_woow_plan_seat__delta">Included</div>
              <div t-if="isSeatOverCurrentUsage(0)" class="o_woow_plan_seat__over_usage"
                   t-esc="overUsageHint(0)"/>
            </div>
            <t t-foreach="seatBase.variants" t-as="variant" t-key="variant.plan_id">
              <div t-attf-class="o_woow_plan_seat {{ isSeatSelected(seatBase, variant) ? 'o_woow_plan_seat--selected' : '' }} {{ isSeatOverCurrentUsage(variant.seats) ? 'o_woow_plan_seat--over_usage' : '' }}"
                   t-on-click="() => this.onSeatSelect(seatBase, variant)">
                <div class="o_woow_plan_seat__label"><t t-esc="variant.seats"/> seat(s)</div>
                <div class="o_woow_plan_seat__delta" t-esc="formatSeatDelta(seatBase, variant)"/>
                <div t-if="isSeatOverCurrentUsage(variant.seats)" class="o_woow_plan_seat__over_usage"
                     t-esc="overUsageHint(variant.seats)"/>
              </div>
            </t>
          </div>
        </t>
      </div>

      <div t-if="!props.plans.length" class="o_woow_plan_selector__empty">
        No plans available
      </div>
    </div>
  </t>
</templates>
