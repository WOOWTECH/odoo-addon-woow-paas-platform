<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="woow_paas_platform.AdminCredentialsModal">
    <div class="o_woow_modal_backdrop" t-on-click="onBackdropClick">
      <div class="o_woow_modal">
        <div class="o_woow_modal_header">
          <h2>Admin Credentials</h2>
          <button class="o_woow_modal_close" t-on-click="props.onClose" t-att-disabled="loading">
            <WoowIcon name="'close'" size="20"/>
          </button>
        </div>

        <div class="o_woow_modal_body">
          <p>These credentials sign in to the app and to the web console. Saving restarts the service (about a minute).</p>

          <div class="o_woow_form_group">
            <label for="admin_credentials_username">Username</label>
            <input
              type="text"
              id="admin_credentials_username"
              class="o_woow_input"
              autocomplete="username"
              t-att-value="state.username"
              t-on-input="onUsernameInput"
              t-att-disabled="loading"
            />
          </div>

          <div class="o_woow_form_group">
            <label>Password</label>
            <div class="o_woow_role_options">
              <label class="o_woow_role_option" t-att-class="{'selected': state.passwordMode === 'generate'}">
                <input
                  type="radio"
                  name="admin_credentials_password_mode"
                  value="generate"
                  t-att-checked="state.passwordMode === 'generate'"
                  t-on-change="onPasswordModeChange"
                  t-att-disabled="loading"
                />
                <div class="o_woow_role_content">
                  <span class="o_woow_role_label">Generate a strong password</span>
                  <span class="o_woow_role_desc">Shown once after saving. Copy it before closing.</span>
                </div>
              </label>
              <label class="o_woow_role_option" t-att-class="{'selected': state.passwordMode === 'custom'}">
                <input
                  type="radio"
                  name="admin_credentials_password_mode"
                  value="custom"
                  t-att-checked="state.passwordMode === 'custom'"
                  t-on-change="onPasswordModeChange"
                  t-att-disabled="loading"
                />
                <div class="o_woow_role_content">
                  <span class="o_woow_role_label">Set my own password</span>
                  <span class="o_woow_role_desc">12-128 characters, no spaces.</span>
                </div>
              </label>
            </div>
          </div>

          <t t-if="state.passwordMode === 'custom'">
            <div class="o_woow_form_group">
              <label for="admin_credentials_password">New Password</label>
              <input
                type="password"
                id="admin_credentials_password"
                class="o_woow_input"
                autocomplete="new-password"
                t-att-value="state.password"
                t-on-input="onPasswordInput"
                t-att-disabled="loading"
              />
            </div>
            <div class="o_woow_form_group">
              <label for="admin_credentials_password_confirm">Confirm Password</label>
              <input
                type="password"
                id="admin_credentials_password_confirm"
                class="o_woow_input"
                autocomplete="new-password"
                t-att-value="state.passwordConfirm"
                t-on-input="onPasswordConfirmInput"
                t-att-disabled="loading"
              />
            </div>
          </t>

          <div t-if="state.error" class="o_woow_error_message">
            <WoowIcon name="'error'" size="16"/>
            <span t-esc="state.error"/>
          </div>
        </div>

        <div class="o_woow_modal_footer">
          <WoowButton variant="'ghost'" size="'md'" onClick="props.onClose" disabled="loading">
            Cancel
          </WoowButton>
          <WoowButton variant="'primary'" size="'md'" onClick.bind="onSubmit" disabled="loading">
            <t t-if="loading">
              <WoowIcon name="'sync'" size="16" class="'o_woow_spin'"/>
              Saving...
            </t>
            <t t-else="">
              <WoowIcon name="'key'" size="16"/>
              Save and Restart
            </t>
          </WoowButton>
        </div>
      </div>
    </div>
  </t>
</templates>
