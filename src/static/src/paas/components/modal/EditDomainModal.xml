<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="woow_paas_platform.EditDomainModal">
        <div class="o_woow_modal_backdrop" t-on-click="onBackdropClick">
            <div class="o_woow_modal o_woow_modal_domain" t-on-click.stop="">
                <div class="o_woow_modal_header">
                    <div>
                        <h2>Custom Domains</h2>
                        <p>Connect subdomains you control to this service.</p>
                    </div>
                    <button class="o_woow_modal_close" t-on-click="props.onClose" t-att-disabled="state.action">
                        <WoowIcon name="'close'" size="20"/>
                    </button>
                </div>

                <div class="o_woow_modal_body">
                    <div t-if="!state.capability.supported" class="o_woow_domain_notice o_woow_domain_notice--warning">
                        <WoowIcon name="'info'" size="18"/>
                        <span t-esc="state.capability.reason || 'Adding and checking domains is currently unavailable.'"/>
                    </div>

                    <div class="o_woow_domain_add">
                        <div class="o_woow_form_group">
                            <label for="custom_domain_hostname">Add a subdomain</label>
                            <div class="o_woow_domain_add__controls">
                                <input id="custom_domain_hostname" type="text" class="o_woow_input"
                                    placeholder="app.example.com" autocomplete="off"
                                    t-att-value="state.hostname" t-on-input="onHostnameInput"
                                    t-att-disabled="!state.capability.supported or state.action or atLimit"/>
                                <WoowButton variant="'primary'" size="'md'" onClick.bind="createDomain" disabled="!canCreate">
                                    <WoowIcon name="'add'" size="18"/>
                                    Add domain
                                </WoowButton>
                            </div>
                            <p t-if="atLimit" class="o_woow_form_hint">The domain limit for this service has been reached.</p>
                            <p t-elif="state.capability.max_domains" class="o_woow_form_hint">
                                <t t-esc="state.domains.filter((domain) => domain.state !== 'removed').length"/>
                                / <t t-esc="state.capability.max_domains"/> domains used
                            </p>
                        </div>
                    </div>

                    <div t-if="state.error" class="o_woow_error_message">
                        <WoowIcon name="'error'" size="16"/>
                        <span t-esc="state.error"/>
                    </div>

                    <div t-if="state.loading" class="o_woow_domain_loading">
                        <WoowIcon name="'sync'" size="20" class="'o_woow_spin'"/>
                        Loading domains…
                    </div>
                    <div t-elif="!state.domains.length" class="o_woow_domain_empty">
                        No custom domains have been added yet.
                    </div>
                    <div t-else="" class="o_woow_domain_list">
                        <article t-foreach="state.domains" t-as="domain" t-key="domain.id" class="o_woow_domain_card">
                            <div class="o_woow_domain_card__header">
                                <div>
                                    <strong t-esc="domain.hostname"/>
                                    <span t-att-class="'o_woow_domain_status o_woow_domain_status--' + status(domain.state).tone">
                                        <t t-esc="status(domain.state).label"/>
                                    </span>
                                </div>
                                <div class="o_woow_domain_card__actions">
                                    <WoowButton variant="'secondary'" size="'sm'"
                                        onClick="() => this.checkDomain(domain)"
                                        disabled="!state.capability.supported or state.action or ['removing', 'removed'].includes(domain.state)">
                                        <WoowIcon name="'refresh'" size="16"/>
                                        Check now
                                    </WoowButton>
                                    <WoowButton variant="'danger'" size="'sm'"
                                        onClick="() => this.removeDomain(domain)"
                                        disabled="state.action or ['removing', 'removed'].includes(domain.state)">
                                        <WoowIcon name="'delete'" size="16"/>
                                        Remove
                                    </WoowButton>
                                </div>
                            </div>

                            <p t-if="domain.last_error" class="o_woow_domain_last_error" t-esc="domain.last_error"/>
                            <div t-if="domain.dns_records and domain.dns_records.length" class="o_woow_dns_records">
                                <h3>DNS records</h3>
                                <p>Add verification records first. When the status says “Ready to switch DNS”, replace the existing website CNAME with the record marked “Switch traffic”. Some DNS providers ask for a relative Host/Name instead of the full name shown here.</p>
                                <div t-foreach="domain.dns_records" t-as="record" t-key="record_index" class="o_woow_dns_record">
                                    <span class="o_woow_dns_record__type">
                                        <t t-esc="record.type"/>
                                        <small t-esc="record.purpose === 'route' ? 'Switch' : 'Verify'"/>
                                    </span>
                                    <code class="o_woow_dns_record__name" t-esc="record.name"/>
                                    <code class="o_woow_dns_record__value" t-esc="record.value"/>
                                    <button type="button" class="o_woow_copy_btn"
                                        t-on-click="() => this.copyRecord(domain, record, record_index)"
                                        title="Copy DNS value">
                                        <WoowIcon name="'content_copy'" size="16"/>
                                        <span t-if="state.copied === domain.id + ':' + record_index">Copied</span>
                                    </button>
                                </div>
                            </div>
                        </article>
                    </div>
                </div>

                <div class="o_woow_modal_footer">
                    <WoowButton variant="'secondary'" size="'md'" onClick="props.onClose" disabled="state.action">
                        Close
                    </WoowButton>
                </div>
            </div>
        </div>
    </t>
</templates>
