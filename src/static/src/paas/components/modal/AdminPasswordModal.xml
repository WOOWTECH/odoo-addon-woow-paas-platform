<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="woow_paas_platform.AdminPasswordModal">
        <div class="o_woow_modal_backdrop" t-on-click="onBackdropClick">
            <div class="o_woow_modal o_woow_modal_sm" t-on-click.stop="">
                <div class="o_woow_modal_body">
                    <h2>Save your admin password</h2>
                    <p>
                        This password is shown only once. Save it before closing this dialog.
                    </p>
                    <div class="o_woow_input_with_suffix">
                        <input
                            class="o_woow_input o_woow_input_readonly"
                            type="text"
                            t-att-value="props.password"
                            readonly="readonly"/>
                        <WoowButton variant="'secondary'" size="'sm'" onClick.bind="copyPassword">
                            <WoowIcon name="'content_copy'" size="16"/>
                            <t t-if="state.copied">Copied</t>
                            <t t-else="">Copy</t>
                        </WoowButton>
                    </div>
                </div>
                <div class="o_woow_modal_footer">
                    <WoowButton variant="'primary'" size="'md'" onClick.bind="props.onClose">
                        Done
                    </WoowButton>
                </div>
            </div>
        </div>
    </t>
</templates>
