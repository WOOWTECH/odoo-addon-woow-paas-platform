<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="woow_paas_platform.CardAddedSuccessModal">
        <div class="o_woow_modal_backdrop" t-on-click="onBackdropClick">
            <div class="o_woow_modal o_woow_modal_sm" t-on-click.stop="">
                <div class="o_woow_modal_body o_woow_card_success_body">
                    <!-- Success Icon -->
                    <div class="o_woow_card_success_icon">
                        <WoowIcon name="'check_circle'" size="64"/>
                    </div>

                    <!-- Title -->
                    <h2 class="o_woow_card_success_title">Credit Card Added Successfully</h2>

                    <!-- Message -->
                    <p class="o_woow_card_success_message">
                        Your new <t t-esc="cardTypeLabel"/> <![CDATA[••••]]> <t t-esc="last4"/> has been
                        successfully added and set as your default payment method.
                    </p>
                </div>

                <div class="o_woow_modal_footer o_woow_card_success_footer">
                    <WoowButton
                        variant="'primary'"
                        size="'md'"
                        onClick="props.onClose">
                        Done
                    </WoowButton>
                </div>
            </div>
        </div>
    </t>
</templates>
