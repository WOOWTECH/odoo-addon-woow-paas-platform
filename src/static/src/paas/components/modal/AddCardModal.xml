<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="woow_paas_platform.AddCardModal">
        <div class="o_woow_modal_backdrop" t-on-click="onBackdropClick">
            <div class="o_woow_modal o_woow_modal_sm" t-on-click.stop="">
                <div class="o_woow_modal_header">
                    <h2>Add Credit Card</h2>
                    <button
                        class="o_woow_modal_close"
                        t-on-click="props.onClose"
                        t-att-disabled="state.saving">
                        <WoowIcon name="'close'" size="20"/>
                    </button>
                </div>

                <div class="o_woow_modal_body">
                    <!-- Card Brand Logos -->
                    <div class="o_woow_addcard_brands">
                        <span class="o_woow_addcard_brand_badge o_woow_addcard_brand_visa">VISA</span>
                        <span class="o_woow_addcard_brand_badge o_woow_addcard_brand_mc">MC</span>
                        <span class="o_woow_addcard_brand_badge o_woow_addcard_brand_amex">AMEX</span>
                    </div>

                    <!-- Card Number -->
                    <div class="o_woow_addcard_field">
                        <label class="o_woow_addcard_label">Card Number</label>
                        <div class="o_woow_addcard_input_wrapper">
                            <WoowIcon name="'lock'" size="16"/>
                            <input
                                type="text"
                                class="o_woow_addcard_input"
                                placeholder="1234 5678 9012 3456"
                                t-att-value="state.cardNumber"
                                t-on-input="onCardNumberInput"
                                t-att-disabled="state.saving"
                                maxlength="19"
                                autocomplete="cc-number"/>
                        </div>
                    </div>

                    <!-- Expiry + CVC (2-column) -->
                    <div class="o_woow_addcard_row">
                        <div class="o_woow_addcard_field">
                            <label class="o_woow_addcard_label">Expiry Date</label>
                            <input
                                type="text"
                                class="o_woow_addcard_input"
                                placeholder="MM/YY"
                                t-att-value="state.expiry"
                                t-on-input="onExpiryInput"
                                t-att-disabled="state.saving"
                                maxlength="5"
                                autocomplete="cc-exp"/>
                        </div>
                        <div class="o_woow_addcard_field">
                            <label class="o_woow_addcard_label">CVC</label>
                            <input
                                type="text"
                                class="o_woow_addcard_input"
                                placeholder="123"
                                t-att-value="state.cvc"
                                t-on-input="onCvcInput"
                                t-att-disabled="state.saving"
                                maxlength="4"
                                autocomplete="cc-csc"/>
                        </div>
                    </div>

                    <!-- Cardholder Name -->
                    <div class="o_woow_addcard_field">
                        <label class="o_woow_addcard_label">Cardholder Name</label>
                        <input
                            type="text"
                            class="o_woow_addcard_input"
                            placeholder="John Doe"
                            t-att-value="state.cardholderName"
                            t-on-input="onCardholderInput"
                            t-att-disabled="state.saving"
                            autocomplete="cc-name"/>
                    </div>

                    <!-- Set as default -->
                    <label class="o_woow_addcard_checkbox_row">
                        <input
                            type="checkbox"
                            t-att-checked="state.setDefault"
                            t-on-change="onSetDefaultChange"
                            t-att-disabled="state.saving"/>
                        <span>Set as default payment method</span>
                    </label>

                    <!-- Secured footer text -->
                    <div class="o_woow_addcard_secured">
                        <WoowIcon name="'verified_user'" size="14"/>
                        <span>Secured by WoowTech Payment Gateway</span>
                    </div>

                    <!-- Error -->
                    <div t-if="state.error" class="o_woow_error_message">
                        <WoowIcon name="'error'" size="16"/>
                        <span t-esc="state.error"/>
                    </div>
                </div>

                <div class="o_woow_modal_footer">
                    <WoowButton
                        variant="'secondary'"
                        size="'md'"
                        onClick="props.onClose"
                        disabled="state.saving">
                        Cancel
                    </WoowButton>
                    <WoowButton
                        variant="'primary'"
                        size="'md'"
                        onClick.bind="onSave"
                        disabled="!isFormValid or state.saving">
                        <t t-if="state.saving">
                            <WoowIcon name="'sync'" size="18" class="'o_woow_spin'"/>
                            Saving...
                        </t>
                        <t t-else="">
                            <WoowIcon name="'credit_card'" size="18"/>
                            Save Card
                        </t>
                    </WoowButton>
                </div>
            </div>
        </div>
    </t>
</templates>
