<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="woow_paas_platform.ChatGPTSubscriptionModal">
    <div class="o_woow_modal_backdrop" t-on-click="onBackdropClick">
      <div class="o_woow_modal o_woow_modal_md o_woow_chatgpt_modal" t-on-click.stop="">
        <div class="o_woow_modal_header">
          <h2 t-esc="title"/>
          <button class="o_woow_modal_close" t-on-click="close" t-att-disabled="state.busy or state.addingModels">
            <WoowIcon name="'close'" size="20"/>
          </button>
        </div>

        <div class="o_woow_modal_body">
          <!-- 1. 同意：條款風險與前置設定。勾選後才可取得代碼。 -->
          <t t-if="state.step === 'consent'">
            <div class="o_woow_chatgpt_modal__consent">
              <WoowIcon name="'warning'" size="20"/>
              <p t-esc="consentText"/>
            </div>
            <div class="o_woow_checkbox_group o_woow_chatgpt_modal__agree">
              <input
                id="o_woow_chatgpt_agree"
                type="checkbox"
                class="o_woow_checkbox"
                t-att-checked="state.agreed"
                t-on-change="onAgreeChange"/>
              <label for="o_woow_chatgpt_agree" class="o_woow_checkbox_label" t-esc="consentLabel"/>
            </div>
          </t>

          <!-- 2. 等待登入：大字代碼＋登入頁連結＋倒數；輪詢由 JS 的計時器負責。 -->
          <t t-elif="state.step === 'pending'">
            <p class="o_woow_hint" t-esc="pendingInstructions"/>
            <div class="o_woow_chatgpt_modal__code">
              <code t-esc="state.pending.user_code"/>
              <WoowButton variant="'secondary'" size="'sm'" onClick.bind="copyCode">
                <WoowIcon name="'content_copy'" size="16"/>
                <t t-if="state.copied">Copied</t>
                <t t-else="">Copy code</t>
              </WoowButton>
            </div>
            <a class="o_woow_btn o_woow_btn_primary o_woow_btn_md o_woow_chatgpt_modal__open"
               t-att-href="verificationUrl" target="_blank" rel="noopener noreferrer">
              <WoowIcon name="'open_in_new'" size="18"/>
              Open the OpenAI sign-in page
            </a>
            <div class="o_woow_chatgpt_modal__waiting">
              <WoowIcon name="'sync'" size="16" class="'o_woow_spin'"/>
              <span>Waiting for you to sign in</span>
              <span class="o_woow_chatgpt_modal__countdown" t-esc="countdown"/>
            </div>
          </t>

          <!-- 3. 已連接 -->
          <t t-elif="state.step === 'connected'">
            <div class="o_woow_chatgpt_modal__success">
              <WoowIcon name="'check_circle'" size="20"/>
              <p t-esc="connectedText"/>
            </div>
            <div class="o_woow_info_grid">
              <div class="o_woow_info_row">
                <span class="o_woow_info_label">Account</span>
                <span class="o_woow_info_value" t-esc="state.account.email or '—'"/>
              </div>
              <div class="o_woow_info_row">
                <span class="o_woow_info_label">Plan</span>
                <span class="o_woow_info_value" t-esc="planLabel"/>
              </div>
            </div>
            <div t-if="state.modelsNotice" t-att-class="state.modelsNoticeIsError ? 'o_woow_error_message' : 'o_woow_chatgpt_modal__notice'">
              <span t-esc="state.modelsNotice"/>
            </div>
          </t>

          <!-- 代碼過期／服務端已沒有這次登入 -->
          <t t-elif="state.step === 'expired'">
            <p t-esc="expiredText"/>
          </t>

          <!-- 失敗 -->
          <t t-elif="state.step === 'error'">
            <div class="o_woow_error_message">
              <WoowIcon name="'error'" size="16"/>
              <span t-esc="state.error"/>
            </div>
          </t>
        </div>

        <div class="o_woow_modal_footer">
          <t t-if="state.step === 'consent'">
            <WoowButton variant="'secondary'" size="'md'" onClick.bind="close" disabled="state.busy">
              Cancel
            </WoowButton>
            <WoowButton variant="'primary'" size="'md'" onClick.bind="getCode" disabled="!state.agreed or state.busy">
              <WoowIcon t-if="state.busy" name="'sync'" size="18" class="'o_woow_spin'"/>
              <WoowIcon t-else="" name="'key'" size="18"/>
              Get sign-in code
            </WoowButton>
          </t>
          <t t-elif="state.step === 'pending'">
            <WoowButton variant="'ghost'" size="'md'" onClick.bind="getCode" disabled="state.busy">
              Get a new code
            </WoowButton>
            <WoowButton variant="'secondary'" size="'md'" onClick.bind="close" disabled="state.busy">
              Close
            </WoowButton>
          </t>
          <t t-elif="state.step === 'connected'">
            <WoowButton variant="'secondary'" size="'md'" onClick.bind="addDefaultModels" disabled="state.addingModels">
              <WoowIcon t-if="state.addingModels" name="'sync'" size="18" class="'o_woow_spin'"/>
              <WoowIcon t-else="" name="'playlist_add'" size="18"/>
              Add default models
            </WoowButton>
            <WoowButton variant="'primary'" size="'md'" onClick.bind="close" disabled="state.addingModels">
              Done
            </WoowButton>
          </t>
          <t t-else="">
            <WoowButton variant="'secondary'" size="'md'" onClick.bind="close" disabled="state.busy">
              Close
            </WoowButton>
            <WoowButton variant="'primary'" size="'md'" onClick.bind="getCode" disabled="state.busy">
              <WoowIcon t-if="state.busy" name="'sync'" size="18" class="'o_woow_spin'"/>
              <WoowIcon t-else="" name="'refresh'" size="18"/>
              Get a new code
            </WoowButton>
          </t>
        </div>
      </div>
    </div>
  </t>
</templates>
