<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="woow_paas_platform.OneTimeCredentialsModal">
        <div class="o_woow_modal_backdrop" t-on-click="onBackdropClick">
            <div class="o_woow_modal o_woow_modal_sm" t-on-click.stop="">
                <div class="o_woow_modal_body">
                    <h2>Save your credentials</h2>
                    <p>
                        These values are shown only once. Save them before closing this dialog.
                    </p>
                    <!--
                        #461：這段文案是正確性的一部分，不是裝飾。改成非同步後，
                        「成功」＝憑證已是叢集權威值，但服務正在重啟才會真的吃到它
                        （chart 是 Recreate：舊 pod 先被殺，期間服務不可達）。少了
                        這句，租戶會拿著正確的憑證在重啟中的服務上撞牆，並回報成
                        「reset 沒生效」。
                    -->
                    <p class="o_woow_hint">
                        The service is restarting to apply them (usually 1–3 minutes) and may be
                        briefly unreachable. The status will return to Running when it is ready.
                    </p>
                    <!--
                        #530：每個憑證各自一列（具名 label ＋ 獨立複製鈕）。塞進同一個
                        輸入框會讓租戶把 dashboard 密碼填進 Gateway API Key 欄位，而那個
                        錯誤在 MCP 端只表現成一個紅點，看不出填錯的是哪一個。
                    -->
                    <t t-foreach="props.credentials" t-as="credential" t-key="credential.label">
                        <div class="o_woow_form_group">
                            <label><t t-esc="credential.label"/></label>
                            <div class="o_woow_input_with_suffix">
                                <input
                                    class="o_woow_input o_woow_input_readonly"
                                    type="text"
                                    t-att-value="credential.value"
                                    readonly="readonly"/>
                                <WoowButton
                                    variant="'secondary'"
                                    size="'sm'"
                                    onClick="() => this.copyValue(credential_index)">
                                    <WoowIcon name="'content_copy'" size="16"/>
                                    <t t-if="state.copiedIndex === credential_index">Copied</t>
                                    <t t-else="">Copy</t>
                                </WoowButton>
                            </div>
                            <p t-if="credential.hint" class="o_woow_hint">
                                <t t-esc="credential.hint"/>
                            </p>
                        </div>
                    </t>
                </div>
                <div class="o_woow_modal_footer">
                    <WoowButton variant="'primary'" size="'md'" onClick.bind="props.onClose">
                        Done
                    </WoowButton>
                </div>
            </div>
        </div>
    </t>
</templates>
