<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="woow_paas_platform.RollbackModal">
        <div class="o_woow_modal_backdrop" t-on-click="onBackdropClick">
            <div class="o_woow_modal o_woow_modal_rollback" t-on-click.stop="">
                <div class="o_woow_modal_header">
                    <h2>Rollback Service</h2>
                    <button
                        class="o_woow_modal_close"
                        t-on-click="props.onClose"
                        t-att-disabled="state.rolling">
                        <WoowIcon name="'close'" size="20"/>
                    </button>
                </div>

                <div class="o_woow_modal_body">
                    <!-- Loading State -->
                    <t t-if="state.loading">
                        <div class="o_woow_revisions_loading">
                            <WoowIcon name="'sync'" size="32" class="'o_woow_spin'"/>
                            <p>Loading revision history...</p>
                        </div>
                    </t>

                    <!-- Error State -->
                    <t t-elif="state.error and !state.revisions.length">
                        <div class="o_woow_revisions_error">
                            <WoowIcon name="'error'" size="48"/>
                            <p t-esc="state.error"/>
                            <WoowButton variant="'secondary'" size="'sm'" onClick.bind="loadRevisions">
                                <WoowIcon name="'refresh'" size="16"/>
                                Retry
                            </WoowButton>
                        </div>
                    </t>

                    <!-- Empty State -->
                    <t t-elif="!state.revisions.length">
                        <div class="o_woow_empty_revisions">
                            <WoowIcon name="'history'" size="48"/>
                            <p>No revision history available.</p>
                            <span class="o_woow_hint">
                                Revisions are created when the service is deployed or updated.
                            </span>
                        </div>
                    </t>

                    <!-- #1433 Confirm step -->
                    <t t-elif="state.confirming">
                        <div class="o_woow_rollback_confirm">
                            <p class="o_woow_rollback_confirm_title">
                                Roll back to revision <strong t-esc="state.selectedRevision"/>?
                            </p>
                            <ul class="o_woow_rollback_confirm_list">
                                <li t-if="chartChange">
                                    Chart version: <t t-esc="chartChange.from"/> → <t t-esc="chartChange.to"/>
                                </li>
                                <li>
                                    Settings return to the values saved in that revision. The chart version never goes below the current one.
                                </li>
                                <li t-if="keepsApiKeys">
                                    API keys and other credential settings are not rolled back: the current values stay in effect.
                                </li>
                                <li t-if="keepsAdminCredentials">
                                    The admin username and password are not rolled back: the current credentials stay in effect.
                                </li>
                                <li>
                                    The service restarts during the rollback (about a minute); work in progress may be interrupted.
                                </li>
                            </ul>
                        </div>

                        <div t-if="state.error" class="o_woow_error_message">
                            <WoowIcon name="'error'" size="16"/>
                            <span t-esc="state.error"/>
                        </div>
                    </t>

                    <!-- Revisions List -->
                    <t t-else="">
                        <div class="o_woow_rollback_info">
                            <WoowIcon name="'info'" size="18"/>
                            <span>
                                Select a revision to rollback to. Current revision:
                                <strong t-esc="currentRevision"/>
                            </span>
                        </div>

                        <!-- INFRA-FIX-018-1／AI-HER-003-1：helm 只保留最近 N 筆 revision。 -->
                        <div t-if="historyHint" class="o_woow_rollback_info o_woow_rollback_history_hint">
                            <WoowIcon name="'history'" size="18"/>
                            <span t-esc="historyHint"/>
                        </div>

                        <div t-if="hasBlockedRevisions" class="o_woow_rollback_info o_woow_rollback_floor_hint">
                            <WoowIcon name="'lock'" size="18"/>
                            <span>
                                Revisions that use an older chart version than the current one cannot be restored: that would undo platform security fixes.
                            </span>
                        </div>

                        <div class="o_woow_revisions_list">
                            <t t-foreach="state.revisions" t-as="revision" t-key="revision.revision">
                                <div
                                    t-att-class="{
                                        'o_woow_revision_item': true,
                                        'o_woow_revision_current': isCurrent(revision),
                                        'o_woow_revision_selected': isSelected(revision),
                                        'o_woow_revision_disabled': state.rolling or isBlocked(revision)
                                    }"
                                    t-on-click="() => this.selectRevision(revision)">
                                    <div class="o_woow_revision_radio">
                                        <div class="o_woow_radio_circle">
                                            <div t-if="isSelected(revision)" class="o_woow_radio_dot"/>
                                        </div>
                                    </div>
                                    <div class="o_woow_revision_content">
                                        <div class="o_woow_revision_header">
                                            <span class="o_woow_revision_number">
                                                Revision <t t-esc="revision.revision"/>
                                            </span>
                                            <span
                                                t-att-class="'o_woow_revision_status ' + getStatusClass(revision.status)"
                                                t-esc="statusLabel(revision.status)"/>
                                            <span t-if="isCurrent(revision)" class="o_woow_revision_badge">
                                                Current
                                            </span>
                                            <span t-if="isBlocked(revision)" class="o_woow_revision_badge o_woow_revision_badge_blocked">
                                                Older chart
                                            </span>
                                        </div>
                                        <div class="o_woow_revision_meta">
                                            <span class="o_woow_revision_date">
                                                <WoowIcon name="'schedule'" size="14"/>
                                                <t t-esc="formatDate(revision.updated)"/>
                                            </span>
                                            <span t-if="revision.description" class="o_woow_revision_desc">
                                                <t t-esc="revisionDescription(revision.description)"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>

                        <!-- Error during rollback -->
                        <div t-if="state.error" class="o_woow_error_message">
                            <WoowIcon name="'error'" size="16"/>
                            <span t-esc="state.error"/>
                        </div>
                    </t>

                    <!-- #2069：回復預檢結果（兩個步驟共用）。文字由 precheckPanel 以 _t 產生。 -->
                    <!-- t-key＝種類：種類一變（loading→blocked 等）就換掉整個節點，
                         輔助科技才會重新宣告 role=status／alert（同一個節點改 role 不保證會念）。
                         不把版本或序號放進這個 key：面板裡有子元件，OWL 在同一個畫格內
                         （點選版本、結果立刻回來）換掉含子元件的節點會在 mount 時丟例外。
                         t-ref：種類改變後 _revealPanel 把它捲進可視範圍。 -->
                    <div
                        t-if="precheckPanel"
                        t-key="precheckPanel.kind"
                        t-ref="precheckPanel"
                        t-att-class="'o_woow_rollback_precheck o_woow_rollback_precheck_' + precheckPanel.kind"
                        t-att-role="precheckPanel.role">
                        <div class="o_woow_rollback_precheck_title">
                            <WoowIcon name="precheckPanel.icon" size="18" class="precheckPanel.iconClass or ''"/>
                            <strong t-att-id="precheckTitleId" t-esc="precheckPanel.title"/>
                        </div>
                        <p t-if="precheckPanel.intro" class="o_woow_rollback_precheck_text" t-esc="precheckPanel.intro"/>
                        <ul t-if="precheckPanel.items.length" class="o_woow_rollback_precheck_list">
                            <li t-foreach="precheckPanel.items" t-as="item" t-key="item.name">
                                <code t-esc="item.name"/>
                                <span t-if="item.state" class="o_woow_badge o_woow_badge_red o_woow_rollback_precheck_state" t-esc="item.state"/>
                                <span t-if="item.detail" class="o_woow_rollback_precheck_detail" t-esc="item.detail"/>
                            </li>
                        </ul>
                        <p t-if="precheckPanel.hint" t-att-id="precheckHintId" class="o_woow_rollback_precheck_text" t-esc="precheckPanel.hint"/>
                        <!-- t-key＝預檢序號：顯示中的預檢一換，勾選框就重建，DOM 的勾選狀態不會和
                             state 脫節（OWL 只拿上次渲染的值比、不讀 DOM）；label 內沒有子元件，重建安全。 -->
                        <label t-if="precheckPanel.kind === 'unverified'" t-key="state.precheck.seq" class="o_woow_rollback_precheck_ack">
                            <input
                                type="checkbox"
                                t-att-checked="state.acknowledged"
                                t-att-data-token="state.precheck.seq"
                                t-on-change="onAcknowledge"
                                t-att-disabled="state.rolling"
                                t-attf-aria-describedby="{{ precheckTitleId }} {{ precheckHintId }}"/>
                            <span t-esc="precheckPanel.ackLabel"/>
                        </label>
                        <div t-if="precheckPanel.retry" class="o_woow_rollback_precheck_actions">
                            <WoowButton variant="'secondary'" size="'sm'" onClick.bind="retryPrecheck" disabled="state.rolling or precheckLoading">
                                <WoowIcon name="'refresh'" size="16"/>
                                Retry check
                            </WoowButton>
                        </div>
                    </div>
                </div>

                <div class="o_woow_modal_footer">
                    <!-- 常駐在 footer（不隨 body 捲動）：按鈕為什麼不能按，與預檢面板同一份模型。 -->
                    <p
                        t-if="precheckReason"
                        t-att-id="precheckReasonId"
                        t-att-class="'o_woow_rollback_reason o_woow_rollback_reason_' + precheckPanel.kind"
                        t-esc="precheckReason"/>
                    <WoowButton
                        t-if="state.confirming"
                        variant="'secondary'"
                        size="'md'"
                        onClick.bind="onBack"
                        disabled="state.rolling">
                        Back
                    </WoowButton>
                    <WoowButton
                        t-else=""
                        variant="'secondary'"
                        size="'md'"
                        onClick="props.onClose"
                        disabled="state.rolling">
                        Cancel
                    </WoowButton>
                    <WoowButton
                        variant="'primary'"
                        size="'md'"
                        onClick.bind="onRollback"
                        ariaDescribedby="confirmDescribedBy"
                        disabled="!canRollback">
                        <t t-if="state.rolling">
                            <WoowIcon name="'sync'" size="18" class="'o_woow_spin'"/>
                            Rolling back...
                        </t>
                        <t t-elif="state.confirming">
                            <WoowIcon name="'history'" size="18"/>
                            Confirm Rollback
                        </t>
                        <t t-else="">
                            <WoowIcon name="'history'" size="18"/>
                            Rollback to Revision <t t-esc="state.selectedRevision or '...'"/>
                        </t>
                    </WoowButton>
                </div>
            </div>
        </div>
    </t>
</templates>
