<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="woow_paas_platform.ChangePlanModal">
    <div class="o_woow_modal_backdrop" t-on-click="onBackdropClick">
      <div class="o_woow_modal o_woow_modal_lg" t-on-click.stop="">
        <div class="o_woow_modal_header">
          <h2><t t-if="props.activatingTrial">選擇付費方案</t><t t-else="">Change Plan</t></h2>
          <button
            class="o_woow_modal_close"
            t-on-click="props.onClose"
            t-att-disabled="state.changing">
            <WoowIcon name="props.activatingTrial ? 'mdi-close' : 'close'" size="20"/>
          </button>
        </div>

        <div class="o_woow_modal_body">
          <!-- 目前方案（變體 plan 名已含席數，直接顯示） -->
          <div class="o_woow_change_plan__current">
            <span class="o_woow_change_plan__current_label"><t t-if="props.activatingTrial">目前試用方案</t><t t-else="">Current Plan</t></span>
            <span class="o_woow_change_plan__current_value" t-esc="currentPlanName"/>
          </div>

          <!-- #36 P2 警告階段：試用中按下確認後的最後一道關卡。三條後果逐字對應
               Eugene 的裁決（立刻結束試用／現在開始第一個計費週期／產生首期帳單），
               並與 SkipTrialModal 的三條保持同構——同一件事在兩個入口說法一致。
               判準見 ChangePlanModal.js 的 `willEndTrial`（含後端結構論證）。 -->
          <t t-if="state.confirmingTrialEnd">
            <div class="o_woow_change_plan__trial_warning">
              <div class="o_woow_change_plan__trial_warning_head">
                <WoowIcon name="props.activatingTrial ? 'mdi-alert-outline' : 'warning'" size="28"/>
                <p t-if="props.activatingTrial">確認啟用付費方案</p>
                <p t-else="">This will end your trial immediately</p>
              </div>
              <p t-if="props.activatingTrial" class="o_woow_change_plan__trial_warning_lead">確認後會從今天開始計費，並依所選方案產生首期帳單。若仍在試用中，剩餘試用將立即結束。</p>
              <p t-else="" class="o_woow_change_plan__trial_warning_lead">
                Your current trial has not ended yet. Confirming the plan change will:
              </p>
              <ul t-if="!props.activatingTrial" class="o_woow_change_plan__trial_warning_list">
                <li>End your current trial immediately</li>
                <li>Start your first billing cycle now</li>
                <li>Generate your first invoice</li>
              </ul>
            </div>
          </t>

          <!-- 選擇階段 -->
          <t t-else="">
            <!-- 載入方案清單中 -->
            <t t-if="state.loadingPlans">
              <div class="o_woow_pay_confirm_text">
                <WoowIcon name="props.activatingTrial ? 'mdi-loading' : 'sync'" size="20" class="'o_woow_spin'"/>
                <p><t t-if="props.activatingTrial">正在載入方案…</t><t t-else="">Loading plans...</t></p>
              </div>
            </t>

            <!-- 方案清單載入失敗 -->
            <t t-if="!state.loadingPlans and state.plansError">
              <div class="o_woow_error_message">
                <WoowIcon name="props.activatingTrial ? 'mdi-alert-circle-outline' : 'error'" size="16"/>
                <span t-esc="state.plansError"/>
              </div>
            </t>

            <!-- 方案選擇器（內嵌 PlanSelector，變體自動展開席數第二步） -->
            <t t-if="!state.loadingPlans and !state.plansError">
              <div class="o_woow_form_group">
                <label><t t-if="props.activatingTrial">選擇付費方案</t><t t-else="">Select New Plan</t></label>
                <PlanSelector
                  plans="state.plans"
                  selectedPlanId="state.selectedPlanId"
                  currentPlanId="props.currentPlanId"
                  usedSeats="usedSeats"
                  usedRoutes="props.usedRoutes"
                  hideTrial="true"
                  onSelect.bind="onSelectPlan"/>
              </div>

              <!-- 退點通用說明（無退點預覽 API，實際金額於確認後呈現）。
                   本句只講**退點**；試用會不會結束由下方 trial 專屬那句負責，
                   兩句刻意不重疊。「本期尚未成功扣款則無可退點數」對非試用使用者
                   同樣成立——`_compute_unused_refund` 的前提是
                   `_has_paid_current_cycle()`（#324 (b)），不是只有試用才退 0。 -->
              <div class="o_woow_change_plan__advisory">
                <WoowIcon name="props.activatingTrial ? 'mdi-information-outline' : 'info'" size="16"/>
                <span t-if="props.activatingTrial">試用不會自動轉為付費。你可以沿用目前方案或選擇其他方案；確認開始計費後，才會建立付費訂閱。到期暫停的服務會在付款完成後恢復。</span>
                <span t-else="">
                  Changing your plan closes the current subscription and re-bills under the
                  new plan; the unused portion of the current cycle is refunded to your
                  wallet as credit points on a pro-rata basis (if this cycle has not been
                  successfully charged, there are no points to refund).
                </span>
              </div>

              <!-- #36：試用中專屬的事前提醒。原本這格只在退點語境提到「試用中」，
                   試用使用者會讀成「我還沒扣過錢所以沒得退」而**低估後果**——旁邊
                   PlanSelector 的卡片還標著「N-day free trial」。這句把真正的後果
                   （試用當場結束、開始計費）講在選擇當下，確認前的警告階段再要一次
                   明示同意。 -->
              <div t-if="willEndTrial and !props.activatingTrial" class="o_woow_change_plan__advisory o_woow_change_plan__advisory--trial">
                <WoowIcon name="props.activatingTrial ? 'mdi-alert-outline' : 'warning'" size="16"/>
                <span>
                  You are currently on a trial: changing your plan ends the trial
                  immediately, starts billing and generates your first invoice. No payment
                  was taken during the trial, so there are no points to refund.
                </span>
              </div>

              <!-- #1261：原本這格寫「資源將於下個計費週期生效」，與後端實際行為相反。
                   三條 change-plan 端點（paas.py api_service_change_plan／
                   security_access.py api_sa_change_plan／smart_home.py change-plan）
                   都是**同一次呼叫內**退點→關舊訂閱→建新訂閱並開首期帳單；席數等
                   額度直接讀新訂閱的 plan（#773 seat gate 同一把尺），所以是**立即**
                   生效。2026-09-29 正式站 E2E 實測：確認後席數當場變成新方案、帳單
                   當場開出——舊文案讓租戶以為還能用舊額度到週期結束。
                   退點細節（按比例、本期未扣款則無可退）由上方 advisory 負責，這裡
                   只指回去、不重述，免得兩處說法漂開。 -->
              <div t-if="!props.activatingTrial" class="o_woow_change_plan__notice">
                <WoowIcon name="props.activatingTrial ? 'mdi-lightning-bolt-outline' : 'bolt'" size="14"/>
                <span>The change takes effect immediately: the new plan and its limits apply as soon as you confirm and are billed from today. The unused part of the current period is refunded as described above.</span>
              </div>
              <!-- #1158（Closes #342）：Cloud Service 的運算規格也是立即生效——確認後
                   後端在同一次呼叫內排 helm upgrade，服務重啟套用新方案的 vCPU／RAM／
                   workers。儲存空間只擴不縮（暫定，#1512）：PVC 不能縮，換到儲存較小的
                   方案時保留目前大小。只有 CS 父頁會傳 resizesResources；SA／SH 的方案
                   沒有運算規格。 -->
              <div t-if="props.resizesResources" class="o_woow_change_plan__notice">
                <WoowIcon name="props.activatingTrial ? 'mdi-information-outline' : 'info'" size="14"/>
                <span>If the new plan has different compute resources, the service restarts to apply them (about 30 seconds of downtime). Storage is never reduced: on a plan with less storage, the current storage size is kept.</span>
              </div>
            </t>
          </t>

          <!-- AUDITFIX change-plan-insufficient-balance（#1677 A1）：錢包＋退點付不起新方案首期
               （含稅）時停用確認鈕並顯示差額與儲值連結。金額全部來自後端 dry_run 估算，前端
               不自己算；後端換方案時同一把尺會再擋一次。 -->
          <div t-if="balanceBlocked and !state.confirmingTrialEnd" class="o_woow_pay_warning o_woow_change_plan__balance">
            <WoowIcon name="props.activatingTrial ? 'mdi-alert-outline' : 'warning'" size="20"/>
            <div>
              <p t-esc="balanceShortfallMessage"/>
              <a href="#/billing/topup" class="o_woow_pay_topup_link" t-on-click="props.onClose">
                <WoowIcon name="props.activatingTrial ? 'mdi-plus' : 'add'" size="16"/>
                <t t-if="props.activatingTrial">前往儲值</t><t t-else="">Top up your wallet</t>
              </a>
            </div>
          </div>

          <!-- #1647：錯誤訊息排在可捲動的 body 最後（與其他 modal 同一個位置）。body 的
               內容比視窗高時它會落在可視範圍之外，所以每次失敗都由 ChangePlanModal.js 把
               這一塊捲進可視範圍（t-ref 就是給它用的；原因與量測見該檔 setup 的說明）。
               ⛔ 拿掉 t-ref 或把這一塊搬到別處前先看
               test_compute_quota_preflight_1647.py::TestChangePlanErrorVisible1647。 -->
          <div t-if="state.error" class="o_woow_error_message" t-ref="errorMessage">
            <WoowIcon name="props.activatingTrial ? 'mdi-alert-circle-outline' : 'error'" size="16"/>
            <span t-esc="state.error"/>
          </div>
        </div>

        <div class="o_woow_modal_footer">
          <!-- 總價常駐 footer（o_woow_modal_footer flex-shrink:0，不隨 body 捲走）；
               PlanTotalBar 自身 margin-right:auto 靠左、按鈕推右（與其他 3 個
               PlanTotalBar 嵌入點一致）；plans 未載入時回退顯示「—」。 -->
          <PlanTotalBar
            plans="state.plans"
            selectedPlanId="state.selectedPlanId"
            mode="'change'"/>
          <!-- #36 P2：警告階段換一組按鈕。次要鍵標「返回」而非「取消」是刻意的——
               它回到選擇階段（選擇原封不動），不是關掉整個 modal；要整個放棄仍可用
               右上 X 或點背景。主要鍵改 danger + 明說「開始計費」，讓最後一下點擊
               本身就帶著後果，而不是再按一次語意中性的「確認變更」。 -->
          <t t-if="state.confirmingTrialEnd">
            <WoowButton
              variant="'secondary'"
              size="'md'"
              onClick.bind="onBackFromTrialWarning"
              disabled="state.changing">
              <t t-if="props.activatingTrial">返回選擇</t><t t-else="">Back</t>
            </WoowButton>
            <WoowButton
              variant="'danger'"
              size="'md'"
              onClick.bind="onConfirm"
              disabled="!canConfirm">
              <t t-if="state.changing">
                <WoowIcon name="props.activatingTrial ? 'mdi-loading' : 'sync'" size="18" class="'o_woow_spin'"/>
                <t t-if="props.activatingTrial">處理中…</t><t t-else="">Processing...</t>
              </t>
              <t t-else="">
                <WoowIcon name="props.activatingTrial ? 'mdi-receipt-text-outline' : 'receipt_long'" size="18"/>
                <t t-if="props.activatingTrial">確認方案並開始計費</t>
                <t t-else="">End Trial &amp; Start Billing</t>
              </t>
            </WoowButton>
          </t>
          <t t-else="">
            <WoowButton
              variant="'secondary'"
              size="'md'"
              onClick="props.onClose"
              disabled="state.changing">
              <t t-if="props.activatingTrial">取消</t><t t-else="">Cancel</t>
            </WoowButton>
            <WoowButton
              variant="'primary'"
              size="'md'"
              onClick.bind="onConfirm"
              disabled="!canConfirm">
              <t t-if="state.changing">
                <WoowIcon name="props.activatingTrial ? 'mdi-loading' : 'sync'" size="18" class="'o_woow_spin'"/>
                <t t-if="props.activatingTrial">處理中…</t><t t-else="">Processing...</t>
              </t>
              <t t-else="">
                <WoowIcon name="props.activatingTrial ? 'mdi-swap-horizontal' : 'swap_horiz'" size="18"/>
                <t t-if="props.activatingTrial">繼續確認付費方案</t>
                <t t-else="">Confirm Change</t>
              </t>
            </WoowButton>
          </t>
        </div>
      </div>
    </div>
  </t>
</templates>
