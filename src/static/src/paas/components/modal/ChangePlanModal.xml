<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="woow_paas_platform.ChangePlanModal">
    <div class="o_woow_modal_backdrop" t-on-click="onBackdropClick">
      <div class="o_woow_modal o_woow_modal_lg" t-on-click.stop="">
        <div class="o_woow_modal_header">
          <h2>Change Plan</h2>
          <button
            class="o_woow_modal_close"
            t-on-click="props.onClose"
            t-att-disabled="state.changing">
            <WoowIcon name="'close'" size="20"/>
          </button>
        </div>

        <div class="o_woow_modal_body">
          <!-- 目前方案（變體 plan 名已含席數，直接顯示） -->
          <div class="o_woow_change_plan__current">
            <span class="o_woow_change_plan__current_label">Current Plan</span>
            <span class="o_woow_change_plan__current_value" t-esc="currentPlanName"/>
          </div>

          <!-- #36 P2 警告階段：試用中按下確認後的最後一道關卡。三條後果逐字對應
               Eugene 的裁決（立刻結束試用／現在開始第一個計費週期／產生首期帳單），
               並與 SkipTrialModal 的三條保持同構——同一件事在兩個入口說法一致。
               判準見 ChangePlanModal.js 的 `willEndTrial`（含後端結構論證）。 -->
          <t t-if="state.confirmingTrialEnd">
            <div class="o_woow_change_plan__trial_warning">
              <div class="o_woow_change_plan__trial_warning_head">
                <WoowIcon name="'warning'" size="28"/>
                <p>This will end your trial immediately</p>
              </div>
              <p class="o_woow_change_plan__trial_warning_lead">
                Your current trial has not ended yet. Confirming the plan change will:
              </p>
              <ul class="o_woow_change_plan__trial_warning_list">
                <li>End your current trial immediately</li>
                <li>Start your first billing cycle now</li>
                <li>Generate your first invoice</li>
              </ul>
            </div>
          </t>

          <!-- 選擇階段 -->
          <t t-else="">
            <!-- 載入方案清單中 -->
            <t t-if="state.loadingPlans">
              <div class="o_woow_pay_confirm_text">
                <WoowIcon name="'sync'" size="20" class="'o_woow_spin'"/>
                <p>Loading plans...</p>
              </div>
            </t>

            <!-- 方案清單載入失敗 -->
            <t t-if="!state.loadingPlans and state.plansError">
              <div class="o_woow_error_message">
                <WoowIcon name="'error'" size="16"/>
                <span t-esc="state.plansError"/>
              </div>
            </t>

            <!-- 方案選擇器（內嵌 PlanSelector，變體自動展開席數第二步） -->
            <t t-if="!state.loadingPlans and !state.plansError">
              <div class="o_woow_form_group">
                <label>Select New Plan</label>
                <PlanSelector
                  plans="state.plans"
                  selectedPlanId="state.selectedPlanId"
                  currentPlanId="props.currentPlanId"
                  onSelect.bind="onSelectPlan"/>
              </div>

              <!-- 退點通用說明（無退點預覽 API，實際金額於確認後呈現）。
                   本句只講**退點**；試用會不會結束由下方 trial 專屬那句負責，
                   兩句刻意不重疊。「本期尚未成功扣款則無可退點數」對非試用使用者
                   同樣成立——`_compute_unused_refund` 的前提是
                   `_has_paid_current_cycle()`（#324 (b)），不是只有試用才退 0。 -->
              <div class="o_woow_change_plan__advisory">
                <WoowIcon name="'info'" size="16"/>
                <span>
                  Changing your plan closes the current subscription and re-bills under the
                  new plan; the unused portion of the current cycle is refunded to your
                  wallet as credit points on a pro-rata basis (if this cycle has not been
                  successfully charged, there are no points to refund).
                </span>
              </div>

              <!-- #36：試用中專屬的事前提醒。原本這格只在退點語境提到「試用中」，
                   試用使用者會讀成「我還沒扣過錢所以沒得退」而**低估後果**——旁邊
                   PlanSelector 的卡片還標著「N-day free trial」。這句把真正的後果
                   （試用當場結束、開始計費）講在選擇當下，確認前的警告階段再要一次
                   明示同意。 -->
              <div t-if="willEndTrial" class="o_woow_change_plan__advisory o_woow_change_plan__advisory--trial">
                <WoowIcon name="'warning'" size="16"/>
                <span>
                  You are currently on a trial: changing your plan ends the trial
                  immediately, starts billing and generates your first invoice. No payment
                  was taken during the trial, so there are no points to refund.
                </span>
              </div>

              <!-- #342 未落地前的誠實處置：改方案後的規格（vCPU/RAM/席數）於下個
                   計費週期才 re-apply、非即時。TODO(Refs #342)：#342 生效 re-apply
                   落地後移除此提示（見 docs/tracking/followups/follow-ups.md）。 -->
              <div class="o_woow_change_plan__notice">
                <WoowIcon name="'schedule'" size="14"/>
                <span>Resource changes take effect in the next billing cycle.</span>
              </div>
            </t>
          </t>

          <div t-if="state.error" class="o_woow_error_message">
            <WoowIcon name="'error'" size="16"/>
            <span t-esc="state.error"/>
          </div>
        </div>

        <div class="o_woow_modal_footer">
          <!-- 總價常駐 footer（o_woow_modal_footer flex-shrink:0，不隨 body 捲走）；
               PlanTotalBar 自身 margin-right:auto 靠左、按鈕推右（與其他 3 個
               PlanTotalBar 嵌入點一致）；plans 未載入時回退顯示「—」。 -->
          <PlanTotalBar
            plans="state.plans"
            selectedPlanId="state.selectedPlanId"
            mode="'change'"/>
          <!-- #36 P2：警告階段換一組按鈕。次要鍵標「返回」而非「取消」是刻意的——
               它回到選擇階段（選擇原封不動），不是關掉整個 modal；要整個放棄仍可用
               右上 X 或點背景。主要鍵改 danger + 明說「開始計費」，讓最後一下點擊
               本身就帶著後果，而不是再按一次語意中性的「確認變更」。 -->
          <t t-if="state.confirmingTrialEnd">
            <WoowButton
              variant="'secondary'"
              size="'md'"
              onClick.bind="onBackFromTrialWarning"
              disabled="state.changing">
              Back
            </WoowButton>
            <WoowButton
              variant="'danger'"
              size="'md'"
              onClick.bind="onConfirm"
              disabled="!canConfirm">
              <t t-if="state.changing">
                <WoowIcon name="'sync'" size="18" class="'o_woow_spin'"/>
                Processing...
              </t>
              <t t-else="">
                <WoowIcon name="'receipt_long'" size="18"/>
                End Trial &amp; Start Billing
              </t>
            </WoowButton>
          </t>
          <t t-else="">
            <WoowButton
              variant="'secondary'"
              size="'md'"
              onClick="props.onClose"
              disabled="state.changing">
              Cancel
            </WoowButton>
            <WoowButton
              variant="'primary'"
              size="'md'"
              onClick.bind="onConfirm"
              disabled="!canConfirm">
              <t t-if="state.changing">
                <WoowIcon name="'sync'" size="18" class="'o_woow_spin'"/>
                Processing...
              </t>
              <t t-else="">
                <WoowIcon name="'swap_horiz'" size="18"/>
                Confirm Change
              </t>
            </WoowButton>
          </t>
        </div>
      </div>
    </div>
  </t>
</templates>
