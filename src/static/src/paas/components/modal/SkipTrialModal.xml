<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="woow_paas_platform.SkipTrialModal">
        <div class="o_woow_modal_backdrop" t-on-click="onBackdropClick">
            <div class="o_woow_modal o_woow_modal_sm" t-on-click.stop="">
                <div class="o_woow_modal_header">
                    <h2>Skip Trial Period</h2>
                    <button
                        class="o_woow_modal_close"
                        t-on-click="props.onClose"
                        t-att-disabled="state.skipping">
                        <WoowIcon name="'close'" size="20"/>
                    </button>
                </div>

                <div class="o_woow_modal_body">
                    <div class="o_woow_delete_warning">
                        <WoowIcon name="'info'" size="48"/>
                        <p>Skip the free trial for <strong t-esc="props.service.name"/>?</p>
                        <p class="o_woow_delete_hint">
                            Your trial ends on <strong t-esc="trialEndDate"/>.
                            Skipping will:
                        </p>
                        <ul style="text-align: left; margin: 0 auto; display: inline-block;">
                            <li>End your free trial immediately</li>
                            <li>Generate your first invoice now</li>
                            <li>Start regular monthly billing today</li>
                        </ul>
                    </div>

                    <!-- Loading state -->
                    <t t-if="state.loadingEstimate">
                        <div class="o_woow_pay_confirm_text">
                            <WoowIcon name="'sync'" size="20" class="'o_woow_spin'"/>
                            <p>Loading invoice breakdown...</p>
                        </div>
                    </t>

                    <!-- Estimate failed -->
                    <t t-if="!state.loadingEstimate and state.estimateError">
                        <div class="o_woow_error_message">
                            <WoowIcon name="'error'" size="16"/>
                            <span t-esc="state.estimateError"/>
                        </div>
                    </t>

                    <!-- Breakdown table (loaded successfully) -->
                    <t t-if="!state.loadingEstimate and !state.estimateError and state.estimate">
                        <div class="o_woow_pay_info">
                            <div class="o_woow_pay_row">
                                <span class="o_woow_pay_label">Subtotal</span>
                                <span class="o_woow_pay_value">
                                    <t t-esc="formatPoints(state.estimate.untaxed)"/>
                                </span>
                            </div>
                            <div class="o_woow_pay_row">
                                <span class="o_woow_pay_label">
                                    Tax (<t t-esc="(state.estimate.tax_rate * 100).toFixed(0)"/>%)
                                </span>
                                <span class="o_woow_pay_value">
                                    <t t-esc="formatPoints(state.estimate.tax_amount)"/>
                                </span>
                            </div>
                            <div class="o_woow_pay_row">
                                <span class="o_woow_pay_label">Total</span>
                                <span class="o_woow_pay_value o_woow_pay_amount">
                                    <t t-esc="formatPoints(state.estimate.total)"/>
                                </span>
                            </div>
                            <div class="o_woow_pay_row">
                                <span class="o_woow_pay_label">Wallet Balance</span>
                                <span class="o_woow_pay_value">
                                    <t t-esc="formatPoints(state.estimate.wallet_balance)"/>
                                </span>
                            </div>
                        </div>

                        <div t-if="isPaymentBlocked" class="o_woow_pay_warning">
                            <WoowIcon name="'warning'" size="20"/>
                            <p>
                                <t t-if="state.estimate.pay_blocked_reason === 'flagless_automatic_not_payable'">
                                    This invoice cannot be paid in /woow while automatic e-invoicing is enabled. Please contact support.
                                </t>
                                <t t-else="">Invoice is not payable</t>
                            </p>
                        </div>

                        <!-- Insufficient balance warning + top-up link -->
                        <t t-if="!isPaymentBlocked and !state.estimate.sufficient">
                            <div class="o_woow_pay_warning">
                                <WoowIcon name="'warning'" size="20"/>
                                <div>
                                    <p>
                                        Insufficient balance.
                                        You need <strong><t t-esc="formatPoints(state.estimate.shortage)"/></strong> more
                                        to skip the trial.
                                    </p>
                                    <a href="#/billing/topup" class="o_woow_pay_topup_link">
                                        <WoowIcon name="'add'" size="16"/>
                                        Top up your wallet
                                    </a>
                                </div>
                            </div>
                        </t>
                    </t>

                    <div t-if="state.error" class="o_woow_error_message">
                        <WoowIcon name="'error'" size="16"/>
                        <span t-esc="state.error"/>
                    </div>
                </div>

                <div class="o_woow_modal_footer">
                    <WoowButton
                        variant="'secondary'"
                        size="'md'"
                        onClick="props.onClose"
                        disabled="state.skipping">
                        Cancel
                    </WoowButton>
                    <WoowButton
                        variant="'primary'"
                        size="'md'"
                        onClick.bind="onConfirm"
                        disabled="!canConfirm">
                        <t t-if="state.skipping">
                            <WoowIcon name="'sync'" size="18" class="'o_woow_spin'"/>
                            Processing...
                        </t>
                        <t t-else="">
                            <WoowIcon name="'skip_next'" size="18"/>
                            Skip Trial &amp; Start Billing
                        </t>
                    </WoowButton>
                </div>
            </div>
        </div>
    </t>
</templates>
