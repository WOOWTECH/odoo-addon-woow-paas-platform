<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="woow_paas_platform.ResetAdminPasswordModal">
    <div class="o_woow_modal_backdrop" t-on-click="onBackdropClick">
      <div class="o_woow_modal o_woow_modal_sm" t-on-click.stop="">
        <div class="o_woow_modal_header">
          <h2>Reset Admin Password</h2>
          <button
            class="o_woow_modal_close"
            t-on-click="props.onClose"
            t-att-disabled="state.resetting">
            <WoowIcon name="'close'" size="20"/>
          </button>
        </div>

        <div class="o_woow_modal_body">
          <p>Reset the admin password of this service?</p>
          <ul class="o_woow_restart_notes">
            <li>A new password is generated and shown only once. The current password stops working right away.</li>
            <t t-if="props.appReset">
              <li t-if="props.keepsSessions">The service does not restart. Devices that are already signed in stay signed in.</li>
              <li t-elif="props.noSecondFactor">The service does not restart. Anyone signed in to the dashboard with the current password is signed out.</li>
              <li t-else="">The service does not restart. Devices signed in with the current password are signed out, and two-factor sign-in is turned off.</li>
            </t>
            <li t-else="">The service restarts to apply the new password (about a minute); work in progress is interrupted.</li>
            <li t-if="replacesGatewayKey">The Gateway API Key is replaced too; update it wherever you configured it (e.g. your MCP server).</li>
          </ul>
        </div>

        <div class="o_woow_modal_footer">
          <WoowButton
            variant="'secondary'"
            size="'md'"
            onClick="props.onClose"
            disabled="state.resetting">
            Cancel
          </WoowButton>
          <WoowButton
            variant="'primary'"
            size="'md'"
            onClick.bind="onReset"
            disabled="state.resetting">
            <t t-if="state.resetting">
              <WoowIcon name="'sync'" size="18" class="'o_woow_spin'"/>
              Resetting...
            </t>
            <t t-else="">
              <WoowIcon name="'key'" size="18"/>
              Reset Admin Password
            </t>
          </WoowButton>
        </div>
      </div>
    </div>
  </t>
</templates>
