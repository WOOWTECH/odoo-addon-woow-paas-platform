<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <!-- 一個 Cloudflare Access 錨點的設定卡（#746 從 SecurityAccessDetailPage
       的 per-route 區塊抽出，SA 與 Cloud Service 共用）。版面與 class 名逐字
       沿用抽取前的樣子——`sa` 詞根留著是刻意的：改名要同時改 SA 端每一條選擇
       器，視覺回歸的風險遠大於命名收益。 -->
  <t t-name="woow_paas_platform.AccessAppCard">
    <div class="o_woow_sa_app">
      <div class="o_woow_sa_app__head">
        <div t-att-class="'o_woow_sa_app__shield ' + (props.config.is_protected ? 'o_woow_sa_app__shield--on' : 'o_woow_sa_app__shield--off')">
          <WoowIcon name="props.config.is_protected ? 'verified_user' : 'gpp_bad'" size="20"/>
        </div>
        <div class="o_woow_sa_app__ident">
          <span class="o_woow_sa_detail__mono o_woow_sa_app__host" t-esc="props.hostname"/>
          <div t-if="props.config.is_protected"
               class="o_woow_sa_app__status o_woow_sa_app__status--on">
            <span class="o_woow_sa_app__dot"/>
            <!-- 數字與單位之間的空白必須在**同一行**：OWL 會把含換行的
                 whitespace-only 文字節點整個丟掉，抽取前的原始碼把兩個 t-esc
                 拆兩行，租戶看到的一直是「3policies」。 -->
            <span>Protected · <t t-esc="state.policies.length"/> <t t-esc="state.policies.length === 1 ? 'policy' : 'policies'"/></span>
          </div>
          <div t-else="" class="o_woow_sa_app__status o_woow_sa_app__status--off">
            <span class="o_woow_sa_app__dot"/>
            <span>Public · anyone can reach it</span>
          </div>
        </div>
        <div class="o_woow_sa_app__controls">
          <label class="o_woow_sa_switch">
            <input type="checkbox" t-ref="protectInput"
                   t-att-checked="props.config.is_protected"
                   t-att-disabled="props.protectDisabled"
                   t-on-change="onProtectedToggle"/>
            <span class="o_woow_sa_switch__slider"/>
          </label>
          <button t-if="props.config.is_protected" class="o_woow_sa_app__expand"
                  t-on-click="() => this.props.onToggleExpand()">
            <WoowIcon name="props.expanded ? 'expand_less' : 'expand_more'" size="20"/>
          </button>
        </div>
      </div>
      <div t-if="props.config.is_protected and props.expanded"
           class="o_woow_sa_app__body">
        <div class="o_woow_sa_access__section">
          <div class="o_woow_sa_access__label">
            <WoowIcon name="'fingerprint'" size="16"/>
            <span>Login Methods</span>
          </div>
          <div class="o_woow_sa_login_pills">
            <button t-att-class="'o_woow_sa_login_pill' + (props.config.login_email_otp ? ' o_woow_sa_login_pill--active' : '')"
                    t-on-click="() => this.props.onLoginToggle('login_email_otp')">
              <WoowIcon name="'mail'" size="16"/>
              <span>Email OTP</span>
              <WoowIcon t-if="props.config.login_email_otp" name="'check'" size="14"/>
            </button>
            <button t-att-class="'o_woow_sa_login_pill' + (props.config.login_google ? ' o_woow_sa_login_pill--active' : '')"
                    t-on-click="() => this.props.onLoginToggle('login_google')">
              <WoowIcon name="'account_circle'" size="16"/>
              <span>Google</span>
              <WoowIcon t-if="props.config.login_google" name="'check'" size="14"/>
            </button>
          </div>
          <div t-if="props.config.access_unresolved_idp_types"
               class="o_woow_sa_access__idp_warning" role="alert">
            <WoowIcon name="'warning'" size="16"/>
            <span>
              These login methods have no matching Cloudflare identity
              provider and were ignored:
              <strong t-esc="unresolvedIdpLabels()"/>.
              Access may have fallen back to allowing all available login
              methods. Add the matching identity provider in your
              Cloudflare Zero Trust account, then re-save to re-apply
              the restriction.
            </span>
          </div>
        </div>
        <div class="o_woow_sa_access__section">
          <div class="o_woow_sa_access__policy_header">
            <div class="o_woow_sa_access__label">
              <WoowIcon name="'group'" size="16"/>
              <span>Access Policies</span>
            </div>
            <WoowButton variant="'secondary'" size="'sm'"
                        onClick="() => this.props.onAddPolicy()">
              <WoowIcon name="'add'" size="14"/>
              <span>Add Policy</span>
            </WoowButton>
          </div>
          <div t-if="state.policies.length"
               t-att-class="'o_woow_sa_policy_list' + (props.reordering ? ' o_woow_sa_policy_list--saving' : '')">
            <div t-if="props.reordering" class="o_woow_sa_policy_saving">
              <span class="o_woow_sa_spinner o_woow_spin"/>
              <span>Saving order…</span>
            </div>
            <t t-foreach="state.policies" t-as="pol" t-key="pol.id">
              <div t-att-class="'o_woow_sa_policy' + (state.draggingPolId === pol.id ? ' o_woow_sa_policy--dragging' : '')"
                   draggable="true"
                   t-on-dragstart="(ev) => this.onPolicyDragStart(pol, ev)"
                   t-on-dragover="(ev) => this.onPolicyDragOver(pol, ev)"
                   t-on-drop="(ev) => this.onPolicyDrop(ev)"
                   t-on-dragend="() => this.onPolicyDragEnd()">
                <span class="o_woow_sa_policy__handle" title="Drag to reorder">
                  <WoowIcon name="'drag_indicator'" size="16"/>
                </span>
                <div t-att-class="policyMarkClass(pol)">
                  <WoowIcon name="policyMarkIcon(pol)" size="16"/>
                </div>
                <div class="o_woow_sa_policy__main">
                  <span class="o_woow_sa_policy__name" t-esc="pol.name"/>
                  <span class="o_woow_sa_policy__summary" t-esc="policySummary(pol)"/>
                </div>
                <span t-att-class="policyBadgeClass(pol)" t-esc="policyBadgeLabel(pol)"/>
                <div class="o_woow_sa_policy__actions">
                  <button class="o_woow_sa_icon_btn" title="Edit policy"
                          t-on-click="() => this.props.onEditPolicy(pol)">
                    <WoowIcon name="'edit'" size="16"/>
                  </button>
                  <button class="o_woow_sa_icon_btn" title="Delete policy"
                          t-on-click="() => this.props.onDeletePolicy(pol)">
                    <WoowIcon name="'delete'" size="16"/>
                  </button>
                </div>
              </div>
            </t>
          </div>
          <p t-else="" class="o_woow_sa_detail__hint">
            No policies yet — without any allow rule, no visitor passes.
          </p>
        </div>
        <div class="o_woow_sa_access__section o_woow_sa_access__session">
          <div class="o_woow_sa_access__label">
            <WoowIcon name="'schedule'" size="16"/>
            <span>Session Duration</span>
          </div>
          <select class="o_woow_input o_woow_sa_access__session_select"
                  t-on-change="(ev) => this.props.onSessionChange(ev.target.value)">
            <option value="30m" t-att-selected="props.config.session_duration === '30m'">30 minutes</option>
            <option value="1h" t-att-selected="props.config.session_duration === '1h'">1 hour</option>
            <option value="8h" t-att-selected="props.config.session_duration === '8h'">8 hours</option>
            <option value="24h" t-att-selected="props.config.session_duration === '24h'">24 hours</option>
            <option value="168h" t-att-selected="props.config.session_duration === '168h'">7 days</option>
          </select>
        </div>
      </div>

      <!-- 開啟保護前的確認（protectConfirm 有傳才會出現）。拍板 5：後果要在
           按下去之前就講清楚，不是事後才發現訪客全被擋在登入頁外面。 -->
      <div t-if="state.confirmingProtect and props.protectConfirm"
           class="o_woow_modal_backdrop">
        <div class="o_woow_modal">
          <div class="o_woow_modal_header">
            <h2 t-esc="props.protectConfirm.title"/>
          </div>
          <div class="o_woow_modal_body">
            <p t-esc="props.protectConfirm.message"/>
          </div>
          <div class="o_woow_modal_footer">
            <WoowButton variant="'secondary'" onClick.bind="cancelProtect">Cancel</WoowButton>
            <WoowButton variant="'primary'" onClick.bind="confirmProtect">
              <t t-esc="props.protectConfirm.confirmLabel"/>
            </WoowButton>
          </div>
        </div>
      </div>
    </div>
  </t>
</templates>
