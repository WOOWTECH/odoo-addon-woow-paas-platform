<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="woow_paas_platform.ServiceCard">
        <div t-att-class="cardClass" t-on-click="onClick">
            <!-- Card Header with Icon and Status -->
            <div class="o_woow_cloud_service_card_header">
                <div class="o_woow_cloud_service_icon">
                    <BrandIcon brand="brandKey" fallback="templateIcon" size="28" fill="true"/>
                </div>
                <StatusBadge status="props.service.state" phase="props.service.init_phase or ''" size="'sm'"/>
                <SubscriptionBadge subscription="props.service.subscription"/>
            </div>

            <!-- Card Body with Name and URL -->
            <div class="o_woow_cloud_service_card_body">
                <h3 class="o_woow_cloud_service_name" t-esc="props.service.name"/>
                <div class="o_woow_cloud_service_template">
                    <t t-esc="props.service.template?.name || 'Unknown'"/>
                </div>
                <t t-if="displayUrl">
                    <a
                        t-att-href="serviceUrl"
                        target="_blank"
                        class="o_woow_cloud_service_url"
                        t-on-click="onUrlClick">
                        <WoowIcon name="'link'" size="14"/>
                        <span t-esc="displayUrl"/>
                    </a>
                </t>
                <!-- #648 (b)：卡片上的網址在 state==='running' 時就是可點的，所以
                     這裡也要有預警，否則使用者從列表點進去一樣拿 NXDOMAIN 而畫面
                     零說明。判準用新欄位本身、**不**複用 error_message：後者在本
                     元件多判了 state==='error'，掛上去對 running 的服務不會顯示。
                     詳細文案在服務詳情頁，這裡只給一行。 -->
                <t t-if="props.service.public_url_dns_unverified">
                    <div class="o_woow_cloud_service_dns_hint">
                        <WoowIcon name="'schedule'" size="14"/>
                        <span>Public URL is not yet verified as resolvable — it may still be propagating</span>
                    </div>
                </t>
                <!-- #1647：服務顯示 running、但平台確認它沒有在執行（Pod 一顆都建不出來）。
                     狀態徽章仍是 running，這一行是卡片上唯一的訊號；詳細文案在詳情頁。 -->
                <t t-if="workloadFaultLabel">
                    <div class="o_woow_cloud_service_error">
                        <WoowIcon name="'error'" size="14"/>
                        <span t-esc="workloadFaultLabel"/>
                    </div>
                </t>
                <!-- #1159：init 失敗用與詳情頁相同的固定文案；原始 operator 錯誤
                     可能含 Pod 名稱或內部細節，只有非 init error 保留原行為。 -->
                <t t-if="initFailureText">
                    <div class="o_woow_cloud_service_error">
                        <WoowIcon name="'error'" size="14"/>
                        <span t-esc="initFailureText"/>
                    </div>
                </t>
                <t t-elif="props.service.state === 'error' and props.service.error_message">
                    <div class="o_woow_cloud_service_error">
                        <WoowIcon name="'error'" size="14"/>
                        <span t-esc="props.service.error_message"/>
                    </div>
                </t>
                <ResourceUsage observation="props.resourceObservation" compact="true"
                               loading="props.resourcesLoading" refreshFailed="props.resourcesRefreshFailed"
                               now="props.resourcesNow"/>
            </div>

            <!-- Card Actions -->
            <div class="o_woow_cloud_service_card_actions">
                <WoowButton
                    variant="'ghost'"
                    size="'sm'"
                    onClick.bind="openWebUI"
                    disabled="!isClickable">
                    <WoowIcon name="'open_in_new'" size="18"/>
                </WoowButton>
                <WoowButton
                    variant="'ghost'"
                    size="'sm'"
                    onClick.bind="openSettings">
                    <WoowIcon name="'settings'" size="18"/>
                </WoowButton>
            </div>
        </div>
    </t>
</templates>
