<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="woow_paas_platform.ChatGPTSubscriptionCard">
    <WoowCard class="'o_woow_info_card o_woow_chatgpt_card'">
      <div class="o_woow_card_header">
        <WoowIcon name="'smart_toy'" size="20"/>
        <h3>ChatGPT Subscription</h3>
        <span t-if="!state.loading and connected" class="o_woow_badge o_woow_badge_green">Connected</span>
        <span t-elif="!state.loading and state.status" class="o_woow_badge o_woow_badge_gray">Not connected</span>
      </div>

      <!-- 載入中 -->
      <div t-if="state.loading" class="o_woow_chatgpt_card__loading">
        <WoowIcon name="'sync'" size="18" class="'o_woow_spin'"/>
        <span>Checking the ChatGPT subscription...</span>
      </div>

      <!-- 狀態查不到：舊 chart（要重新部署）／平台尚未支援 → 只有說明；其他錯誤可重試 -->
      <t t-elif="state.error">
        <div class="o_woow_error_message o_woow_chatgpt_card__error">
          <WoowIcon name="'error'" size="16"/>
          <span t-esc="state.error"/>
        </div>
        <div t-if="canRetry" class="o_woow_chatgpt_card__actions">
          <WoowButton variant="'secondary'" size="'sm'" onClick="() => this.loadStatus()">
            <WoowIcon name="'refresh'" size="16"/>
            Retry
          </WoowButton>
        </div>
      </t>

      <!-- 已連接 -->
      <t t-elif="connected">
        <div class="o_woow_info_grid">
          <div class="o_woow_info_row">
            <span class="o_woow_info_label">Account</span>
            <span class="o_woow_info_value" t-esc="status.email or '—'"/>
          </div>
          <div class="o_woow_info_row">
            <span class="o_woow_info_label">Plan</span>
            <span class="o_woow_info_value" t-esc="planLabel"/>
          </div>
          <div class="o_woow_info_row" t-if="subscriptionUntil">
            <span class="o_woow_info_label">Subscription active until</span>
            <span class="o_woow_info_value" t-esc="subscriptionUntil"/>
          </div>
          <div class="o_woow_info_row">
            <span class="o_woow_info_label">Models</span>
            <span class="o_woow_info_value o_woow_chatgpt_card__models">
              <t t-if="!modelsKnown">Not available right now</t>
              <t t-elif="!models.length">None yet</t>
              <t t-else="">
                <code t-foreach="models" t-as="modelName" t-key="modelName" t-esc="modelName"/>
              </t>
            </span>
          </div>
          <div class="o_woow_info_row" t-if="tokenRenewal">
            <span class="o_woow_info_label">Access token valid until (renews automatically)</span>
            <span class="o_woow_info_value" t-esc="tokenRenewal"/>
          </div>
        </div>

        <p t-if="status.persisted === false" class="o_woow_hint o_woow_chatgpt_card__warn" t-esc="notSavedHint"/>
        <p t-if="modelsKnown and !models.length" class="o_woow_hint">Add the default models so your apps can call them by name (for example chatgpt/gpt-5.4).</p>

        <!-- 中斷連接要先確認 -->
        <div t-if="state.confirmDisconnect" class="o_woow_chatgpt_card__confirm">
          <p t-esc="disconnectWarning"/>
          <div class="o_woow_chatgpt_card__actions">
            <WoowButton variant="'secondary'" size="'sm'" onClick.bind="cancelDisconnect" disabled="isBusy">
              Cancel
            </WoowButton>
            <WoowButton variant="'primary'" size="'sm'" class="'o_woow_chatgpt_card__danger'" onClick.bind="disconnect" disabled="isBusy">
              <WoowIcon t-if="state.busy === 'disconnect'" name="'sync'" size="16" class="'o_woow_spin'"/>
              <WoowIcon t-else="" name="'link_off'" size="16"/>
              Disconnect
            </WoowButton>
          </div>
        </div>
        <div t-else="" class="o_woow_chatgpt_card__actions">
          <WoowButton variant="'secondary'" size="'sm'" onClick.bind="addDefaultModels" disabled="isBusy">
            <WoowIcon t-if="state.busy === 'add_models'" name="'sync'" size="16" class="'o_woow_spin'"/>
            <WoowIcon t-else="" name="'playlist_add'" size="16"/>
            Add default models
          </WoowButton>
          <WoowButton variant="'secondary'" size="'sm'" onClick.bind="testConnection" disabled="isBusy">
            <WoowIcon t-if="state.busy === 'test'" name="'sync'" size="16" class="'o_woow_spin'"/>
            <WoowIcon t-else="" name="'network_check'" size="16"/>
            Test connection
          </WoowButton>
          <WoowButton variant="'secondary'" size="'sm'" onClick.bind="connect" disabled="isBusy">
            <WoowIcon name="'autorenew'" size="16"/>
            Reconnect
          </WoowButton>
          <WoowButton variant="'ghost'" size="'sm'" onClick.bind="askDisconnect" disabled="isBusy">
            <WoowIcon name="'link_off'" size="16"/>
            Disconnect
          </WoowButton>
        </div>
      </t>

      <!-- 未連接 -->
      <t t-else="">
        <p class="o_woow_hint" t-esc="introText"/>
        <div t-if="pendingSignIn" class="o_woow_chatgpt_card__pending">
          <WoowIcon name="'hourglass_top'" size="16"/>
          <span t-esc="pendingHint"/>
        </div>
        <div class="o_woow_chatgpt_card__actions">
          <WoowButton t-if="pendingSignIn" variant="'primary'" size="'sm'" onClick.bind="continueSignIn">
            <WoowIcon name="'login'" size="16"/>
            Continue sign-in
          </WoowButton>
          <WoowButton variant="pendingSignIn ? 'secondary' : 'primary'" size="'sm'" onClick.bind="connect">
            <WoowIcon name="'link'" size="16"/>
            Connect ChatGPT subscription
          </WoowButton>
        </div>
      </t>

      <div t-if="state.notice" t-att-class="state.noticeIsError ? 'o_woow_error_message' : 'o_woow_chatgpt_card__notice'">
        <WoowIcon t-if="state.noticeIsError" name="'error'" size="16"/>
        <WoowIcon t-else="" name="'check_circle'" size="16"/>
        <span t-esc="state.notice"/>
      </div>
    </WoowCard>
  </t>
</templates>
