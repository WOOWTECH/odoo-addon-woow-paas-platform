<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="woow_paas_platform.SmartHomeDetailPage">
        <div class="o_woow_smart_home_detail">
            <!-- Loading State -->
            <t t-if="state.loading">
                <div class="o_woow_loading">
                    <WoowIcon name="'sync'" size="32" class="'o_woow_spin'"/>
                    <p>Loading smart home...</p>
                </div>
            </t>

            <!-- Error State -->
            <t t-elif="state.error">
                <div class="o_woow_error_state">
                    <WoowIcon name="'error'" size="48"/>
                    <h2>Unable to load smart home</h2>
                    <p t-esc="state.error"/>
                    <WoowButton variant="'primary'" size="'md'" onClick.bind="goBack">
                        <WoowIcon name="'arrow_back'" size="18"/>
                        Back to Workspace
                    </WoowButton>
                </div>
            </t>

            <!-- Smart Home Content -->
            <t t-elif="home">
                <!-- 麵包屑統一由全域 Header 呈現（見 SmartHomeDetailPage._publishBreadcrumb）-->

                <!-- Header Section -->
                <div class="o_woow_smart_home_detail_header">
                    <div class="o_woow_smart_home_detail_info">
                        <div class="o_woow_smart_home_detail_icon">
                            <BrandIcon brand="brandKey" fallback="'home_iot_device'" size="28" fill="true"/>
                        </div>
                        <div>
                            <div class="o_woow_smart_home_detail_title">
                                <h1 t-esc="home.name"/>
                                <StatusBadge status="home.state" size="'md'"/>
                            </div>
                            <t t-if="displayUrl">
                                <a
                                    t-att-href="routeUrl"
                                    target="_blank"
                                    class="o_woow_smart_home_route_url">
                                    <WoowIcon name="'link'" size="14"/>
                                    <span t-esc="displayUrl"/>
                                </a>
                            </t>
                        </div>
                    </div>
                    <div class="o_woow_smart_home_detail_actions">
                        <!-- Smart Home 開通重試：pending／error 才出現（判準見
                             canRetrySetup）。後端對已有 tunnel 的記錄走收斂、不重建，
                             所以重按安全；active 仍由後端 guard 拒絕。 -->
                        <WoowButton
                            t-if="canRetrySetup"
                            variant="'primary'"
                            size="'md'"
                            onClick.bind="retrySetup"
                            disabled="state.provisioning">
                            <t t-if="state.provisioning">
                                <WoowIcon name="'sync'" size="18" class="'o_woow_spin'"/>
                                Setting up...
                            </t>
                            <t t-elif="home.state === 'pending'">
                                <WoowIcon name="'play_arrow'" size="18"/>
                                Provision
                            </t>
                            <t t-else="">
                                <WoowIcon name="'restart_alt'" size="18"/>
                                Retry setup
                            </t>
                        </WoowButton>
                        <div t-if="home.provision_operation" class="o_woow_setup_operation_status">
                            <span t-if="home.provision_operation.phase === 'queued'">Setup is queued.</span>
                            <span t-elif="home.provision_operation.phase === 'create_unknown' || home.provision_operation.phase === 'recovery_required'">Setup needs confirmation before retry.</span>
                            <span t-elif="home.provision_operation.phase === 'converging'">Setting up...</span>
                        </div>
                        <div t-if="state.provisionError" class="o_woow_error_message">
                            <WoowIcon name="'error'" size="16"/>
                            <span t-esc="state.provisionError"/>
                        </div>
                        <WoowButton
                            t-if="isTrialActive and !requiresPaidActivation"
                            variant="'secondary'"
                            size="'md'"
                            onClick.bind="showSkipTrial">
                            <WoowIcon name="'skip_next'" size="18"/>
                            Skip Trial
                        </WoowButton>
                        <WoowButton
                            variant="'secondary'"
                            size="'md'"
                            onClick.bind="refreshStatus"
                            disabled="state.refreshing">
                            <t t-if="state.refreshing">
                                <WoowIcon name="'sync'" size="18" class="'o_woow_spin'"/>
                            </t>
                            <t t-else="">
                                <WoowIcon name="'refresh'" size="18"/>
                            </t>
                            Refresh
                        </WoowButton>
                        <!-- #524：refresh 被 owner/admin gate 擋下時要說出來。
                             原本這裡什麼都沒有，失敗被前端整個吞掉 ⇒ 按鈕看起來
                             只是沒反應，「被擋住」與「壞掉了」對使用者輸出相同。 -->
                        <div t-if="state.refreshError" class="o_woow_error_message">
                            <WoowIcon name="'error'" size="16"/>
                            <span t-esc="state.refreshError"/>
                        </div>
                        <WoowButton
                            variant="'secondary'"
                            size="'md'"
                            onClick.bind="showChangePlan">
                            <WoowIcon name="'mdi-swap-horizontal'" size="18"/>
                            <t t-if="requiresPaidActivation">選擇付費方案</t>
                            <t t-else="">變更方案</t>
                        </WoowButton>
                        <WoowButton
                            variant="'danger'"
                            size="'md'"
                            onClick.bind="showDeleteConfirm">
                            <WoowIcon name="'delete'" size="18"/>
                            Delete
                        </WoowButton>
                    </div>
                </div>

                <!-- 開通失敗的原因（error_message）。原本這一頁完全不顯示它：記錄落在
                     error 時租戶只看得到紅色 badge，不知道缺的是 DNS 還是 operator
                     連不上，也不知道可以重試。樣式沿用 ServiceDetailPage 的同名橫幅。 -->
                <div t-if="home.state === 'error' and home.error_message"
                     class="o_woow_service_error_banner">
                    <WoowIcon name="'error'" size="20"/>
                    <span t-esc="home.error_message"/>
                </div>

                <!-- Tab Navigation（#768）
                     骨架抄 ServiceDetailPage：header／modal 留在頁籤外（切到
                     Access 仍看得到自己在哪一台、仍按得到那幾顆動作），只有分頁
                     內容跟著切。 -->
                <div t-if="requiresPaidActivation" class="o_woow_trial_activation" role="status">
                    <WoowIcon name="'mdi-calendar-clock-outline'" size="24"/>
                    <div>
                        <strong t-if="subscription.trial_expired">七天試用已結束</strong>
                        <strong t-else="">七天免費試用</strong>
                        <p t-if="subscription.trial_expired">服務已到期暫停。選擇付費方案並完成付款後，即可繼續使用。</p>
                        <p t-else="">試用至 <t t-esc="formatDate(subscription.trial_end_date)"/>。到期後暫停服務，不會自動收費；你可以隨時選擇付費方案。</p>
                    </div>
                </div>
                <div class="o_woow_tabs">
                    <button
                        t-att-class="{'o_woow_tab': true, 'active': currentTab === 'overview'}"
                        t-on-click="() => this.setTab('overview')">
                        <WoowIcon name="'info'" size="18"/>
                        Overview
                    </button>
                    <!--
                        #768：Access 頁籤只給買了 AC 席位的方案（沿用 #746 設計
                        拍板 6：`ac_max_access_seats > 0` 才出現，無席位不顯示、
                        不做 upsell）。gate 走 hasAccessSeats getter，它讀的是後端
                        payload 的 subscription.ac_max_access_seats——能力判準收斂
                        到後端單一欄位（capability-gate-single-source-field），前端
                        不得自己算一份（模板／state／有沒有 route）。
                        守線：repo-lint check_access_tab_gate_anchor，它的錨點是
                        **字面** `setTab('access')`，所以這裡不可改寫成迴圈式的
                        switchTab(tab.key)——那樣寫 lint 會找不到頁籤而 fail-open，
                        能力 gate 漏掉時零訊號。
                        #1261：`or accessRecoveryMode`＝0 席但仍有 route 受保護時
                        照樣給頁籤（只能關保護，見該 getter）。hasAccessSeats 必須
                        留在表達式裡——lint 靠它追到 ac_max_access_seats。
                    -->
                    <button
                        t-if="hasAccessSeats or accessRecoveryMode"
                        t-att-class="{'o_woow_tab': true, 'active': currentTab === 'access'}"
                        t-on-click="() => this.setTab('access')">
                        <WoowIcon name="'shield'" size="18"/>
                        Access
                    </button>
                </div>

                <div class="o_woow_tab_content">
                <!-- ==================== Overview 分頁 ==================== -->
                <t t-if="currentTab === 'overview'">
                <!-- Subscription Info Panel -->
                <WoowCard t-if="subscription" shadow="true" class="'o_woow_subscription_info_card'">
                    <div class="o_woow_tunnel_info_header">
                        <WoowIcon name="'card_membership'" size="24"/>
                        <h2>Subscription</h2>
                        <span t-if="subscription.is_trial" class="o_woow_badge o_woow_badge_warning">Trial</span>
                    </div>
                    <div class="o_woow_tunnel_info_grid">
                        <div class="o_woow_tunnel_info_item">
                            <div class="o_woow_tunnel_info_label">
                                <WoowIcon name="'subscriptions'" size="16"/>
                                <span>Plan</span>
                            </div>
                            <div class="o_woow_tunnel_info_value">
                                <span t-esc="subscription.plan_name or 'N/A'"/>
                                <span class="o_woow_pay_label" t-if="subscription.plan_price">
                                    (<t t-esc="formattedPlanPrice"/>)
                                </span>
                            </div>
                        </div>
                        <div class="o_woow_tunnel_info_item" t-if="subscription.is_trial">
                            <div class="o_woow_tunnel_info_label">
                                <WoowIcon name="'event'" size="16"/>
                                <span>Trial Ends</span>
                            </div>
                            <div class="o_woow_tunnel_info_value">
                                <span t-esc="formatDate(subscription.trial_end_date)"/>
                            </div>
                        </div>
                        <div class="o_woow_tunnel_info_item">
                            <div class="o_woow_tunnel_info_label">
                                <WoowIcon name="'schedule_send'" size="16"/>
                                <span>Next Payment</span>
                            </div>
                            <div class="o_woow_tunnel_info_value">
                                <span t-if="requiresPaidActivation">選擇付費方案後才開始計費</span>
                                <span t-else="" t-esc="formatDate(subscription.next_payment)"/>
                            </div>
                        </div>
                    </div>
                </WoowCard>

                <!-- Tunnel Info Panel -->
                <WoowCard shadow="true" class="'o_woow_tunnel_info_card'">
                    <div class="o_woow_tunnel_info_header">
                        <WoowIcon name="'vpn_key'" size="24"/>
                        <h2>Tunnel Information</h2>
                    </div>
                    <!-- #1766：兩台機器接同一條 tunnel。放在 tunnel 資訊最上面，
                         因為此時下面的 Status 仍然顯示「已連線」，看起來一切正常。 -->
                    <div t-if="bindingConflict" class="alert alert-danger" role="alert">
                        <strong>Two machines are connected to this tunnel
                        (<t t-esc="connectorCount"/>).</strong>
                        The public address reaches whichever answers first, so about
                        half of all requests land on the wrong machine. Stop the Woow
                        PaaS integration on the machine that should not have this
                        smart home, then refresh the status.
                    </div>
                    <div class="o_woow_tunnel_info_grid">
                        <t t-foreach="tunnelInfo" t-as="item" t-key="item.label">
                            <div class="o_woow_tunnel_info_item">
                                <div class="o_woow_tunnel_info_label">
                                    <WoowIcon name="item.icon" size="16"/>
                                    <span t-esc="item.label"/>
                                </div>
                                <div class="o_woow_tunnel_info_value">
                                    <t t-if="item.isUrl">
                                        <a t-att-href="routeUrl" target="_blank" t-esc="item.value"/>
                                    </t>
                                    <t t-elif="item.isBadge">
                                        <StatusBadge status="item.value" size="'sm'"/>
                                    </t>
                                    <t t-else="">
                                        <span t-esc="item.value"/>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>
                </WoowCard>

                <!-- Connection Guide Section -->
                <WoowCard shadow="true" class="'o_woow_connection_guide'">
                    <div class="o_woow_connection_guide_header">
                        <WoowIcon name="'mdi-home-assistant'" size="24"/>
                        <h2>連結 Home Assistant</h2>
                    </div>
                    <p class="o_woow_guide_intro">從 Home Assistant 完成授權與服務選擇，woowtech 會自動設定連線。</p>
                    <div class="o_woow_connection_guide_content">
                        <div class="o_woow_guide_step">
                            <div class="o_woow_guide_step_number"><WoowIcon name="'mdi-puzzle-outline'" size="22"/></div>
                            <div class="o_woow_guide_step_content">
                                <h4>1. 安裝整合並選擇服務</h4>
                                <p>在 Home Assistant 安裝 PaaS Smart Home 整合，再到「設定 → 裝置與服務 → 新增整合」。選擇「遠端存取」或「遠端存取＋MCP」。</p>
                            </div>
                        </div>
                        <div class="o_woow_guide_step">
                            <div class="o_woow_guide_step_number"><WoowIcon name="'mdi-account-check-outline'" size="22"/></div>
                            <div class="o_woow_guide_step_content">
                                <h4>2. 登入 woowtech 並允許連結</h4>
                                <p>在授權頁登入你的帳號，閱讀權限後按「允許」。若使用 Home Assistant App，依畫面指示開啟授權網址並輸入代碼，完成後回到 App。</p>
                            </div>
                        </div>
                        <div class="o_woow_guide_step">
                            <div class="o_woow_guide_step_number"><WoowIcon name="'mdi-home-group'" size="22"/></div>
                            <div class="o_woow_guide_step_content">
                                <h4>3. 選擇工作區與對應服務</h4>
                                <p>有多個工作區時先選工作區，再從相應類型的服務中選擇。只有一個選項時會自動帶入。沒有工作區會建立「我的智慧家庭」；選定工作區中缺少服務時會自動建立，開啟七天試用。</p>
                                <p>若要連結這個服務，請選擇「<t t-esc="home.name"/>」。已綁定其他 HA 的服務需要先解除原本的綁定。</p>
                            </div>
                        </div>
                        <div class="o_woow_guide_step">
                            <div class="o_woow_guide_step_number"><WoowIcon name="'mdi-cloud-check-outline'" size="22"/></div>
                            <div class="o_woow_guide_step_content">
                                <h4>4. 等待開通並確認連線</h4>
                                <p>保留 HA 的設定畫面，等待服務準備完成，再完成裝置名稱與分區設定。回到這一頁重新整理連線狀態，確認已連線後，開啟上方的遠端網址。</p>
                                <p>「遠端存取＋MCP」還需要在 HA 安裝並啟用 ha_mcp_tools，才能提供 MCP 工具。</p>
                            </div>
                        </div>
                    </div>
                    <p class="o_woow_guide_trial_note"><WoowIcon name="'mdi-calendar-check-outline'" size="20"/>新建服務有七天試用；到期暫停，主動選擇付費方案後才續用。既有服務沿用原本的訂閱狀態。</p>
                </WoowCard>
                </t>

                <!-- ==================== Access 分頁（#768）====================
                     內容側同樣掛 hasAccessSeats：直接把 URL 打成 .../access 的人
                     不該因此拿到一個方案沒買的頁面（頁籤不見了、內容還在＝gate
                     只做了一半）。 -->
                <!-- t-key：開通／polling 在頁籤掛著時換掉 home ⇒ route 集合或
                     state 變了就重建頁籤，理由見 accessTabKey。 -->
                <!-- #1261：復原模式（0 席＋仍有 route 受保護）也掛內容，否則
                     /access 深連結一樣是空的；`seatless` 讓頁籤只剩「關保護」。 -->
                <SmartHomeAccessTab
                    t-if="currentTab === 'access' and (hasAccessSeats or accessRecoveryMode)"
                    t-key="accessTabKey"
                    home="home"
                    seatless="!hasAccessSeats"
                    workspaceId="props.workspaceId"/>
                </div>
            </t>

            <!-- Skip Trial Modal -->
            <SkipTrialModal
                t-if="state.showSkipTrialModal and home"
                service="home"
                loadEstimate="loadSmartHomeEstimate"
                confirmSkip="confirmSmartHomeSkip"
                onClose.bind="hideSkipTrial"
                onSkipped.bind="onTrialSkipped"/>

            <!-- Change Plan Modal（改方案／改席數，內嵌 PlanSelector） -->
            <ChangePlanModal
                t-if="state.showChangePlanModal and home"
                service="home"
                currentPlanId="home.subscription?.plan_id ?? undefined"
                activatingTrial="requiresPaidActivation"
                loadPlans="loadSmartHomePlans"
                confirmChange="confirmSmartHomeChangePlan"
                estimateChange="estimateSmartHomeChangePlan"
                onClose.bind="hideChangePlan"
                onChanged.bind="onPlanChanged"/>

            <!-- Delete Confirmation Modal -->
            <t t-if="state.showDeleteConfirm">
                <div class="o_woow_modal_backdrop" t-on-click="onDeleteBackdropClick">
                    <div class="o_woow_modal o_woow_modal_sm" t-on-click.stop="">
                        <div class="o_woow_modal_header">
                            <h2>Delete Smart Home</h2>
                            <button
                                class="o_woow_modal_close"
                                t-on-click="hideDeleteConfirm"
                                t-att-disabled="state.deleting">
                                <WoowIcon name="'close'" size="20"/>
                            </button>
                        </div>

                        <div class="o_woow_modal_body">
                            <div class="o_woow_delete_warning">
                                <WoowIcon name="'warning'" size="48"/>
                                <p>Are you sure you want to delete <strong t-esc="home.name"/>?</p>
                                <p class="o_woow_delete_hint">
                                    This will remove the tunnel configuration and all associated data.
                                    This action cannot be undone.
                                </p>
                            </div>

                            <div class="o_woow_form_group o_woow_confirm_input">
                                <label for="confirm_delete_name">
                                    Enter the name <strong t-esc="home.name"/> to confirm
                                </label>
                                <input
                                    type="text"
                                    id="confirm_delete_name"
                                    class="o_woow_input"
                                    t-att-placeholder="home.name"
                                    t-att-value="state.confirmName"
                                    t-on-input="onConfirmNameInput"
                                    t-att-disabled="state.deleting"
                                    autocomplete="off"
                                />
                            </div>

                            <div t-if="state.deleteError" class="o_woow_error_message">
                                <WoowIcon name="'error'" size="16"/>
                                <span t-esc="state.deleteError"/>
                            </div>
                        </div>

                        <div class="o_woow_modal_footer">
                            <WoowButton
                                variant="'secondary'"
                                size="'md'"
                                onClick.bind="hideDeleteConfirm"
                                disabled="state.deleting">
                                Cancel
                            </WoowButton>
                            <WoowButton
                                variant="'danger'"
                                size="'md'"
                                onClick.bind="onDeleteConfirm"
                                disabled="!canDelete or state.deleting">
                                <t t-if="state.deleting">
                                    <WoowIcon name="'sync'" size="18" class="'o_woow_spin'"/>
                                    Deleting...
                                </t>
                                <t t-else="">
                                    <WoowIcon name="'delete'" size="18"/>
                                    Delete Smart Home
                                </t>
                            </WoowButton>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
