<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="woow_paas_platform.ProfilePage">
        <div class="o_woow_profile_page">
            <div class="o_woow_page_header">
                <div class="o_woow_breadcrumb">
                    <a href="#/settings">Settings</a>
                    <span class="o_woow_breadcrumb_sep">›</span>
                    <span>Profile</span>
                </div>
                <h1>Profile</h1>
                <p>Edit your name, email, and phone number.</p>
            </div>

            <t t-if="state.saveSuccess">
                <div class="o_woow_success_banner" role="alert">
                    <WoowIcon name="'check_circle'" size="24"/>
                    <span>Profile saved.</span>
                </div>
            </t>

            <t t-if="state.serverError">
                <div class="o_woow_error_banner" role="alert">
                    <WoowIcon name="'error'" size="20"/>
                    <span t-esc="state.serverError"/>
                </div>
            </t>

            <t t-if="isLoading">
                <div class="o_woow_loading">Loading profile…</div>
            </t>

            <t t-else="">
                <WoowCard shadow="true" class="'o_woow_profile_card'">
                    <div class="o_woow_profile_header">
                        <div class="o_woow_profile_avatar">
                            <img t-if="avatarUrl" t-att-src="avatarUrl" alt=""/>
                        </div>
                        <div class="o_woow_profile_name" t-esc="displayName"/>
                    </div>

                    <div class="o_woow_profile_form">
                        <div class="o_woow_field">
                            <label for="profile_name">Name</label>
                            <input id="profile_name" type="text"
                                   t-model="state.form.name"
                                   t-att-aria-describedby="state.fieldErrors.name ? 'profile_name_error' : undefined"
                                   t-att-class="state.fieldErrors.name ? 'o_woow_input_error' : ''"/>
                            <t t-if="state.fieldErrors.name">
                                <div id="profile_name_error" class="o_woow_field_error" role="alert"
                                     t-esc="state.fieldErrors.name"/>
                            </t>
                        </div>

                        <div class="o_woow_field">
                            <label for="profile_email">Email</label>
                            <input id="profile_email" type="email"
                                   t-model="state.form.email"
                                   t-att-aria-describedby="state.fieldErrors.email ? 'profile_email_error' : undefined"
                                   t-att-class="state.fieldErrors.email ? 'o_woow_input_error' : ''"/>
                            <t t-if="state.fieldErrors.email">
                                <div id="profile_email_error" class="o_woow_field_error" role="alert"
                                     t-esc="state.fieldErrors.email"/>
                            </t>
                        </div>

                        <div class="o_woow_field">
                            <label for="profile_phone">Phone</label>
                            <input id="profile_phone" type="tel"
                                   t-model="state.form.phone"/>
                            <div class="o_woow_field_hint">
                                Any format accepted. ECPay binding will auto-strip spaces and dashes.
                            </div>
                        </div>

                        <div class="o_woow_profile_actions">
                            <WoowButton variant="'secondary'" size="'md'" onClick.bind="onCancel"
                                        disabled="state.saving">
                                Cancel
                            </WoowButton>
                            <WoowButton variant="'primary'" size="'md'" onClick.bind="onSave"
                                        disabled="state.saving">
                                <t t-if="state.saving">Saving…</t>
                                <t t-else="">Save</t>
                            </WoowButton>
                        </div>
                    </div>
                </WoowCard>

                <WoowCard shadow="true" class="'o_woow_profile_card'">
                    <div class="o_woow_profile_section_header">
                        <h2>Invoice Preference</h2>
                        <p>Used as the default carrier when issuing ECPay e-invoices for subscription
                            payments. You can still override per top-up at checkout.</p>
                    </div>

                    <t t-if="state.invoiceSaveSuccess">
                        <div class="o_woow_success_banner" role="alert">
                            <WoowIcon name="'check_circle'" size="24"/>
                            <span>Invoice preference saved.</span>
                        </div>
                    </t>

                    <t t-if="state.invoiceServerError">
                        <div class="o_woow_error_banner" role="alert">
                            <WoowIcon name="'error'" size="20"/>
                            <span t-esc="state.invoiceServerError"/>
                        </div>
                    </t>

                    <div class="o_woow_profile_form">
                        <div class="o_woow_field">
                            <label for="invoice_carrier_type">Carrier type</label>
                            <select id="invoice_carrier_type"
                                    t-model="state.invoiceForm.invoice_carrier_type">
                                <option value="email">Email carrier (ECPay)</option>
                                <option value="mobile">Mobile barcode</option>
                                <option value="citizen">Citizen digital cert</option>
                                <option value="triplicate">Triplicate (B2B)</option>
                                <option value="paper">Paper</option>
                                <option value="donation">Donation</option>
                            </select>
                        </div>

                        <t t-if="showCarrierNumber">
                            <div class="o_woow_field">
                                <label for="invoice_carrier">Carrier number</label>
                                <input id="invoice_carrier" type="text"
                                       t-model="state.invoiceForm.invoice_carrier"
                                       placeholder="e.g. /ABC+123 (mobile) or 16-char citizen ID"/>
                            </div>
                        </t>

                        <t t-if="showBusinessFields">
                            <div class="o_woow_field">
                                <label for="invoice_tax_id">Tax ID (統編)</label>
                                <input id="invoice_tax_id" type="text"
                                       t-model="state.invoiceForm.invoice_tax_id"
                                       placeholder="8-digit business tax ID"/>
                            </div>
                            <div class="o_woow_field">
                                <label for="invoice_title">Invoice title (抬頭)</label>
                                <input id="invoice_title" type="text"
                                       t-model="state.invoiceForm.invoice_title"
                                       placeholder="Defaults to your name if left blank"/>
                            </div>
                        </t>

                        <t t-if="showLovecode">
                            <div class="o_woow_field">
                                <label for="invoice_lovecode">Love code (愛心碼)</label>
                                <input id="invoice_lovecode" type="text"
                                       t-model="state.invoiceForm.invoice_lovecode"
                                       placeholder="3-7 digit organisation code"/>
                            </div>
                        </t>

                        <div class="o_woow_profile_actions">
                            <WoowButton variant="'secondary'" size="'md'" onClick.bind="onCancelInvoice"
                                        disabled="state.invoiceSaving">
                                Cancel
                            </WoowButton>
                            <WoowButton variant="'primary'" size="'md'" onClick.bind="onSaveInvoice"
                                        disabled="state.invoiceSaving">
                                <t t-if="state.invoiceSaving">Saving…</t>
                                <t t-else="">Save</t>
                            </WoowButton>
                        </div>
                    </div>
                </WoowCard>
            </t>
        </div>
    </t>
</templates>
