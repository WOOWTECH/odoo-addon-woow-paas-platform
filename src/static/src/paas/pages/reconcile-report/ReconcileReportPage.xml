<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="woow_paas_platform.ReconcileReportPage">
        <div class="o_woow_recon">
            <!-- Header -->
            <div class="o_woow_recon_header">
                <div class="o_woow_recon_header_text">
                    <a class="o_woow_recon_back" t-on-click="() => this.goBack()">
                        <WoowIcon name="'arrow_back'" size="18"/>
                        <span>Settings</span>
                    </a>
                    <h1 class="o_woow_recon_title">L4 Reverse Orphan Reconciliation Report</h1>
                    <p class="o_woow_recon_subtitle">
                        Dry-run read-only list · deletion stays in human hands
                        <t t-if="scannedAt"> · Scanned at <t t-esc="formatDateTime(scannedAt)"/></t>
                    </p>
                </div>
                <WoowButton variant="'secondary'" size="'md'"
                            onClick="() => this.refresh()" disabled="service.loading">
                    <WoowIcon name="'sync'" size="18" class="service.loading ? 'o_woow_spin' : ''"/>
                    Refresh
                </WoowButton>
            </div>

            <!-- Partial-scan warning -->
            <t t-if="isPartial">
                <div class="o_woow_recon_warning">
                    <WoowIcon name="'warning'" size="18"/>
                    <span>This scan is incomplete (list-all failed for one of the right-hand sets), so orphans may be under-reported — do not delete anything based on this list.</span>
                </div>
            </t>

            <!-- Loading -->
            <WoowCard t-if="loading" shadow="true">
                <div class="o_woow_recon_placeholder">
                    <WoowIcon name="'hourglass_top'" size="32"/>
                    <p>Loading...</p>
                </div>
            </WoowCard>

            <!-- Error -->
            <WoowCard t-elif="error" shadow="true">
                <div class="o_woow_recon_placeholder">
                    <WoowIcon name="'error_outline'" size="32"/>
                    <h3>Unable to load report</h3>
                    <p><t t-esc="error"/></p>
                </div>
            </WoowCard>

            <!-- Empty -->
            <WoowCard t-elif="isEmpty" shadow="true">
                <div class="o_woow_recon_empty">
                    <WoowIcon name="'task_alt'" size="48"/>
                    <p>No orphan candidates yet (or the cron has not run its first reconciliation).</p>
                </div>
            </WoowCard>

            <!-- Candidate list（含 reconcilable=false，no-silent-drop §C.4#7）-->
            <t t-else="">
                <t t-foreach="candidates" t-as="candidate" t-key="candidate.id">
                    <WoowCard shadow="true" class="'o_woow_recon_card'">
                        <div class="o_woow_recon_card_top">
                            <span class="o_woow_recon_kind"><t t-esc="candidate.kind"/></span>
                            <span class="o_woow_recon_name">
                                <!-- fallback 刻意寫成 t-if/t-else 的**文字節點**而不是
                                     `t-esc="x || '(unnamed)'"`：表達式裡的字串字面值
                                     QWeb 抽取器抽不到（`compileTEsc` 走 compileExpr、
                                     不呼叫 translateFn），會永遠停在英文（#107 W3）。 -->
                                <t t-if="candidate.name" t-esc="candidate.name"/>
                                <t t-else="">(unnamed)</t>
                            </span>
                            <span t-attf-class="o_woow_recon_env {{ envBadgeClass(candidate.env_hint) }}">
                                <t t-esc="candidate.env_hint"/>
                            </span>
                            <span t-attf-class="o_woow_recon_badge {{ reconcilableClass(candidate) }}">
                                <span class="o_woow_recon_badge_dot"/>
                                <t t-esc="reconcilableLabel(candidate)"/>
                            </span>
                        </div>
                        <div class="o_woow_recon_uid"><t t-esc="candidate.resource_uid"/></div>
                        <div class="o_woow_recon_reason"><t t-esc="candidate.reason"/></div>
                        <div class="o_woow_recon_card_footer">
                            <WoowButton variant="'ghost'" size="'sm'"
                                        onClick="() => this.reverify(candidate)"
                                        disabled="isReverifying(candidate)">
                                <t t-if="isReverifying(candidate)">
                                    <WoowIcon name="'sync'" size="16" class="'o_woow_spin'"/>
                                    Re-verifying...
                                </t>
                                <t t-else="">
                                    <WoowIcon name="'fact_check'" size="16"/>
                                    Re-verify Orphan Status
                                </t>
                            </WoowButton>
                            <t t-if="reverifyVerdict(candidate)">
                                <span t-attf-class="o_woow_recon_verdict {{ reverifyVerdict(candidate).error ? 'o_woow_recon_verdict_err' : (reverifyVerdict(candidate).still_orphan ? 'o_woow_recon_verdict_orphan' : 'o_woow_recon_verdict_gone') }}">
                                    <t t-if="reverifyVerdict(candidate).error">
                                        <t t-esc="reverifyVerdict(candidate).error"/>
                                    </t>
                                    <t t-elif="reverifyVerdict(candidate).still_orphan">
                                        Still an orphan (confirm again before deleting)
                                    </t>
                                    <t t-else="">
                                        No longer in the orphan list (it may have been reused by a new provision — do not delete)
                                    </t>
                                </span>
                            </t>
                        </div>
                    </WoowCard>
                </t>
            </t>
        </div>
    </t>
</templates>
