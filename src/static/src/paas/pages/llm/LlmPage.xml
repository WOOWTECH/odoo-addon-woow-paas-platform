<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="woow_paas_platform.LlmPage">
    <div class="o_woow_llm_page">
      <div class="o_woow_llm_page__header">
        <h1>AI Models</h1>
        <p t-esc="subtitle"/>
      </div>

      <section t-foreach="priceNotices.items" t-as="notice" t-key="notice.id"
               class="o_woow_llm_price_notice" t-att-aria-labelledby="'llm_price_notice_' + notice_index">
        <span class="o_woow_llm_price_notice__icon" aria-hidden="true"><i class="mdi mdi-information-outline"/></span>
        <div class="o_woow_llm_price_notice__text">
          <h2 t-att-id="'llm_price_notice_' + notice_index" t-esc="notice.title"/>
          <p t-esc="notice.body_text"/>
          <a href="#/llm/models" t-esc="priceNoticeModelsLabel"/>
        </div>
      </section>

      <!-- 子頁：平台既有的 .o_woow_tabs（手機可橫捲）；切換只改 hash（見 JS setTab）。
           是改網址的導覽、不是 ARIA tabs（見 JS 檔頭），所以用 nav＋aria-current，不用 role=tab。 -->
      <nav class="o_woow_tabs o_woow_llm_page__tabs" t-ref="tabs" t-att-aria-label="tabsLabel">
        <t t-foreach="tabs" t-as="tab" t-key="tab.id">
          <button type="button"
                  t-att-class="{'o_woow_tab': true, 'active': currentTab === tab.id}"
                  t-att-aria-current="currentTab === tab.id ? 'page' : false"
                  t-on-click="() => this.setTab(tab.id)">
            <WoowIcon name="tab.icon" size="18"/>
            <t t-esc="tab.label"/>
          </button>
        </t>
      </nav>

      <div class="o_woow_llm_page__content">
        <LlmOverviewTab t-if="currentTab === 'overview'" onOpenDocs.bind="openDocsWithKey"/>
        <LlmKeysTab t-elif="currentTab === 'keys'" onOpenDocs.bind="openDocsWithKey"/>
        <LlmUsageTab t-elif="currentTab === 'usage'"/>
        <LlmModelsTab t-elif="currentTab === 'models'"/>
        <LlmCreditTab t-elif="currentTab === 'credit'"/>
        <LlmDocsTab t-elif="currentTab === 'docs'" initialKey="docsKeyHandoff.peekKey()" initialMode="docsKeyHandoff.peekMode()" initialAllowedModels="docsKeyHandoff.peekAllowedModels()" onConsumeKey.bind="consumeDocsKey" baseUrl="docsBaseUrl"/>
        <div t-elif="!currentTabLive" class="o_woow_llm_page__soon">
          <WoowIcon name="'schedule'" size="32"/>
          <h3 t-esc="currentTabLabel"/>
          <p t-esc="comingSoonText"/>
        </div>
      </div>
      <div t-if="notMeState.confirmation" class="o_woow_modal_backdrop o_woow_llm_not_me_backdrop" role="presentation">
        <section class="o_woow_modal o_woow_llm_not_me" role="alertdialog" aria-modal="true" aria-labelledby="llm_not_me_title" aria-describedby="llm_not_me_description">
          <h2 id="llm_not_me_title">Report activity that was not yours?</h2>
          <p id="llm_not_me_description">Confirming will suspend your AI Models account and begin disabling its API keys. Keys may take a short time to stop working. Converted AI credit cannot be refunded.</p>
          <p t-if="notMeErrorText" role="alert" t-esc="notMeErrorText"/>
          <div class="o_woow_modal_footer">
            <button type="button" t-att-disabled="notMeState.busy" t-on-click="dismissNotMe">Cancel</button>
            <button type="button" t-if="notMeToken" t-att-disabled="notMeState.busy" t-on-click="confirmNotMe">
              <t t-if="notMeState.busy">Submitting…</t><t t-else="">Suspend account</t>
            </button>
          </div>
        </section>
      </div>
      <p t-if="notMeState.done" role="status">Your AI Models account has been suspended.</p>
    </div>
  </t>
</templates>
