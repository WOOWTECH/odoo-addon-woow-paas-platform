<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="woow_paas_platform.LlmKeysTab">
    <section class="o_woow_llm_keys">
      <header class="o_woow_llm_keys__heading">
        <div><h2 t-ref="keysHeading" tabindex="-1" t-esc="title"/><p>Manage paid API keys and review masked key details.</p></div>
        <WoowButton variant="'primary'" size="'md'" disabled="tosBlocking || state.busyKey !== null" onClick.bind="openCreate">Create paid key</WoowButton>
      </header>
      <p t-if="state.loading" role="status">Loading API keys…</p>
      <div t-if="tosBlocking" class="o_woow_llm_keys__error" role="status">
        <p id="o_woow_llm_keys_tos_help" t-esc="termsBlockedMessage"/>
        <WoowButton variant="'secondary'" size="'md'" onClick.bind="goToOverview"><t t-esc="termsBlockedActionLabel"/></WoowButton>
      </div>
      <div t-if="errorText" role="alert" class="o_woow_llm_keys__error">
        <p t-esc="errorText"/><WoowButton variant="'secondary'" onClick.bind="refresh">Retry</WoowButton>
      </div>
      <p t-if="state.notice" role="status" t-esc="state.notice"/>
      <p t-if="state.createError" role="alert" class="o_woow_llm_keys__error" t-esc="state.createError"/>
      <p t-if="state.actionError and !state.confirmation" role="alert" class="o_woow_llm_keys__error" t-esc="state.actionError"/>
      <p t-if="!state.loading &amp;&amp; !errorText &amp;&amp; !rows.length" class="o_woow_llm_keys__empty" t-esc="emptyText"/>
      <div t-if="rows.length" class="o_woow_llm_keys__desktop">
        <table>
          <thead><tr><th>Key</th><th>API key type</th><th>Status</th><th>Used / total</th><th>Last use</th><th>Expiry</th><th>Created</th><th>Actions</th></tr></thead>
          <tbody><tr t-foreach="rows" t-as="row" t-key="row.id">
            <td><strong t-esc="row.name"/><code t-esc="row.masked"/></td><td><span class="o_woow_llm_keys__chip" t-esc="row.kind"/></td>
            <td><span class="o_woow_llm_keys__chip" t-esc="row.statusLabel"/></td>
            <td><div t-if="row.limited" class="o_woow_llm_keys__usage"><progress t-att-max="row.progressMax" t-att-value="row.progressValue" t-att-aria-label="row.progressLabel"/><span><t t-esc="row.used"/> / <t t-esc="row.total"/></span></div><span t-else=""><t t-esc="row.used"/> used</span></td><td t-esc="row.lastUse"/>
            <td><t t-esc="row.expires"/><span t-if="row.expiring" class="o_woow_llm_keys__soon">Expiring soon</span></td>
            <td t-esc="row.created"/><td><div class="o_woow_llm_keys__actions">
              <button t-if="row.edit" type="button" t-att-disabled="state.busyKey !== null" t-on-click="() => this.edit(this.service.keys.find((key) => key.id === row.id))">Edit</button>
              <button t-if="row.extend" type="button" t-att-disabled="state.busyKey !== null" t-on-click="() => this.openConfirmation(this.service.keys.find((key) => key.id === row.id), 'extend')">Extend</button>
              <button t-if="row.disable" type="button" t-att-disabled="state.busyKey !== null" t-on-click="() => this.openConfirmation(this.service.keys.find((key) => key.id === row.id), 'disable')">Disable</button>
              <button t-if="row.enable || (row.status === 'disabled' and tosBlocking)" type="button" t-att-aria-describedby="tosBlocking ? 'o_woow_llm_keys_tos_help' : undefined" t-att-disabled="!row.enable || state.busyKey !== null" t-on-click="() => this.enable(this.service.keys.find((key) => key.id === row.id))">Enable</button>
              <button t-if="row.delete" type="button" t-att-disabled="state.busyKey !== null" t-on-click="() => this.openConfirmation(this.service.keys.find((key) => key.id === row.id), 'delete')">Delete</button>
            </div></td>
          </tr></tbody>
        </table>
      </div>
      <div t-if="rows.length" class="o_woow_llm_keys__mobile">
        <article t-foreach="rows" t-as="row" t-key="row.id" class="o_woow_llm_keys__card">
          <div class="o_woow_llm_keys__cardhead"><strong t-esc="row.name"/><span class="o_woow_llm_keys__chip" t-esc="row.statusLabel"/></div>
          <code t-esc="row.masked"/><p><span class="o_woow_llm_keys__chip" t-esc="row.kind"/><span t-if="row.expiring" class="o_woow_llm_keys__soon">Expiring soon</span></p>
          <dl><div><dt>Used / total</dt><dd><div t-if="row.limited" class="o_woow_llm_keys__usage"><progress t-att-max="row.progressMax" t-att-value="row.progressValue" t-att-aria-label="row.progressLabel"/><span><t t-esc="row.used"/> / <t t-esc="row.total"/></span></div><span t-else=""><t t-esc="row.used"/> used</span></dd></div>
            <div><dt>Last use</dt><dd t-esc="row.lastUse"/></div><div><dt>Expiry</dt><dd t-esc="row.expires"/></div><div><dt>Created</dt><dd t-esc="row.created"/></div></dl>
          <div class="o_woow_llm_keys__actions">
            <button t-if="row.edit" type="button" t-att-disabled="state.busyKey !== null" t-on-click="() => this.edit(this.service.keys.find((key) => key.id === row.id))">Edit</button>
            <button t-if="row.extend" type="button" t-att-disabled="state.busyKey !== null" t-on-click="() => this.openConfirmation(this.service.keys.find((key) => key.id === row.id), 'extend')">Extend</button>
            <button t-if="row.disable" type="button" t-att-disabled="state.busyKey !== null" t-on-click="() => this.openConfirmation(this.service.keys.find((key) => key.id === row.id), 'disable')">Disable</button>
            <button t-if="row.enable || (row.status === 'disabled' and tosBlocking)" type="button" t-att-aria-describedby="tosBlocking ? 'o_woow_llm_keys_tos_help' : undefined" t-att-disabled="!row.enable || state.busyKey !== null" t-on-click="() => this.enable(this.service.keys.find((key) => key.id === row.id))">Enable</button>
            <button t-if="row.delete" type="button" t-att-disabled="state.busyKey !== null" t-on-click="() => this.openConfirmation(this.service.keys.find((key) => key.id === row.id), 'delete')">Delete</button>
          </div>
        </article>
      </div>
      <LlmKeyFormModal t-if="state.showForm" keyItem="state.editKey" onClose.bind="closeForm" onDraft.bind="onDraft" onUpdate.bind="saveEdit"/>
      <LlmKeyRevealModal t-if="state.showReveal" kind="'paid'" allowedModels="paidModelAllowlist" models="state.pendingDraft.models" baseUrl="paidBaseUrl" createKey.bind="createPendingPaidKey" onClose.bind="onRevealClosed" onOpenDocs.bind="props.onOpenDocs"/>
      <LlmKeyActionConfirmModal t-if="state.confirmation" item="state.confirmation.item" action="state.confirmation.action" busy="state.busyKey !== null" errorText="state.actionError || ''" onClose.bind="closeConfirmation" onConfirm.bind="confirmAction" onReturnFocus.bind="focusKeysHeading"/>
    </section>
  </t>
</templates>
