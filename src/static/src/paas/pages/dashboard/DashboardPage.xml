<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="woow_paas_platform.DashboardPage">
        <div class="o_woow_dashboard">
            <!-- Welcome Section -->
            <div class="o_woow_welcome">
                <h1>Welcome back, <t t-esc="welcomeName"/>!</h1>
                <p>Here is what is happening with your workspaces today.</p>
            </div>

            <!-- Loading state -->
            <WoowCard t-if="loading" shadow="true" class="'o_woow_dashboard_placeholder'">
                <div class="o_woow_placeholder_content">
                    <WoowIcon name="'hourglass_top'" size="32"/>
                    <p>Loading dashboard...</p>
                </div>
            </WoowCard>

            <!-- Error state -->
            <WoowCard t-elif="error" shadow="true" class="'o_woow_dashboard_placeholder'">
                <div class="o_woow_placeholder_content">
                    <WoowIcon name="'error_outline'" size="32"/>
                    <h3>Could not load dashboard</h3>
                    <p><t t-esc="error"/></p>
                </div>
            </WoowCard>

            <!-- Loaded state -->
            <t t-else="">
                <!-- Stats Grid -->
                <div class="o_woow_stats_grid">
                    <t t-foreach="statCards" t-as="stat" t-key="stat.label">
                        <WoowCard shadow="true" class="'o_woow_stat_card'">
                            <div class="o_woow_stat_header">
                                <div t-att-class="'o_woow_stat_icon o_woow_stat_icon_' + (stat.color || 'default')">
                                    <WoowIcon name="stat.icon" size="24"/>
                                </div>
                                <div class="o_woow_stat_titles">
                                    <span class="o_woow_stat_label"><t t-esc="stat.label"/></span>
                                    <span t-if="stat.subtitle" class="o_woow_stat_subtitle"><t t-esc="stat.subtitle"/></span>
                                </div>
                            </div>
                            <div class="o_woow_stat_items">
                                <t t-foreach="stat.items" t-as="item" t-key="item.label">
                                    <div t-att-class="'o_woow_stat_item' + (item.highlight ? ' highlight' : '')">
                                        <span class="o_woow_item_label"><t t-esc="item.label"/></span>
                                        <span class="o_woow_item_value">
                                            <t t-esc="item.value"/>
                                        </span>
                                    </div>
                                </t>
                            </div>
                        </WoowCard>
                    </t>
                </div>

                <!-- Recent Activity -->
                <div class="o_woow_dashboard_grid">
                    <WoowCard class="'o_woow_activity_card'">
                        <h3>Recent Activity</h3>
                        <div t-if="!activities.length" class="o_woow_activity_empty">
                            <p>No recent activity yet. Top-ups and subscription charges will appear here.</p>
                        </div>
                        <div t-else="" class="o_woow_activity_list">
                            <t t-foreach="activities" t-as="activity" t-key="activity_index">
                                <div class="o_woow_activity_item">
                                    <span class="o_woow_activity_time">
                                        <t t-esc="formatActivityTime(activity.ts)"/>
                                    </span>
                                    <div class="o_woow_activity_avatar">
                                        <t t-esc="initialsFor(activity.actor)"/>
                                    </div>
                                    <div class="o_woow_activity_content">
                                        <span class="o_woow_activity_user"><t t-esc="activity.actor"/></span>
                                        <span class="o_woow_activity_action"> <t t-esc="activity.action.replaceAll('_', ' ')"/> </span>
                                        <span class="o_woow_activity_target"><t t-esc="activity.target"/></span>
                                        <div t-if="activity.description" class="o_woow_activity_description">
                                            <t t-esc="activity.description"/>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </WoowCard>
                </div>
            </t>
        </div>
    </t>
</templates>
