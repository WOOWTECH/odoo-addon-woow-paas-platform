<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="woow_paas_platform.AddonsTab">
        <div class="o_woow_addons_tab">
            <!-- Header with Edit Button -->
            <div class="o_woow_config_header">
                <div class="o_woow_config_title">
                    <WoowIcon name="'extension'" size="24"/>
                    <h3>Odoo Addons</h3>
                </div>
                <div class="o_woow_config_actions">
                    <t t-if="!state.editing">
                        <WoowButton
                            t-if="canEdit"
                            variant="'secondary'"
                            size="'md'"
                            onClick.bind="startEditing">
                            <WoowIcon name="'edit'" size="18"/>
                            Edit Selection
                        </WoowButton>
                    </t>
                    <t t-else="">
                        <WoowButton
                            variant="'secondary'"
                            size="'md'"
                            onClick.bind="cancelEditing">
                            Cancel
                        </WoowButton>
                        <WoowButton
                            variant="'primary'"
                            size="'md'"
                            onClick.bind="saveAddons"
                            disabled="!hasChanges or state.saving or state.checking">
                            <t t-if="state.checking">
                                <WoowIcon name="'sync'" size="18" class="'o_woow_spin'"/>
                                Checking...
                            </t>
                            <t t-elif="state.saving">
                                <WoowIcon name="'sync'" size="18" class="'o_woow_spin'"/>
                                Saving...
                            </t>
                            <t t-else="">
                                <WoowIcon name="'save'" size="18"/>
                                Save Changes
                            </t>
                        </WoowButton>
                    </t>
                </div>
            </div>

            <!-- Error Message -->
            <div t-if="state.error" class="o_woow_error_message">
                <WoowIcon name="'error'" size="18"/>
                <span t-esc="state.error"/>
            </div>

            <!-- Upgrading Notice -->
            <div t-if="props.service.state === 'upgrading'" class="o_woow_upgrade_notice">
                <WoowIcon name="'sync'" size="18" class="'o_woow_spin'"/>
                <span>Service is upgrading. Addon changes are disabled until the upgrade completes.</span>
            </div>

            <!-- View Mode -->
            <t t-if="!state.editing">
                <WoowCard class="'o_woow_config_card'">
                    <t t-if="currentAddons.length === 0">
                        <div class="o_woow_config_empty">
                            <WoowIcon name="'extension'" size="32"/>
                            <p>No addons selected for this service.</p>
                            <WoowButton
                                t-if="canEdit"
                                variant="'secondary'"
                                size="'sm'"
                                onClick.bind="startEditing">
                                <WoowIcon name="'add'" size="18"/>
                                Add Addons
                            </WoowButton>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="o_woow_addons_list">
                            <t t-foreach="currentAddons" t-as="addon" t-key="addon.id">
                                <div class="o_woow_addon_item">
                                    <WoowIcon name="'check_circle'" size="18"/>
                                    <span class="o_woow_addon_name" t-esc="addon.name"/>
                                    <span class="o_woow_addon_tech" t-esc="addon.technical_name"/>
                                </div>
                            </t>
                        </div>
                        <div class="o_woow_addons_count">
                            <t t-esc="currentAddons.length"/> addon(s) selected
                        </div>
                        <!-- 勾選只讓模組「可用」（複製進 addons_path）、不會自動安裝：提示下一步，並直達 Odoo 應用程式。 -->
                        <div class="o_woow_editor_hint">
                            <WoowIcon name="'info'" size="16"/>
                            <span>Selected addons are available in Odoo Apps. Install them there before using them.</span>
                        </div>
                        <WoowButton
                            t-if="odooAppsUrl"
                            variant="'secondary'"
                            size="'sm'"
                            onClick.bind="openOdooApps">
                            <WoowIcon name="'open_in_new'" size="18"/>
                            Open Odoo Apps
                        </WoowButton>
                    </t>
                </WoowCard>
            </t>

            <!-- Edit Mode -->
            <t t-if="state.editing">
                <WoowCard class="'o_woow_config_card'">
                    <div class="o_woow_config_editor">
                        <div class="o_woow_editor_hint">
                            <WoowIcon name="'info'" size="16"/>
                            <span>Choose which addons to make available on this Odoo instance. Selecting an addon does not install it: after the service finishes redeploying, install it from Odoo Apps. Changes will trigger a service upgrade.</span>
                        </div>
                        <OdooAddonSelector
                            templateId="props.service.template.id"
                            selectedIds="state.selectedIds"
                            onSelectionChange.bind="onSelectionChange"/>
                    </div>
                </WoowCard>
            </t>
            <!-- Addon Removal Dialog -->
            <AddonRemovalDialog
                t-if="state.showDialog"
                modules="state.dialogModules"
                odooAppsUrl="odooAppsUrl"
                onClose.bind="closeDialog"/>
        </div>
    </t>
</templates>
