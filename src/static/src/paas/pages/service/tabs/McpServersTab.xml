<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="woow_paas_platform.McpServersTab">
        <div class="o_woow_mcp_tab o_woow_mcp_tab--redirect">
            <WoowCard class="'o_woow_mcp_redirect_card'">
                <div class="o_woow_mcp_redirect">
                    <WoowIcon name="'extension'" size="48"/>
                    <t t-if="state.loading">
                        <p>Locating Project Detail...</p>
                    </t>
                    <t t-elif="state.boundProjectId">
                        <h3>Manage MCP Servers from Project Detail</h3>
                        <p>
                            MCP servers are now managed under Project Detail
                            (project is the single source of truth — MCP is bound
                            to projects, not cloud services).
                        </p>
                        <!-- #275：flag OFF 隱藏（MCP-via-project 入口一併不可達，intended） -->
                        <t t-if="projectsVisible">
                            <WoowButton variant="'primary'" size="'md'"
                                        onClick.bind="goToProjectSettings">
                                <WoowIcon name="'arrow_forward'" size="18"/>
                                Go to Project Settings
                            </WoowButton>
                        </t>
                    </t>
                    <t t-else="">
                        <h3>No Project Bound to This Service</h3>
                        <p>
                            This service has no bound project. Create or bind a
                            project from the Projects list, then manage MCP
                            servers from Project Detail.
                        </p>
                    </t>
                </div>
            </WoowCard>
        </div>
    </t>
</templates>
