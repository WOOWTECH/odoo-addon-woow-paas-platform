<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="woow_paas_platform.ConfigurationTab">
        <div class="o_woow_configuration_tab">
            <!-- Header with Edit Button -->
            <div class="o_woow_config_header">
                <div class="o_woow_config_title">
                    <WoowIcon name="'tune'" size="24"/>
                    <h3>Helm Values Configuration</h3>
                </div>
                <div class="o_woow_config_actions">
                    <t t-if="!state.editing">
                        <WoowButton
                            t-if="canEdit"
                            variant="'secondary'"
                            size="'md'"
                            onClick.bind="startEditing">
                            <WoowIcon name="'edit'" size="18"/>
                            Edit Configuration
                        </WoowButton>
                    </t>
                    <t t-else="">
                        <WoowButton
                            variant="'secondary'"
                            size="'md'"
                            onClick.bind="cancelEditing">
                            Cancel
                        </WoowButton>
                        <WoowButton
                            variant="'primary'"
                            size="'md'"
                            onClick.bind="saveChanges">
                            <t t-if="state.saving">
                                <WoowIcon name="'sync'" size="18" class="'o_woow_spin'"/>
                                Saving...
                            </t>
                            <t t-else="">
                                <WoowIcon name="'save'" size="18"/>
                                Save Changes
                            </t>
                        </WoowButton>
                    </t>
                </div>
            </div>

            <!-- Error Message -->
            <div t-if="state.error" class="o_woow_error_message">
                <WoowIcon name="'error'" size="18"/>
                <span t-esc="state.error"/>
            </div>

            <!-- Upgrading Notice -->
            <div t-if="props.service.state === 'upgrading'" class="o_woow_upgrade_notice">
                <WoowIcon name="'sync'" size="18" class="'o_woow_spin'"/>
                <span>Service is upgrading. Configuration changes are disabled until the upgrade completes.</span>
            </div>

            <!-- View Mode -->
            <t t-if="!state.editing">
                <WoowCard class="'o_woow_config_card'">
                    <t t-if="displaySpecs.length === 0">
                        <div class="o_woow_config_empty">
                            <WoowIcon name="'settings'" size="32"/>
                            <p>No configurable settings for this service.</p>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="o_woow_config_list">
                            <t t-foreach="displaySpecs" t-as="spec" t-key="spec.key">
                                <div class="o_woow_config_item">
                                    <span class="o_woow_config_key">
                                        <t t-esc="spec.label || spec.key"/>
                                        <!-- #1561：只在開通時生效的設定，唯讀並說明原因。 -->
                                        <small t-if="isCreateOnlySpec(spec)" class="o_woow_config_create_only">Set when the service was created; it cannot be changed afterwards.</small>
                                        <!-- INFRA-TS-004-1：條件下會被 chart 略過、卻存了值的欄位。 -->
                                        <small t-if="ignoredWhenViewNote(spec)" class="o_woow_config_create_only"><t t-esc="ignoredWhenViewNote(spec)"/></small>
                                    </span>
                                    <span t-att-class="'o_woow_config_value' + (spec.type === 'password' ? ' o_woow_secret' : '')">
                                        <t t-esc="formatSpecValue(spec)"/>
                                    </span>
                                </div>
                            </t>
                        </div>
                        <!-- #1479：改管理員密碼不在這裡——指向頁首的按鈕（名稱隨模板能力不同）。 -->
                        <p t-if="adminPasswordEntry === 'credentials'" class="o_woow_config_create_only">
                            To change the administrator password, use Admin Credentials at the top of this page.
                        </p>
                        <p t-if="adminPasswordEntry === 'reset'" class="o_woow_config_create_only">
                            To change the administrator password, use Reset Admin Password at the top of this page.
                        </p>
                    </t>
                </WoowCard>
            </t>

            <!-- Edit Mode -->
            <t t-if="state.editing">
                <WoowCard class="'o_woow_config_card'">
                    <div class="o_woow_config_editor">
                        <div class="o_woow_editor_hint">
                            <WoowIcon name="'info'" size="16"/>
                            <span>Modify configuration values below. Changes will trigger a service upgrade.</span>
                        </div>
                        <!-- #1435：改金鑰／密碼後服務會重新啟動，新值才會生效。 -->
                        <div t-if="hasSecretSpecs" class="o_woow_editor_hint">
                            <WoowIcon name="'restart_alt'" size="16"/>
                            <span>Changing or clearing an API key or password restarts the service after saving (about a minute) so the new value takes effect; work in progress will be interrupted.</span>
                        </div>
                        <HelmValueForm
                            specs="configurableSpecs"
                            values="state.editedValues"
                            onUpdate.bind="onHelmValueUpdate"
                            showAdvanced="state.showAdvanced"
                            errors="state.errors"
                            passwordBlankMeansUnchanged="true"
                        />
                        <!-- #1455：清除已設定的金鑰（留空＝不變更，清除是另一個顯式動作）。 -->
                        <div t-if="clearableSecretSpecs.length" class="o_woow_config_clear_secrets">
                            <div class="o_woow_config_clear_secrets__title">Clear saved keys</div>
                            <t t-foreach="clearableSecretSpecs" t-as="spec" t-key="spec.key">
                                <label class="o_woow_config_clear_secrets__item">
                                    <input
                                        type="checkbox"
                                        t-att-checked="isClearChecked(spec)"
                                        t-on-change="() => this.toggleClear(spec)"/>
                                    <span>Clear <t t-esc="spec.label || spec.key"/></span>
                                </label>
                            </t>
                        </div>
                        <t t-if="hasOptionalSettings">
                            <button
                                type="button"
                                class="o_woow_advanced_toggle"
                                t-on-click="toggleAdvanced"
                            >
                                <WoowIcon
                                    t-if="state.showAdvanced"
                                    name="'expand_less'"
                                    size="18"
                                />
                                <WoowIcon
                                    t-else=""
                                    name="'expand_more'"
                                    size="18"
                                />
                                <t t-if="state.showAdvanced">Hide Advanced Settings</t>
                                <t t-else="">Show Advanced Settings</t>
                            </button>
                        </t>
                    </div>
                </WoowCard>
            </t>

            <!-- Chart Info -->
            <WoowCard class="'o_woow_config_info_card'">
                <div class="o_woow_config_info_header">
                    <WoowIcon name="'info'" size="18"/>
                    <h4>Configuration Reference</h4>
                </div>
                <div class="o_woow_config_info_content">
                    <p>
                        <strong>Chart:</strong>
                        <t t-esc="props.service.template?.name || 'Unknown'"/>
                        <t t-if="props.service.helm_chart_version">
                            <span class="o_woow_version_badge" t-esc="props.service.helm_chart_version"/>
                        </t>
                    </p>
                    <p t-if="props.service.template?.documentation_url">
                        <a t-att-href="props.service.template.documentation_url" target="_blank" rel="noopener noreferrer">
                            View Documentation
                            <WoowIcon name="'open_in_new'" size="14"/>
                        </a>
                    </p>
                </div>
            </WoowCard>
        </div>
    </t>
</templates>
