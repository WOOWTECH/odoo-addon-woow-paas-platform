<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="woow_paas_platform.OverviewTab">
        <div class="o_woow_overview_tab">
            <ResourceUsage observation="props.resourceObservation" loading="props.resourcesLoading"
                           refreshFailed="props.resourcesRefreshFailed" now="props.resourcesNow"/>
            <!-- #1454：方案與帳期。雲端服務詳情頁原本只有「Skip Trial」按鈕，看不到試用
                 到期日與何時開始扣款（Smart Home 詳情頁早就有）。試用中的訂閱 start_date
                 是「試用結束隔天」＝首個計費日（subscription_lifecycle_mixin），所以這裡
                 標成 First Billing Date，不叫「開始日期」。 -->
            <WoowCard t-if="subscription" class="'o_woow_info_card'">
                <div class="o_woow_card_header">
                    <WoowIcon name="'card_membership'" size="20"/>
                    <h3>Plan &amp; Billing</h3>
                    <span t-if="subscription.is_trial" class="o_woow_badge o_woow_badge_blue">Trial</span>
                </div>
                <div class="o_woow_info_grid">
                    <div class="o_woow_info_row">
                        <span class="o_woow_info_label">Plan</span>
                        <span class="o_woow_info_value">
                            <t t-esc="subscription.plan_name or '—'"/>
                            <t t-if="subscription.plan_price"> (<t t-esc="formattedPlanPrice"/>)</t>
                        </span>
                    </div>
                    <t t-if="subscription.is_trial">
                        <div class="o_woow_info_row" t-if="subscription.trial_end_date">
                            <span class="o_woow_info_label">Trial Ends</span>
                            <span class="o_woow_info_value" t-esc="formatDate(subscription.trial_end_date)"/>
                        </div>
                        <div class="o_woow_info_row" t-if="firstBillingDate">
                            <span class="o_woow_info_label">First Billing Date</span>
                            <span class="o_woow_info_value" t-esc="formatDate(firstBillingDate)"/>
                        </div>
                    </t>
                    <div class="o_woow_info_row" t-elif="subscription.next_payment">
                        <span class="o_woow_info_label">Next Payment</span>
                        <span class="o_woow_info_value" t-esc="formatDate(subscription.next_payment)"/>
                    </div>
                </div>
            </WoowCard>

            <!-- INFRA-FIX-005：VPN 節點狀態。pod Ready ≠ 節點在線（節點被控制面到期／刪除後 pod 仍 Ready、
                 平台 state 仍是 running），所以這張卡即時問 operator（唯讀 exec 進 tailscaled）：登入狀態、
                 登入說明、每個轉發有沒有生效、被略過的項目與原因。Gate 讀 has_vpn_node_status（能力的唯一
                 事實源是 cloud_app_template 的同名欄位；前端不得用 slug 判斷，repo-lint capability-gate）。
                 讀不到（pod 起來中、operator 太舊）時不顯示錯誤，只顯示說明。 -->
            <WoowCard t-if="props.service.has_vpn_node_status and (vpnReport or vpn.state.loading)" class="'o_woow_info_card o_woow_vpn_node_card'">
                <div class="o_woow_card_header">
                    <WoowIcon name="'vpn_lock'" size="20"/>
                    <h3 t-esc="vpnCardTitle"/>
                </div>
                <div class="o_woow_info_grid" t-if="vpnReport">
                    <div class="o_woow_info_row">
                        <span class="o_woow_info_label" t-esc="vpnStateRowLabel"/>
                        <span class="o_woow_info_value">
                            <span t-att-class="'o_woow_vpn_state o_woow_vpn_state_' + vpnStateTone" t-esc="vpnStateLabel"/>
                            <small class="o_woow_vpn_hint text-muted d-block" t-if="vpnStateHint" t-esc="vpnStateHint"/>
                            <small class="o_woow_vpn_hint o_woow_vpn_login_error d-block" t-if="vpnLoginError" t-esc="vpnLoginError"/>
                            <small class="o_woow_vpn_hint text-muted d-block" t-if="vpnAuthKeyNotice" t-esc="vpnAuthKeyNotice"/>
                        </span>
                    </div>
                    <div class="o_woow_info_row" t-if="vpnLoginGuidance.length">
                        <span class="o_woow_info_label"/>
                        <span class="o_woow_info_value o_woow_vpn_login">
                            <t t-foreach="vpnLoginGuidance" t-as="line" t-key="line_index">
                                <small t-if="line.kind === 'text'" class="d-block" t-esc="line.text"/>
                                <small t-elif="line.kind === 'link'" class="d-block">
                                    <a t-att-href="line.url" target="_blank" rel="noopener noreferrer">
                                        <t t-esc="line.text"/>
                                        <WoowIcon name="'open_in_new'" size="14"/>
                                    </a>
                                </small>
                                <small t-else="" class="d-block">
                                    <t t-esc="line.text"/>: <code t-esc="line.code"/>
                                </small>
                            </t>
                        </span>
                    </div>
                    <div class="o_woow_info_row" t-if="vpnTailnetAddress">
                        <span class="o_woow_info_label" t-esc="vpnAddressRowLabel"/>
                        <span class="o_woow_info_value"><code t-esc="vpnTailnetAddress"/></span>
                    </div>
                    <div class="o_woow_info_row">
                        <span class="o_woow_info_label" t-esc="vpnForwardsRowLabel"/>
                        <span class="o_woow_info_value">
                            <small class="text-muted" t-if="!vpnForwardRows.length" t-esc="vpnNoForwardsText"/>
                            <ul class="o_woow_vpn_forwards" t-if="vpnForwardRows.length">
                                <li t-foreach="vpnForwardRows" t-as="row" t-key="row.key"
                                    t-att-class="'o_woow_vpn_forward o_woow_vpn_forward_' + row.tone">
                                    <code t-esc="row.label"/>
                                    <small class="d-block" t-esc="row.status"/>
                                </li>
                            </ul>
                        </span>
                    </div>
                </div>
                <small class="text-muted" t-else="" t-esc="vpnLoadingText"/>
            </WoowCard>

            <!-- Connection Info Card -->
            <WoowCard class="'o_woow_info_card'">
                <div class="o_woow_card_header">
                    <WoowIcon name="'link'" size="20"/>
                    <h3>Connection Info</h3>
                </div>
                <div class="o_woow_info_grid">
                    <!-- Status -->
                    <div class="o_woow_info_row">
                        <span class="o_woow_info_label">Status</span>
                        <!-- #1456：升級／重新部署期間舊版本仍在服務，原本一律顯示 OFFLINE，
                             客戶以為服務壞了。判準見 connectionStatus。 -->
                        <span t-att-class="'o_woow_info_value o_woow_connection_status ' + connectionStatus">
                            <span class="o_woow_status_indicator"/>
                            <t t-if="connectionStatus === 'online'">ONLINE</t>
                            <t t-elif="connectionStatus === 'updating'">UPDATING</t>
                            <t t-else="">OFFLINE</t>
                        </span>
                    </div>

                    <!-- Public URL -->
                    <div class="o_woow_info_row" t-if="publicUrl">
                        <span class="o_woow_info_label">Public URL</span>
                        <span class="o_woow_info_value o_woow_info_copyable">
                            <a t-att-href="publicUrl" target="_blank" rel="noopener noreferrer">
                                <t t-esc="publicUrl"/>
                                <WoowIcon name="'open_in_new'" size="14"/>
                            </a>
                            <button class="o_woow_copy_btn" t-on-click="() => this.copyToClipboard(publicUrl, 'url')" title="Copy URL">
                                <WoowIcon name="copyIcon('url')" size="16"/>
                            </button>
                            <!-- #648 (b)：服務已就緒、但寬限期內都沒能解析到這個
                                 網址的 DNS record ⇒ 帶著保留放行。用與上面
                                 last_release_sync_at 同一個灰字 hint 形狀，**不**走
                                 error_message（那是紅色故障通道，且 detail 頁的
                                 t-if 不判 state ⇒ 健康服務會冒紅底）。
                                 文案必須提到清本機 DNS 快取：伺服器端探測回「可
                                 解析」時租戶仍可能看到 NXDOMAIN（2026-08-12 現場
                                 已證：三條 resolver 都查得到、以指定 IP 直連 curl
                                 拿到 302，卡的是本機負面快取，純等待不會好）。 -->
                            <t t-if="props.service.public_url_dns_unverified">
                                <small class="o_woow_dns_hint text-muted d-block">
                                    The public URL is not yet verified as resolvable. DNS records usually
                                    take effect within tens of seconds; if the address still does not load
                                    after that, clear your local DNS cache or reconnect your network (for
                                    example, turn your VPN off and on again) — a cached "not found" answer
                                    will not expire on its own just because the record has since been
                                    created.
                                </small>
                            </t>
                        </span>
                    </div>

                    <!-- 對外位址（ngrok sidecar：EMQX 的 MQTT、Headscale 的控制網址）。
                         Gate 讀 has_public_tunnel_address —— 能力的唯一事實源是
                         cloud_app_template 的同名欄位；前端不得用 slug 做集合成員
                         判斷（repo-lint 第 7 條 capability-gate）。標題是範本的標籤
                         （publicTunnelLabel，資料值），只是顯示字。
                         刻意「旗標在、值空」時仍然畫這一格並說明原因：整格消失會讓
                         剛填完 ngrok token 的租戶以為自己設定失敗，而這裡最可能的
                         狀態就是 agent 還在連線。 -->
                    <div class="o_woow_info_row" t-if="props.service.has_public_tunnel_address">
                        <span class="o_woow_info_label" t-esc="publicTunnelLabel"/>
                        <span class="o_woow_info_value o_woow_info_copyable">
                            <t t-if="props.service.public_tunnel_url">
                                <code t-esc="props.service.public_tunnel_url"/>
                                <button class="o_woow_copy_btn" t-on-click="() => this.copyToClipboard(props.service.public_tunnel_url, 'tunnel')" t-att-title="publicTunnelCopyTitle">
                                    <WoowIcon name="copyIcon('tunnel')" size="16"/>
                                </button>
                            </t>
                            <t t-elif="props.service.public_tunnel_error">
                                <!-- #1559：ngrok 說得出原因（authtoken 錯、沒填、網域被占用、要重啟）時
                                     直接顯示，不再只寫「尚未取得」。文案由後端依建立者語言組好。 -->
                                <small class="text-danger" t-esc="props.service.public_tunnel_error"/>
                            </t>
                            <t t-else="">
                                <small class="text-muted" t-esc="publicTunnelPendingHint"/>
                            </t>
                        </span>
                    </div>

                    <!-- Custom Domain -->
                    <div class="o_woow_info_row" t-if="props.service.custom_domain">
                        <span class="o_woow_info_label">Custom Domain</span>
                        <span class="o_woow_info_value o_woow_info_copyable">
                            <a t-att-href="'https://' + props.service.custom_domain" target="_blank" rel="noopener noreferrer">
                                <t t-esc="props.service.custom_domain"/>
                                <WoowIcon name="'open_in_new'" size="14"/>
                            </a>
                            <button class="o_woow_copy_btn" t-on-click="() => this.copyToClipboard(props.service.custom_domain, 'domain')" title="Copy domain">
                                <WoowIcon name="copyIcon('domain')" size="16"/>
                            </button>
                        </span>
                    </div>

                    <!-- #1453：服務的使用說明（範本的 documentation_url；原本只藏在配置頁，
                         而且服務 API 漏帶這一格，連結從來沒出現過）。 -->
                    <div class="o_woow_info_row" t-if="props.service.template?.documentation_url">
                        <span class="o_woow_info_label">Service Guide</span>
                        <span class="o_woow_info_value">
                            <a t-att-href="props.service.template.documentation_url" target="_blank" rel="noopener noreferrer">
                                View Documentation
                                <WoowIcon name="'open_in_new'" size="14"/>
                            </a>
                        </span>
                    </div>

                    <!-- Internal Port -->
                    <div class="o_woow_info_row" t-if="props.service.internal_port">
                        <span class="o_woow_info_label">Internal Port</span>
                        <span class="o_woow_info_value">
                            <code t-esc="props.service.internal_port"/>
                        </span>
                    </div>
                </div>
            </WoowCard>

            <!-- Resources Card -->
            <WoowCard class="'o_woow_info_card'">
                <div class="o_woow_card_header">
                    <WoowIcon name="'deployed_code'" size="20"/>
                    <h3>Resources</h3>
                </div>
                <div class="o_woow_info_grid">
                    <!-- Helm Release -->
                    <div class="o_woow_info_row">
                        <span class="o_woow_info_label">Helm Release</span>
                        <span class="o_woow_info_value">
                            <code t-esc="props.service.helm_release_name || '—'"/>
                        </span>
                    </div>

                    <!-- Chart Version -->
                    <div class="o_woow_info_row">
                        <span class="o_woow_info_label">Chart Version</span>
                        <span class="o_woow_info_value">
                            <t t-esc="props.service.template?.name || 'Unknown'"/>
                            <t t-if="props.service.helm_chart_version">
                                <span class="o_woow_version_badge" t-esc="props.service.helm_chart_version"/>
                            </t>
                            <!-- #627 (i)/E：版本號可能過期（對帳每日一次）⇒ 把「多新」
                                 講出來，而不是讓平台假裝一直準確。刻意只加這一行、
                                 不重排版面。 -->
                            <t t-if="props.service.last_release_sync_at">
                                <small class="o_woow_sync_hint text-muted d-block">
                                    Last synced: <t t-esc="formatSyncedAt(props.service.last_release_sync_at)"/>
                                </small>
                            </t>
                        </span>
                    </div>

                    <!-- Revision -->
                    <div class="o_woow_info_row">
                        <span class="o_woow_info_label">Revision</span>
                        <span class="o_woow_info_value">
                            #<t t-esc="props.service.helm_revision || 1"/>
                        </span>
                    </div>

                    <!-- Namespace -->
                    <div class="o_woow_info_row">
                        <span class="o_woow_info_label">Namespace</span>
                        <span class="o_woow_info_value">
                            <code t-esc="helmNamespace"/>
                        </span>
                    </div>

                    <!-- Deployed At -->
                    <div class="o_woow_info_row" t-if="props.service.deployed_at">
                        <span class="o_woow_info_label">Deployed At</span>
                        <span class="o_woow_info_value">
                            <t t-esc="formatDate(props.service.deployed_at)"/>
                        </span>
                    </div>

                    <!-- Last Upgraded -->
                    <div class="o_woow_info_row" t-if="props.service.last_upgraded_at">
                        <span class="o_woow_info_label">Last Upgraded</span>
                        <span class="o_woow_info_value">
                            <t t-esc="formatDate(props.service.last_upgraded_at)"/>
                        </span>
                    </div>
                </div>
            </WoowCard>

            <!-- Plan allocations remain separate from effective runtime limits. -->
            <WoowCard class="'o_woow_info_card'" t-if="props.service.allocated_vcpu || props.service.allocated_ram_gb || props.service.allocated_storage_gb">
                <div class="o_woow_card_header">
                    <WoowIcon name="'memory'" size="20"/>
                    <h3>Requested configuration</h3>
                </div>
                <div class="o_woow_resource_grid">
                    <!-- vCPU -->
                    <div class="o_woow_resource_item" t-if="props.service.allocated_vcpu">
                        <div class="o_woow_resource_icon">
                            <WoowIcon name="'developer_board'" size="24"/>
                        </div>
                        <div class="o_woow_resource_info">
                            <span class="o_woow_resource_value" t-esc="props.service.allocated_vcpu"/>
                            <span class="o_woow_resource_label">vCPU</span>
                        </div>
                    </div>

                    <!-- RAM -->
                    <div class="o_woow_resource_item" t-if="props.service.allocated_ram_gb">
                        <div class="o_woow_resource_icon">
                            <WoowIcon name="'memory'" size="24"/>
                        </div>
                        <div class="o_woow_resource_info">
                            <span class="o_woow_resource_value">
                                <t t-esc="props.service.allocated_ram_gb"/> GB
                            </span>
                            <span class="o_woow_resource_label">RAM</span>
                        </div>
                    </div>

                    <!-- Storage -->
                    <div class="o_woow_resource_item" t-if="props.service.allocated_storage_gb">
                        <div class="o_woow_resource_icon">
                            <WoowIcon name="'storage'" size="24"/>
                        </div>
                        <div class="o_woow_resource_info">
                            <span class="o_woow_resource_value">
                                <t t-esc="props.service.allocated_storage_gb"/> GB
                            </span>
                            <span class="o_woow_resource_label">Storage</span>
                        </div>
                    </div>
                </div>
                <p class="o_woow_hint" t-esc="workspaceQuotaHint"/>
            </WoowCard>
        </div>
    </t>
</templates>
