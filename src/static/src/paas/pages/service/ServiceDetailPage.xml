<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="woow_paas_platform.ServiceDetailPage">
        <div class="o_woow_service_detail">
            <!-- Loading State -->
            <t t-if="state.loading">
                <div class="o_woow_loading">
                    <WoowIcon name="'sync'" size="32" class="'o_woow_spin'"/>
                    <p>Loading service...</p>
                </div>
            </t>

            <!-- Error State -->
            <t t-elif="state.error">
                <div class="o_woow_error_state">
                    <WoowIcon name="'error'" size="48"/>
                    <h2>Unable to load service</h2>
                    <p t-esc="state.error"/>
                    <WoowButton variant="'primary'" size="'md'" onClick.bind="goBack">
                        <WoowIcon name="'arrow_back'" size="18"/>
                        Back to Workspace
                    </WoowButton>
                </div>
            </t>

            <!-- Service Content -->
            <t t-elif="service">
                <!-- 麵包屑統一由全域 Header 呈現（見 ServiceDetailPage._publishBreadcrumb）-->

                <!-- Service Header -->
                <div class="o_woow_service_header">
                    <div class="o_woow_service_header_info">
                        <div class="o_woow_service_header_icon">
                            <BrandIcon brand="brandKey" fallback="templateIcon" size="32" fill="true"/>
                        </div>
                        <div class="o_woow_service_header_text">
                            <div class="o_woow_service_header_title">
                                <h1 t-esc="service.name"/>
                                <StatusBadge status="service.state" phase="service.init_phase or ''"/>
                                <span t-if="staleObservation" class="o_woow_service_observed_hint">
                                    <t t-esc="staleObservationLabel"/>
                                </span>
                            </div>
                            <div class="o_woow_service_header_meta">
                                <span class="o_woow_service_template">
                                    <WoowIcon name="'apps'" size="14"/>
                                    <t t-esc="service.template?.name || 'Unknown Template'"/>
                                </span>
                                <span t-if="service.subdomain" class="o_woow_service_domain">
                                    <WoowIcon name="'language'" size="14"/>
                                    <t t-esc="service.subdomain"/>.<t t-esc="domain"/>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="o_woow_service_header_actions">
                        <!-- #275：Projects 關閉時不可建立隱藏 project，改用既有 billing
                             頁的 mailto；開啟時載入中的按鈕與 handler 都不允許重入。 -->
                        <t t-if="projectsVisible">
                            <WoowButton
                                t-if="state.supportProject"
                                variant="'secondary'"
                                size="'md'"
                                onClick.bind="openSupportProject"
                                disabled="state.supportProjectLoading">
                                <WoowIcon name="'support_agent'" size="18"/>
                                Support Project
                            </WoowButton>
                            <WoowButton
                                t-else=""
                                variant="'secondary'"
                                size="'md'"
                                onClick.bind="showCreateProject"
                                disabled="supportProjectAction !== 'create'">
                                <WoowIcon name="'add_circle'" size="18"/>
                                Create Support Project
                            </WoowButton>
                        </t>
                        <a t-else="" href="mailto:support@woowtech.io" class="o_woow_service_support_email">
                            <WoowIcon name="'support_agent'" size="18"/>
                            support@woowtech.io
                        </a>
                        <WoowButton
                            t-if="service.state === 'running'"
                            variant="'primary'"
                            size="'md'"
                            onClick.bind="openWebUI">
                            <WoowIcon name="'open_in_new'" size="18"/>
                            Open Web UI
                        </WoowButton>
                        <!-- #1560：以下是 owner／admin 才能做的操作，user／guest 不顯示
                             （後端 role gate 照舊；判準讀 payload 的 viewer_can_manage）。 -->
                        <t t-if="canManageService">
                        <WoowButton
                            t-if="service.subscription and service.subscription.is_trial"
                            variant="'secondary'"
                            size="'md'"
                            onClick.bind="showSkipTrial"
                            disabled="!canPerformActions">
                            <WoowIcon name="'skip_next'" size="18"/>
                            Skip Trial
                        </WoowButton>
                        <WoowButton
                            t-if="adminResetSupported and !canEditAdminCredentials"
                            variant="'secondary'"
                            size="'md'"
                            onClick.bind="showResetConfirm"
                            disabled="!canResetAdminCredentials or isResetAdminPasswordLoading">
                            <WoowIcon name="'key'" size="18"/>
                            Reset Admin Password
                        </WoowButton>
                        <WoowButton
                            t-if="adminResetSupported and canEditAdminCredentials"
                            variant="'secondary'"
                            size="'md'"
                            onClick.bind="showAdminCredentials"
                            disabled="!canResetAdminCredentials or isResetAdminPasswordLoading">
                            <WoowIcon name="'key'" size="18"/>
                            Admin Credentials
                        </WoowButton>
                        <WoowButton
                            variant="'secondary'"
                            size="'md'"
                            onClick.bind="showChangePlan"
                            disabled="!canPerformActions">
                            <WoowIcon name="'swap_horiz'" size="18"/>
                            Change Plan
                        </WoowButton>
                        <!-- #1535：自訂網域從未實作，先對租戶隱藏（見 customDomainSupported）。 -->
                        <WoowButton
                            t-if="customDomainSupported"
                            variant="'secondary'"
                            size="'md'"
                            onClick.bind="showDomainModal"
                            disabled="!canPerformActions">
                            <WoowIcon name="'language'" size="18"/>
                            Custom Domain
                        </WoowButton>
                        <!-- #1540：停權（或已有開著的入口）時的限時唯讀取回入口。 -->
                        <WoowButton
                            t-if="canRetrieveData"
                            variant="'secondary'"
                            size="'md'"
                            onClick.bind="showDataRetrieval">
                            <WoowIcon name="'download'" size="18"/>
                            Retrieve Data
                        </WoowButton>
                        <WoowButton
                            t-if="showRestartButton"
                            variant="'secondary'"
                            size="'md'"
                            onClick.bind="showRestart"
                            disabled="!canRestart">
                            <WoowIcon name="'restart_alt'" size="18"/>
                            Restart
                        </WoowButton>
                        <WoowButton
                            variant="'secondary'"
                            size="'md'"
                            onClick.bind="showRollback"
                            disabled="!canPerformActions">
                            <WoowIcon name="'history'" size="18"/>
                            Rollback
                        </WoowButton>
                        <WoowButton
                            variant="'ghost'"
                            size="'md'"
                            onClick.bind="showDelete"
                            disabled="!canDelete">
                            <WoowIcon name="'delete'" size="18"/>
                        </WoowButton>
                        </t>
                    </div>
                </div>

                <!--
                    #530：Reset 現在一次換發兩把憑證。沒有這句的話，租戶按下去只
                    預期換掉 dashboard 密碼，結果 MCP 那端沿用舊 gateway key 開始
                    401——而失敗形狀（連線測試一個紅點）看不出憑證已被換掉。

                    gate ＝ adminResetSupported **and** hasGateway，兩個都是後端鏡射欄位
                    （見 capability-gate-single-source-field，前端不自建判準）：
                      - adminResetSupported → 這顆 Reset 按鈕在不在（憑證鑄造閘門）
                      - hasGateway  → Reset 會不會真的交付 gateway 憑證
                                      （交付閘門＝後端 _gateway_public_url() 非空）
                    只判前者的話，has_admin_gui=True 的模板裡除 hermes-agent 外都沒有 gateway，
                    它們的租戶會讀到一句永遠不會發生的承諾。守線：repo-lint
                    check_gateway_copy_gate_anchor ＋ test_gateway_capability_payload_530。
                -->
                <!-- #1370：Odoo／n8n 的 Reset 直接改 app DB——先講清楚後果再讓租戶按。 -->
                <!-- #1560：按鈕只給 owner／admin，說明它的提示也一樣。 -->
                <t t-if="canManageService">
                <p t-if="adminResetSupported and isAppAdminReset and appResetKeepsSessions" class="o_woow_hint">
                    Reset Admin Password issues a new password that works right away.
                    Devices that are already signed in stay signed in.
                </p>
                <p t-if="adminResetSupported and isAppAdminReset and !appResetKeepsSessions" class="o_woow_hint">
                    Reset Admin Password issues a new password that works right away: devices
                    signed in with the old password are signed out, and two-factor sign-in
                    is turned off.
                </p>
                <!-- #1557：可自設帳密的服務（LiteLLM）改帳密預設保留 key、要不要換在對話框裡選，
                     這句只講 Reset 那顆按鈕（hermes-agent）。 -->
                <p t-if="adminResetSupported and hasGateway and !canEditAdminCredentials" class="o_woow_hint">
                    Reset Admin Password also issues a new Gateway API Key. Update it
                    wherever you configured it (e.g. your MCP server).
                </p>
                </t>

                <!-- #1611：訂閱被取消／到期後的自助續訂入口。內容全由後端 renewal 決定
                     （renewalBanner getter）；「續訂」按鈕只給 owner／admin（canManageService）。 -->
                <div t-if="renewalBanner"
                     t-attf-class="o_woow_service_renewal_banner o_woow_service_renewal_banner--{{ renewalBanner.tone }}">
                    <WoowIcon name="renewalBanner.icon" size="20"/>
                    <div class="o_woow_service_renewal_banner__text">
                        <strong t-esc="renewalBanner.title"/>
                        <span t-esc="renewalBanner.detail"/>
                    </div>
                    <WoowButton
                        t-if="renewalBanner.canRenew"
                        variant="'primary'"
                        size="'sm'"
                        onClick.bind="showRenew">
                        <WoowIcon name="'autorenew'" size="16"/>
                        Renew Subscription
                    </WoowButton>
                </div>
                <!-- #1540：停權中可取回資料的提示／開著的取回入口。 -->
                <t t-if="canRetrieveData">
                    <p t-if="retrievalSession" class="o_woow_hint" t-esc="retrievalBannerText"/>
                    <p t-else="" class="o_woow_hint" t-esc="retrievalSuspendedHint"/>
                </t>

                <!-- Error Message Banner -->
                <!-- #1159 Q30：init 失敗時顯示固定文案＋attempt 序號並導向 support 入口；
                     operator 的原始錯誤只在後台的 attempt 記錄（租戶看不到）。 -->
                <div t-if="initFailed" class="o_woow_service_error_banner">
                    <WoowIcon name="'error'" size="20"/>
                    <span class="o_woow_service_error_banner__text" t-esc="initFailureText"/>
                    <WoowButton
                        t-if="projectsVisible"
                        variant="'secondary'"
                        size="'sm'"
                        onClick.bind="contactSupport"
                        disabled="!supportProjectAction">
                        <WoowIcon name="'support_agent'" size="16"/>
                        Contact Support
                    </WoowButton>
                    <a t-else="" href="mailto:support@woowtech.io" class="o_woow_service_support_email">
                        support@woowtech.io
                    </a>
                </div>
                <div t-elif="service.error_message" class="o_woow_service_error_banner">
                    <WoowIcon name="'error'" size="20"/>
                    <span class="o_woow_service_error_banner__text" t-esc="service.error_message"/>
                </div>
                <!-- #1647：服務顯示 running、但平台確認它沒有在執行（例：工作區剩餘的配額
                     不夠這台啟動，Pod 建不出來）。獨立的 t-if，不接在上面的 if／elif 鏈上：
                     那條鏈講的是 error 狀態的訊息，這一則只在 running 時出現。文案固定，由
                     getWorkloadFaultText 依後端確認過的代碼挑。 -->
                <div t-if="workloadFaultText" class="o_woow_service_error_banner">
                    <WoowIcon name="'error'" size="20"/>
                    <span class="o_woow_service_error_banner__text" t-esc="workloadFaultText"/>
                </div>
                <div t-if="state.resetPasswordError" class="o_woow_service_error_banner">
                    <WoowIcon name="'error'" size="20"/>
                    <span class="o_woow_service_error_banner__text" t-esc="state.resetPasswordError"/>
                </div>

                <!-- Tab Navigation -->
                <div class="o_woow_tabs">
                    <button
                        t-att-class="{'o_woow_tab': true, 'active': currentTab === 'overview'}"
                        t-on-click="() => this.setTab('overview')">
                        <WoowIcon name="'info'" size="18"/>
                        Overview
                    </button>
                    <button
                        t-att-class="{'o_woow_tab': true, 'active': currentTab === 'configuration'}"
                        t-on-click="() => this.setTab('configuration')">
                        <WoowIcon name="'settings'" size="18"/>
                        Configuration
                    </button>
                    <button
                        t-if="isOdooService"
                        t-att-class="{'o_woow_tab': true, 'active': currentTab === 'addons'}"
                        t-on-click="() => this.setTab('addons')">
                        <WoowIcon name="'inventory_2'" size="18"/>
                        Addons
                    </button>
                    <!-- #1310：專案功能關閉時，此頁籤唯一的「Go to Project Settings」按鈕也被隱藏，
                         點進去是死路；與其他 project 交叉入口一致，跟著 projectsVisible 隱藏。 -->
                    <button
                        t-if="projectsVisible"
                        t-att-class="{'o_woow_tab': true, 'active': currentTab === 'mcp-servers'}"
                        t-on-click="() => this.setTab('mcp-servers')">
                        <WoowIcon name="'extension'" size="18"/>
                        MCP Servers
                    </button>
                    <!--
                        #746：Access 頁籤只給買了 AC 席位的方案（設計拍板 6：
                        `ac_max_access_seats > 0` 才出現，無席位不顯示、不做
                        upsell）。gate 走 hasAccessSeats getter，它讀的是後端
                        payload 的 subscription.ac_max_access_seats——能力判準
                        收斂到後端單一欄位（capability-gate-single-source-field），
                        前端不得自己算一份（slug／category／模板名單）。
                        #1261：`or accessRecoveryMode`＝0 席但仍受保護時照樣給頁籤
                        （只能關保護，見該 getter）。hasAccessSeats 必須留在表達式
                        裡——lint 靠它追到 ac_max_access_seats。
                    -->
                    <button
                        t-if="hasAccessSeats or accessRecoveryMode"
                        t-att-class="{'o_woow_tab': true, 'active': currentTab === 'access'}"
                        t-on-click="() => this.setTab('access')">
                        <WoowIcon name="'shield'" size="18"/>
                        Access
                    </button>
                </div>

                <!-- Tab Content -->
                <div class="o_woow_tab_content">
                    <OverviewTab
                        t-if="currentTab === 'overview'"
                        service="service"
                        workspaceId="props.workspaceId"
                        resourceObservation="resources.state.observations[props.serviceId]"
                        resourcesLoading="resources.state.loading"
                        resourcesRefreshFailed="resources.state.refreshFailed"
                        resourcesNow="resources.state.now"/>
                    <ConfigurationTab
                        t-if="currentTab === 'configuration'"
                        service="service"
                        workspaceId="props.workspaceId"
                        canManage="canManageService"
                        onSave.bind="handleConfigSave"/>
                    <AddonsTab
                        t-if="currentTab === 'addons'"
                        service="service"
                        workspaceId="props.workspaceId"
                        canManage="canManageService"
                        onSave.bind="handleConfigSave"/>
                    <McpServersTab
                        t-if="currentTab === 'mcp-servers'"
                        service="service"
                        workspaceId="props.workspaceId"/>
                    <!-- 內容側同樣掛 hasAccessSeats：直接把 URL 打成
                         .../access 的人不該因此拿到一個方案沒買的頁面
                         （頁籤不見了、內容還在＝gate 只做了一半）。 -->
                    <!-- #1261：復原模式也掛內容（否則 /access 深連結是空的），
                         `seatless` 讓頁籤只剩「關保護」。 -->
                    <AccessTab
                        t-if="currentTab === 'access' and (hasAccessSeats or accessRecoveryMode)"
                        service="service"
                        seatless="!hasAccessSeats"
                        workspaceId="props.workspaceId"/>
                </div>
            </t>

            <!-- Delete Service Modal -->
            <DeleteServiceModal
                t-if="state.showDeleteModal and serviceForModal"
                service="serviceForModal"
                onClose.bind="hideDelete"
                onDeleted.bind="onServiceDeleted"/>

            <!-- Rollback Modal -->
            <RollbackModal
                t-if="state.showRollbackModal and serviceForModal"
                service="serviceForModal"
                onClose.bind="hideRollback"
                onRollback.bind="onRollbackComplete"/>

            <!-- #1432 Restart Modal -->
            <RestartServiceModal
                t-if="state.showRestartModal and serviceForModal"
                service="serviceForModal"
                onClose.bind="hideRestart"
                onRestarted.bind="onRestarted"/>

            <!-- Skip Trial Modal -->
            <SkipTrialModal
                t-if="state.showSkipTrialModal and serviceForModal"
                service="serviceForModal"
                loadEstimate="loadCloudServiceEstimate"
                confirmSkip="confirmCloudServiceSkip"
                requireWoowPayable="true"
                onClose.bind="hideSkipTrial"
                onSkipped.bind="onTrialSkipped"/>

            <!-- #1611 Renew Subscription Modal -->
            <RenewSubscriptionModal
                t-if="state.showRenewModal and service"
                serviceName="service.name"
                loadEstimate="loadRenewEstimate"
                confirmRenew="confirmRenew"
                onClose.bind="hideRenew"
                onRenewed.bind="onRenewed"/>

            <!-- Change Plan Modal（改方案／改席數，內嵌 PlanSelector） -->
            <ChangePlanModal
                t-if="state.showChangePlanModal and serviceForModal"
                service="serviceForModal"
                currentPlanId="serviceForModal.subscription?.plan_id ?? undefined"
                loadPlans="loadCloudServicePlans"
                confirmChange="confirmCloudServiceChangePlan"
                resizesResources="true"
                onClose.bind="hideChangePlan"
                onChanged.bind="onPlanChanged"/>

            <!-- Edit Domain Modal -->
            <EditDomainModal
                t-if="customDomainSupported and state.showDomainModal and serviceForModal"
                service="serviceForModal"
                onClose.bind="hideDomainModal"
                onSaved.bind="onDomainSaved"/>

            <!-- Create Support Project Modal -->
            <CreateProjectModal
                t-if="state.showCreateProjectModal"
                workspaceId="props.workspaceId"
                cloudServiceId="props.serviceId"
                cloudServiceName="service and service.name"
                onClose.bind="hideCreateProject"
                onCreated.bind="onProjectCreated"/>

            <!-- #1560：重設管理員密碼先確認（一按就讓目前的密碼失效）。 -->
            <ResetAdminPasswordModal
                t-if="state.showResetConfirmModal and serviceForModal"
                service="serviceForModal"
                appReset="isAppAdminReset"
                keepsSessions="appResetKeepsSessions"
                onClose.bind="hideResetConfirm"
                onConfirm.bind="confirmResetAdminPassword"/>

            <AdminCredentialsModal
                t-if="state.showAdminCredentialsModal"
                workspaceId="props.workspaceId"
                serviceId="props.serviceId"
                currentUsername="service and service.admin_username"
                usernameEditable="canEditAdminUsername"
                service="service or undefined"
                onClose.bind="hideAdminCredentials"
                onSaved.bind="onAdminCredentialsSaved"/>

            <DataRetrievalModal
                t-if="state.showDataRetrievalModal and service"
                endpoint="dataRetrievalEndpoint"
                serviceName="service.name"
                onClose.bind="hideDataRetrieval"/>

            <OneTimeCredentialsModal
                t-if="state.oneTimeCredentials"
                credentials="state.oneTimeCredentials"
                mode="credentialsModalMode"
                appResetKind="service?.template?.app_admin_reset_kind or undefined"
                onClose.bind="closeCredentials"/>
        </div>
    </t>
</templates>
