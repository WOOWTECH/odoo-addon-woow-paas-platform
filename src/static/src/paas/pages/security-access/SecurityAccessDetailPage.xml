<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="woow_paas_platform.SecurityAccessDetailPage">
    <div class="o_woow_sa_detail">
      <div t-if="state.loading" class="o_woow_sa_detail__loading">Loading...</div>
      <div t-elif="state.error" class="o_woow_error_message">
        <WoowIcon name="'error'" size="16"/>
        <span t-esc="state.error"/>
      </div>
      <t t-elif="state.sa">
        <!-- #1234：操作失敗留在頁內、可關閉，不再取代整頁。 -->
        <div t-if="state.actionError" class="o_woow_error_message o_woow_sa_action_error">
          <WoowIcon name="'error'" size="16"/>
          <span t-esc="state.actionError"/>
          <button class="o_woow_sa_icon_btn" title="Dismiss"
                  t-on-click="dismissActionError">
            <WoowIcon name="'close'" size="16"/>
          </button>
        </div>
        <!-- Header（mockup：icon + nickname + badge + hostname + delete） -->
        <div class="o_woow_sa_detail__header">
          <div class="o_woow_sa_detail__icon">
            <WoowIcon name="'verified_user'" size="32"/>
          </div>
          <div class="o_woow_sa_detail__title">
            <t t-if="!state.editingName">
              <h1 t-on-click="startEditName"><t t-esc="state.sa.name"/></h1>
            </t>
            <t t-else="">
              <!-- OWL 不支援 .enter key modifier（Vue 語法）— 按鍵判斷在
                   handler 內讀 ev.key（onNameKeydown 觸發 blur → saveName） -->
              <input type="text" class="o_woow_input" t-model="state.nameDraft"
                     t-on-keydown="onNameKeydown" t-on-blur="saveName"/>
            </t>
            <StatusBadge status="state.sa.state"/>
            <!-- A Security Access IS a Cloudflare Tunnel (N routes, no single
                 "primary hostname"). Show the service type, not a hostname. -->
            <div class="o_woow_sa_detail__type">
              <WoowIcon name="'hub'" size="14"/>
              <span>Cloudflare Tunnel</span>
            </div>
          </div>
          <div class="o_woow_sa_detail__actions">
            <WoowButton t-if="state.sa.state === 'pending' or state.sa.state === 'error'"
                        variant="'primary'" onClick.bind="provision">Provision</WoowButton>
            <WoowButton variant="'secondary'"
                        onClick="() => state.showChangePlanModal = true">
              <WoowIcon name="'swap_horiz'" size="16"/>
              Change Plan
            </WoowButton>
            <WoowButton variant="'danger'"
                        onClick="() => state.showDeleteConfirm = true">
              <WoowIcon name="'delete'" size="16"/>
            </WoowButton>
          </div>
        </div>

        <!-- Tab bar（橫向可捲動，對齊 mockup） -->
        <div class="o_woow_sa_detail__tabs">
          <t t-foreach="tabs" t-as="tab" t-key="tab.key">
            <button t-att-class="'o_woow_sa_detail__tab' +
                      (state.activeTab === tab.key ? ' o_woow_sa_detail__tab--active' : '')"
                    t-on-click="() => this.switchTab(tab.key)">
              <WoowIcon name="tab.icon" size="16"/>
              <t t-esc="tab.label"/>
              <span t-if="tab.comingSoon" class="o_woow_sa_detail__tab_dot"/>
            </button>
          </t>
        </div>

        <!-- Overview -->
        <div t-if="state.activeTab === 'overview'" class="o_woow_sa_detail__body">
          <WoowCard shadow="true">
            <h3>Status</h3>
            <div class="o_woow_sa_detail__grid">
              <div><label>State</label><StatusBadge status="state.sa.state"/></div>
              <div><label>Connector</label><StatusBadge status="state.sa.tunnel_status"/></div>
              <div><label>Routes</label><t t-esc="(state.sa.routes or []).length"/></div>
            </div>
          </WoowCard>
          <!-- Tunnel Information (a Security Access IS a Cloudflare Tunnel) -->
          <WoowCard shadow="true" t-if="state.sa.tunnel_id">
            <h3>Tunnel Information</h3>
            <div class="o_woow_sa_detail__grid">
              <div><label>Tunnel ID</label>
                <span class="o_woow_sa_detail__mono"><t t-esc="state.sa.tunnel_id"/></span></div>
              <div><label>Tunnel Name</label><t t-esc="state.sa.tunnel_name"/></div>
              <div t-if="state.sa.connector_type">
                <label>Connector Type</label><t t-esc="state.sa.connector_type"/></div>
              <div t-if="state.sa.connector_id">
                <label>Connector ID</label>
                <span class="o_woow_sa_detail__mono"><t t-esc="state.sa.connector_id"/></span></div>
              <div t-if="state.sa.connector_version">
                <label>Connector Version</label><t t-esc="state.sa.connector_version"/></div>
              <div><label>Edge Connections</label>
                <t t-esc="state.sa.edge_connection_count or 0"/></div>
              <div><label>Status</label><StatusBadge status="state.sa.tunnel_status"/></div>
              <div t-if="state.sa.tunnel_uptime">
                <label>Connector Opened</label><t t-esc="state.sa.tunnel_uptime"/></div>
            </div>
          </WoowCard>
          <!-- #1196：連線指引 + tunnel token 自助取用。
               tunnel 可任意轉移是刻意的定位，所以這裡要能複製 token 搬到別台。
               HA 整合那條路不需要 token（它自己用 OAuth 領），故獨立列出。 -->
          <WoowCard shadow="true" t-if="state.sa.tunnel_id">
            <h3>Connect a machine</h3>
            <p class="o_woow_sa_detail__hint">
              Run one connector with this tunnel's token and the routes above go
              live. Move the token to another machine to move the tunnel — the
              public hostnames stay the same.
            </p>
            <!-- #1196：同一把 token 同時跑在兩台，Cloudflare 不保證平均分配——2026-09-29
                 正式站實測 40/40 個請求都留在原本那台。搬家時最常踩的是「以為搬好了，
                 訪客其實還在打舊機器」。 -->
            <p class="o_woow_sa_detail__hint">
              Run the token on one machine at a time. If two connectors run it,
              Cloudflare may keep sending visitors to either one (often the old
              machine) — stop the old connector as soon as the new one is up.
            </p>
            <div class="o_woow_sa_token">
              <label>Tunnel token</label>
              <div class="o_woow_sa_token__row">
                <span class="o_woow_sa_detail__mono o_woow_sa_token__value">
                  <t t-if="state.tunnelTokenVisible"><t t-esc="state.tunnelToken"/></t>
                  <t t-else=""><t t-esc="maskedTunnelToken"/></t>
                </span>
                <button class="o_woow_sa_icon_btn"
                        t-att-title="state.tunnelTokenVisible ? 'Hide' : 'Reveal'"
                        t-att-disabled="state.tunnelTokenLoading"
                        t-on-click="toggleTunnelToken">
                  <!-- 元件的 prop 本身就是運算式，不可以用 t-att（Owl 會直接拒收
                       並把整個 root component 銷毀）。 -->
                  <WoowIcon name="state.tunnelTokenVisible ? 'visibility_off' : 'visibility'"
                            size="18"/>
                </button>
                <button class="o_woow_sa_icon_btn" title="Copy token"
                        t-on-click="copyTunnelToken">
                  <WoowIcon name="'content_copy'" size="18"/>
                </button>
                <!-- #1261：字面值刻意不用裸 "Copied"。那條 msgid 被 Odoo web 模組
                     佔用、譯成動詞「複製」，而前端 translatedTerms 是跨模組攤平的
                     flat map（見 i18n/zh_TW.po 檔頭）——在本模組填「已複製」會與
                     web 的譯文隨機互蓋、還會連帶改到 Odoo 自己的複製按鈕。換成本
                     模組獨佔的 msgid 才可靠。 -->
                <span t-if="state.tunnelTokenCopied"
                      class="o_woow_sa_token__copied">Token copied</span>
              </div>
              <p class="o_woow_sa_token__warn">
                Treat this like a password — anyone holding it can run this
                tunnel and serve your hostnames.
              </p>
            </div>
            <div class="o_woow_sa_connect">
              <div class="o_woow_sa_connect__item">
                <strong>Home Assistant integration</strong>
                <span>Add the Woow PaaS integration and pick this Security
                      Access — it fetches the token for you, nothing to paste.</span>
              </div>
              <div class="o_woow_sa_connect__item">
                <strong>Cloudflared Web GUI add-on</strong>
                <span>Paste the token above into the add-on's
                      <em>tunnel_token</em> option and start it.</span>
              </div>
              <div class="o_woow_sa_connect__item">
                <strong>Docker</strong>
                <pre class="o_woow_sa_detail__mono o_woow_sa_connect__cmd"><t t-esc="dockerRunCommand"/></pre>
              </div>
            </div>
          </WoowCard>
          <WoowCard shadow="true" t-if="state.sa.subscription">
            <h3>Subscription</h3>
            <div class="o_woow_sa_detail__grid">
              <div><label>Plan</label><t t-esc="state.sa.subscription.plan_name"/></div>
              <div><label>Next payment</label><t t-esc="state.sa.subscription.next_payment"/></div>
              <div t-if="state.sa.subscription.is_trial">
                <label>Trial ends</label>
                <t t-esc="state.sa.subscription.trial_end_date"/>
                <WoowButton variant="'primary'" size="'sm'"
                            onClick="() => state.showSkipTrialModal = true">
                  Skip Trial
                </WoowButton>
              </div>
            </div>
          </WoowCard>
        </div>

        <!-- Configuration（record 自身設定） -->
        <div t-if="state.activeTab === 'configuration'" class="o_woow_sa_detail__body">
          <WoowCard shadow="true">
            <h3>Identity</h3>
            <div class="o_woow_sa_detail__grid">
              <div><label>Canonical name</label><t t-esc="state.sa.canonical_name"/></div>
              <div><label>Created</label><t t-esc="state.sa.created_at"/></div>
            </div>
          </WoowCard>
        </div>

        <!-- Application（routes 管理） -->
        <div t-if="state.activeTab === 'application'" class="o_woow_sa_detail__body">
          <WoowCard shadow="true">
            <div class="o_woow_sa_card_head">
              <div class="o_woow_sa_card_head__icon">
                <WoowIcon name="'route'" size="20"/>
              </div>
              <div class="o_woow_sa_card_head__text">
                <h3>Application Routes</h3>
                <!-- #1261：原句「with the Host header set」讀起來像「靠那個勾選框
                     才會帶 Host」。實際上 cloudflared 沒設 httpHostHeader 時本來就原樣
                     轉送訪客的 Host（＝公開網址），勾不勾在常見情況下 origin 收到的
                     都一樣（2026-09-29 正式站實測）。 -->
                <p>Each route maps a public subdomain to your host. Traffic is
                   forwarded to the service URL with the public hostname as the Host header.</p>
              </div>
              <!-- #1234：額度與健康探測。 -->
              <div class="o_woow_sa_card_head__aside">
                <span t-if="state.sa.route_quota !== null and state.sa.route_quota !== undefined"
                      t-att-class="'o_woow_sa_quota' + (atRouteQuota ? ' o_woow_sa_quota--full' : '')">
                  <t t-esc="routeCount"/> / <t t-esc="state.sa.route_quota"/> routes
                </span>
                <button t-if="state.sa.routes and state.sa.routes.length"
                        class="o_woow_sa_icon_btn" title="Check status now"
                        t-att-disabled="state.healthLoading"
                        t-on-click="() => this.loadRouteHealth(true)">
                  <WoowIcon name="'refresh'" size="18"/>
                </button>
              </div>
            </div>
            <div t-if="!(state.sa.routes and state.sa.routes.length)"
                 class="o_woow_sa_detail__hint">
              No application routes yet. Add your first route below to expose a
              service — until then the tunnel is ready but answers 404.
            </div>
            <table t-if="state.sa.routes and state.sa.routes.length"
                   class="o_woow_sa_routes_table">
              <thead>
                <!-- #1261：Host header 欄的說明放在 title（滑過可見），講清楚這個選項
                     實際做什麼：**強制**把 Host 設成公開網址（cloudflared
                     httpHostHeader）。沒勾時 cloudflared 也會原樣轉送訪客的 Host，
                     通常就是同一個公開網址——所以取消勾選一般不會改變 origin 收到的值，
                     不要讓租戶以為取消勾選就能讓後端收到 service URL 的主機名。
                     只改文案、不改行為（勾選照樣推 httpHostHeader）。 -->
                <tr><th>Hostname</th><th>Service</th><th title="Forces the Host header sent to your service to the public hostname. cloudflared normally forwards the visitor's original Host (the same public hostname) anyway, so turning this off usually changes nothing.">Host header</th><th>Status</th><th>Traffic (24h)</th><th></th></tr>
              </thead>
              <tbody>
                <t t-foreach="state.sa.routes or []" t-as="route" t-key="route.id">
                  <tr>
                    <!-- #1196：主機名稱可就地改。編輯時只讓改 prefix，後綴是
                         平台網域、不是使用者的東西。 -->
                    <td class="o_woow_sa_routes_table__host">
                      <div t-if="state.editingRouteId === route.id"
                           class="o_woow_sa_routes_table__rename">
                        <input type="text" class="o_woow_input"
                               placeholder="subdomain prefix"
                               t-att-value="state.editRoutePrefix"
                               t-on-input="onEditRoutePrefix"/>
                        <span class="o_woow_sa_add_route__suffix">.<t t-esc="paasDomainSuffix"/></span>
                      </div>
                      <span t-else="" class="o_woow_sa_detail__mono">
                        <t t-esc="route.hostname"/>
                      </span>
                    </td>
                    <!-- #1196：就地編輯 service_url / Host header。 -->
                    <td>
                      <input t-if="state.editingRouteId === route.id"
                             type="text" class="o_woow_input o_woow_sa_routes_table__edit"
                             placeholder="service URL"
                             t-att-value="state.editRouteServiceUrl"
                             t-on-input="onEditRouteServiceUrl"/>
                      <span t-else="" class="o_woow_sa_detail__mono">
                        <t t-esc="route.service_url"/>
                      </span>
                    </td>
                    <td class="o_woow_sa_routes_table__hh">
                      <input t-if="state.editingRouteId === route.id"
                             type="checkbox"
                             title="Forces the Host header sent to your service to the public hostname. cloudflared normally forwards the visitor's original Host (the same public hostname) anyway, so turning this off usually changes nothing."
                             t-att-checked="state.editRouteHostHeader"
                             t-on-change="onEditRouteHostHeader"/>
                      <t t-else="" t-esc="route.http_host_header ? 'Yes' : 'No'"/>
                    </td>
                    <!-- #1234：公開網路探測結果；滑過看該做什麼。 -->
                    <td class="o_woow_sa_routes_table__status">
                      <span t-att-class="routeHealthClass(route)"
                            t-att-title="routeHealthHint(route)">
                        <t t-esc="routeHealthLabel(route)"/>
                      </span>
                    </td>
                    <!-- #1234：Cloudflare analytics 的請求數 · 最後請求。 -->
                    <td class="o_woow_sa_routes_table__traffic"
                        t-att-title="routeTrafficHint(route)">
                      <t t-esc="routeTrafficLabel(route)"/>
                    </td>
                    <td class="o_woow_sa_routes_table__action">
                      <t t-if="state.editingRouteId === route.id">
                        <button class="o_woow_sa_icon_btn" title="Save"
                                t-att-disabled="state.savingRoute"
                                t-on-click="() => this.saveRoute(route)">
                          <WoowIcon name="'check'" size="18"/>
                        </button>
                        <button class="o_woow_sa_icon_btn" title="Cancel"
                                t-on-click="cancelEditRoute">
                          <WoowIcon name="'close'" size="18"/>
                        </button>
                      </t>
                      <t t-else="">
                        <button class="o_woow_sa_icon_btn" title="Edit route"
                                t-on-click="() => this.startEditRoute(route)">
                          <WoowIcon name="'edit'" size="18"/>
                        </button>
                        <button class="o_woow_sa_icon_btn" title="Delete route"
                                t-on-click="() => this.requestRemoveRoute(route)">
                          <WoowIcon name="'delete'" size="18"/>
                        </button>
                      </t>
                    </td>
                  </tr>
                </t>
              </tbody>
            </table>
            <div t-if="state.sa.routes and state.sa.routes.length" class="o_woow_sa_detail__hint">
              Status is checked from the public internet. Hover a status to see what to do.
            </div>
            <!-- #1196：改名的後果在按下儲存前講清楚。平台只負責 Cloudflare 那半，
                 使用者 origin 那半（依主機名分流的反向代理、allowed hosts）我們碰不到。 -->
            <div t-if="pendingRename"
                 class="o_woow_sa_detail__hint o_woow_sa_detail__hint--warn o_woow_sa_rename_notice">
              <p>
                <!-- 不用單獨的 "to"：Odoo 會把它當成一個可翻譯字串換成「至」。 -->
                <span class="o_woow_sa_detail__mono"><t t-esc="pendingRename.from"/></span>
                → <span class="o_woow_sa_detail__mono"><t t-esc="pendingRename.to"/></span>.
                The new address is usually live within a minute. The old address
                stops working right away and is not redirected — update any links
                or bookmarks that point to it.
              </p>
              <!-- #1261：這段原本只在勾了 Host header 時出現，句子也寫成「Host 會帶新
                   名字」好像是那個勾選造成的。實際上沒勾時 cloudflared 也原樣轉送訪客
                   的 Host（＝新網址），反向代理一樣會找不到站台（正式站實測 NPM 回
                   Default Site）——所以一律顯示、改成陳述事實。只動提示，不動行為。 -->
              <p>
                Your service will normally receive the new name as the Host header,
                even with the Host header option off. If your service routes by hostname
                (e.g. Nginx Proxy Manager) or only accepts known hosts, add the new
                hostname there before saving.
              </p>
            </div>
            <div class="o_woow_sa_add_route">
              <div class="o_woow_sa_add_route__prefix">
                <input type="text" class="o_woow_input o_woow_sa_add_route__prefix_input"
                       placeholder="subdomain prefix"
                       t-att-value="state.newRoutePrefix"
                       t-on-input="onPrefixInput"/>
                <span class="o_woow_sa_add_route__suffix">.<t t-esc="paasDomainSuffix"/></span>
              </div>
              <input type="text" class="o_woow_input o_woow_sa_add_route__svc"
                     placeholder="service URL (default from platform)"
                     t-model="state.newRouteServiceUrl"/>
              <WoowButton variant="'primary'" onClick.bind="addRoute"
                          disabled="atRouteQuota or (state.prefixCheck and !state.prefixCheck.available)">
                <WoowIcon name="'add'" size="16"/>
                <span>Add Route</span>
              </WoowButton>
            </div>
            <div class="o_woow_sa_add_route__rule">
              <WoowIcon name="'info'" size="14"/>
              <span>Subdomain may use
                <strong>lowercase letters, numbers and hyphens</strong> only.</span>
            </div>
            <div t-if="atRouteQuota" class="o_woow_sa_detail__hint o_woow_sa_detail__hint--warn">
              Route limit reached (<t t-esc="routeCount"/> / <t t-esc="state.sa.route_quota"/>).
              Remove a route or change plan to add another.
            </div>
            <div t-if="state.prefixChecking" class="o_woow_sa_detail__hint">Checking availability...</div>
            <div t-elif="state.prefixCheck and state.prefixCheck.available"
                 class="o_woow_sa_detail__hint o_woow_sa_detail__hint--ok">
              ✓ Available
            </div>
            <div t-elif="state.prefixCheck and !state.prefixCheck.available"
                 class="o_woow_sa_detail__hint o_woow_sa_detail__hint--error">
              ✗ Not available: <t t-esc="state.prefixCheck.reason"/>
            </div>
          </WoowCard>
          <WoowCard shadow="true">
            <div class="o_woow_sa_info_note">
              <div class="o_woow_sa_info_note__icon">
                <WoowIcon name="'info'" size="18"/>
              </div>
              <p>Every route forwards to your own reverse proxy. Because the
                 original <strong>Host header</strong> is preserved, your proxy
                 reads the incoming subdomain and re-routes each request to the
                 matching local service you have already started. Authentication
                 is set <strong>per route</strong> in the <strong>Access</strong>
                 tab, where each route is its own Access application with its own
                 policies.</p>
            </div>
          </WoowCard>
        </div>

        <!-- Access (P2.5 per-route：每條 route 是自己的 Cloudflare Access app) -->
        <div t-if="state.activeTab === 'access'" class="o_woow_sa_detail__body">
          <WoowCard shadow="true">
            <div class="o_woow_sa_card_head">
              <div class="o_woow_sa_card_head__icon">
                <WoowIcon name="'route'" size="20"/>
              </div>
              <div class="o_woow_sa_card_head__text">
                <h3>Protected Applications</h3>
                <p t-if="state.sa.routes and state.sa.routes.length">
                  <t t-esc="protectedRouteCount"/> of <t t-esc="state.sa.routes.length"/>
                  routes protected · each route carries its own policies
                </p>
                <p t-else="">
                  Each Application Route is its own Access application with its
                  own policies and login methods.
                </p>
              </div>
            </div>
            <div t-if="!(state.sa.routes and state.sa.routes.length)"
                 class="o_woow_sa_detail__hint">
              No application routes yet. Add a route in the Application tab,
              then protect it here.
            </div>
            <!-- 卡片本體＝共用元件（#746 抽出，Cloud Service 的 Access 頁籤用
                 同一張）。這裡只餵它「這條 route 的設定現值」與 callback，SA 自
                 己仍持有展開／排序中等 per-route 的 UI 狀態。 -->
            <t t-foreach="state.sa.routes or []" t-as="route" t-key="route.id">
              <AccessAppCard
                  hostname="route.hostname"
                  config="route"
                  expanded="isRouteExpanded(route)"
                  reordering="state.reorderingRouteId === route.id"
                  onToggleExpand="() => this.toggleRouteExpand(route)"
                  onProtectedChange="(checked) => this.onRouteProtectedToggle(route, checked)"
                  protectConfirm="protectConfirm"
                  onLoginToggle="(method) => this.toggleRouteLogin(route, method)"
                  onSessionChange="(value) => this.onRouteSessionChange(route, value)"
                  onAddPolicy="() => this.openAddPolicy(route)"
                  onEditPolicy="(pol) => this.openEditPolicy(route, pol)"
                  onDeletePolicy="(pol) => this.deletePolicy(route, pol)"
                  onReorderPolicies="(ids) => this.commitPolicyOrder(route, ids)"/>
            </t>
          </WoowCard>
          <WoowCard shadow="true" t-if="state.sa.routes and state.sa.routes.length">
            <div class="o_woow_sa_info_note">
              <div class="o_woow_sa_info_note__icon">
                <WoowIcon name="'info'" size="18"/>
              </div>
              <p>In this model, protection is scoped to a single Application
                 Route — the same way a Cloudflare Access
                 <strong>self-hosted application</strong> is defined by one
                 hostname and carries its own policies. Routes you leave public
                 are reachable by anyone.</p>
            </div>
          </WoowCard>
        </div>

        <!-- Coming Soon tabs (P3-P4) -->
        <div t-if="state.activeTab === 'email' or state.activeTab === 'domains'"
             class="o_woow_sa_detail__body">
          <WoowCard shadow="true">
            <div class="o_woow_sa_detail__coming_soon">
              <WoowIcon name="'construction'" size="48"/>
              <h3>Coming Soon</h3>
              <p>This feature is on the roadmap and will be enabled in an
                 upcoming release.</p>
            </div>
          </WoowCard>
        </div>

        <!-- Modals -->
        <SkipTrialModal t-if="state.showSkipTrialModal"
            service="state.sa"
            loadEstimate="loadSkipTrialEstimate"
            confirmSkip="confirmSkipTrial"
            onClose="() => state.showSkipTrialModal = false"
            onSkipped="onTrialSkipped"/>

        <ChangePlanModal t-if="state.showChangePlanModal"
            service="state.sa"
            currentPlanId="state.sa.subscription?.plan_id ?? undefined"
            usedRoutes="routeCount"
            loadPlans="loadSaPlans"
            confirmChange="confirmSaChangePlan"
            onClose="() => state.showChangePlanModal = false"
            onChanged="onPlanChanged"/>

        <AddPolicyModal t-if="state.showPolicyModal and state.policyModalRoute"
            policy="state.editingPolicy"
            savePolicy="savePolicy"
            onClose="() => state.showPolicyModal = false"
            onSaved.bind="onPolicySaved"/>

        <!-- 刪除單一 route 前的確認。後果要在按下去之前講清楚：舊網址當場失
             效（DNS 與 tunnel ingress 一起拆）、不轉址，這條 route 自己的 Access
             app 與 policy 一併刪除，subdomain 被放掉。 -->
        <div t-if="state.confirmDeleteRoute" class="o_woow_modal_backdrop">
          <div class="o_woow_modal">
            <div class="o_woow_modal_header"><h2>Delete this route?</h2></div>
            <div class="o_woow_modal_body">
              <p>
                <strong class="o_woow_sa_detail__mono" t-esc="state.confirmDeleteRoute.hostname"/>
                stops working immediately: its DNS record and tunnel route on
                Cloudflare are removed, and there is no redirect to another
                address.
              </p>
              <p>Access protection and policies on this route are deleted with
                 it, and the subdomain is released. This cannot be undone.</p>
            </div>
            <div class="o_woow_modal_footer">
              <WoowButton variant="'secondary'"
                          disabled="state.deletingRoute"
                          onClick.bind="cancelRemoveRoute">Cancel</WoowButton>
              <WoowButton variant="'danger'"
                          disabled="state.deletingRoute"
                          onClick.bind="removeRoute">
                <t t-if="state.deletingRoute">Deleting…</t>
                <t t-else="">Delete route</t>
              </WoowButton>
            </div>
          </div>
        </div>

        <div t-if="state.showDeleteConfirm" class="o_woow_modal_backdrop">
          <div class="o_woow_modal">
            <div class="o_woow_modal_header"><h2>Delete Security Access?</h2></div>
            <div class="o_woow_modal_body">
              <p>This permanently deletes the tunnel, all application routes
                 and DNS records on Cloudflare. Your connector will be
                 disconnected immediately. This cannot be undone.</p>
            </div>
            <div class="o_woow_modal_footer">
              <WoowButton variant="'secondary'"
                          onClick="() => state.showDeleteConfirm = false">Cancel</WoowButton>
              <WoowButton variant="'danger'" onClick.bind="deleteSa">Delete</WoowButton>
            </div>
          </div>
        </div>
      </t>
    </div>
  </t>
</templates>
