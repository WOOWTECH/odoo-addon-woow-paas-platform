<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Smart Home Template Form View -->
    <record id="view_smart_home_template_form" model="ir.ui.view">
        <field name="name">woow_paas_platform.smart_home_template.form</field>
        <field name="model">woow_paas_platform.smart_home_template</field>
        <field name="arch" type="xml">
            <form string="Smart Home Template">
                <sheet>
                    <field name="icon" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Template Name (e.g., Home Assistant)"/>
                        </h1>
                        <field name="slug" placeholder="template-slug"/>
                    </div>
                    <group>
                        <group string="Catalog">
                            <field name="description" placeholder="Short description"/>
                            <field name="is_active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Subscription Plans" name="plans">
                            <field name="subscription_plan_ids" nolabel="1">
                                <list>
                                    <field name="name"/>
                                    <field name="sh_plan_price"/>
                                    <field name="sh_unit"/>
                                    <field name="sh_trial"/>
                                    <field name="sh_trial_duration"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="full_description" nolabel="1"
                                   placeholder="Detailed description with features and use cases"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Smart Home Template List View -->
    <record id="view_smart_home_template_list" model="ir.ui.view">
        <field name="name">woow_paas_platform.smart_home_template.list</field>
        <field name="model">woow_paas_platform.smart_home_template</field>
        <field name="arch" type="xml">
            <list string="Smart Home Templates">
                <field name="name"/>
                <field name="slug"/>
                <field name="description"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <!-- Smart Home Template Action -->
    <record id="action_smart_home_template" model="ir.actions.act_window">
        <field name="name">Smart Home Templates</field>
        <field name="res_model">woow_paas_platform.smart_home_template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Smart Home Template
            </p>
            <p>
                Smart Home Templates define which subscription plans are available
                when end users create a new Smart Home instance.
            </p>
        </field>
    </record>

    <!-- Menu under Woow PaaS → Smart Home -->
    <menuitem
        id="menu_smart_home_templates"
        name="Templates"
        parent="menu_smart_home"
        action="action_smart_home_template"
        sequence="10"/>
</odoo>
