<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="paas_app" name="Woow PaaS Application">
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="theme-color" content="#6183FC"/>
                <link rel="icon" type="image/png" href="/woow_paas_platform/static/description/icon.png"/>
                <title>Woow PaaS Platform</title>
                <link rel="preconnect" href="https://fonts.googleapis.com"/>
                <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
                <!-- Google Fonts: Manrope & Outfit -->
                <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&amp;family=Outfit:wght@300..700&amp;family=Poppins:wght@500;600&amp;family=Noto+Sans+TC:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
                <link href="https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css" rel="stylesheet"/>
                <!-- Material Symbols Outlined: display=block, not swap. With swap the
                     ligature names ("notifications", "dashboard"…) render as plain text
                     until the font arrives, which is what a cold-cache visit sees. -->
                <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=block" rel="stylesheet"/>
                <!-- Inline so it applies even if the asset bundle never loads: keep the
                     boot panel hidden for normal loads, show it if loading is slow, and
                     show it at once when bootPaaS() marks it as a failure (role=alert). -->
                <style>
                    #woow-paas-boot { visibility: hidden; animation: woow-boot-reveal 0s linear 1.5s forwards; }
                    #woow-paas-boot[role="alert"] { visibility: visible; animation: none; }
                    @keyframes woow-boot-reveal { to { visibility: visible; } }
                </style>
                <script type="text/javascript">
                    var odoo = {
                        csrf_token: "<t t-esc="request.csrf_token(None)"/>",
                        debug: "<t t-out="debug"/>",
                        __session_info__: <t t-out="json.dumps(session_info)"/>,
                    };
                </script>
                <t t-call-assets="woow_paas_platform.assets_paas"/>
            </head>
            <body>
                <!-- This remains usable even if the asset bundle never executes. -->
                <section id="woow-paas-boot" class="o_woow_app p-4" role="status"
                         aria-live="polite" aria-busy="true">
                    <h1>Woow PaaS</h1>
                    <p data-boot-message="">Loading your workspace…</p>
                    <p data-boot-failure="" hidden="hidden">We couldn't start Woow PaaS. Please try again.</p>
                    <p>If loading takes too long, you can reload this page.</p>
                    <noscript>
                        <p>JavaScript is required to use Woow PaaS. Enable JavaScript, then try again.</p>
                    </noscript>
                    <a href="/woow" class="o_woow_btn o_woow_btn_primary o_woow_btn_md">Try again</a>
                </section>
                <div id="woow-paas-root" data-boot-state="loading"/>
            </body>
        </html>
    </template>
</odoo>
