<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.woow.paas</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Woow PaaS" string="Woow PaaS" name="woow_paas_platform">
                    <block title="PaaS Operator Configuration" name="paas_operator">
                        <setting string="Operator Connection"
                                 help="Configure connection to the PaaS Operator service for Kubernetes deployments.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="woow_paas_operator_url" class="col-lg-3 o_light_label"/>
                                    <field name="woow_paas_operator_url"
                                           placeholder="http://paas-operator:8000"
                                           class="col-lg-6"/>
                                </div>
                                <div class="row mt8">
                                    <label for="woow_paas_operator_api_key" class="col-lg-3 o_light_label"/>
                                    <field name="woow_paas_operator_api_key"
                                           password="True"
                                           placeholder="Enter API Key"
                                           class="col-lg-6"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Domain Configuration"
                                 help="Configure the base domain for deployed services.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="woow_paas_domain" class="col-lg-3 o_light_label"/>
                                    <field name="woow_paas_domain"
                                           placeholder="woowtech.io"
                                           class="col-lg-6"/>
                                </div>
                                <div class="row mt16">
                                    <label for="woow_paas_namespace_prefix" class="col-lg-3 o_light_label"/>
                                    <field name="woow_paas_namespace_prefix"
                                           placeholder="paas-ws-"
                                           class="col-lg-6"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Subscription Lifecycle" name="subscription_lifecycle">
                        <setting string="Subscription Journal"
                                 help="Accounting journal used for subscription invoices.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="woow_subscription_journal_id" class="col-lg-3 o_light_label"/>
                                    <field name="woow_subscription_journal_id"
                                           domain="[('type', '=', 'sale'), ('company_id', '=', company_id)]"
                                           class="col-lg-6"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Grace Period"
                                 help="Days after subscription expiry before service gets suspended.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="woow_subscription_grace_days" class="col-lg-3 o_light_label"/>
                                    <field name="woow_subscription_grace_days" class="col-lg-2"/>
                                    <span class="col-lg-3 text-muted">days</span>
                                </div>
                            </div>
                        </setting>
                        <setting string="Auto Cleanup"
                                 help="Months after cancellation before permanently removing services.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="woow_subscription_cleanup_months" class="col-lg-3 o_light_label"/>
                                    <field name="woow_subscription_cleanup_months" class="col-lg-2"/>
                                    <span class="col-lg-3 text-muted">months</span>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Credit Top-up Plans" name="topup_plans">
                        <setting string="Top-up Plans"
                                 help="Configure credit top-up packages available in the store.">
                            <div class="content-group">
                                <div class="mt8">
                                    <button name="%(action_topup_plan)d"
                                            type="action"
                                            string="Manage Top-up Plans"
                                            class="btn-link"
                                            icon="fa-arrow-right"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="AI Assistant Configuration" name="ai_assistant">
                        <setting string="AI Configuration"
                                 help="Select the AI configuration and assistant for AI features.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="woow_ai_config_id" class="col-lg-3 o_light_label"/>
                                    <field name="woow_ai_config_id"
                                           class="col-lg-6"/>
                                </div>
                                <div class="row mt8">
                                    <label for="woow_ai_assistant_id" class="col-lg-3 o_light_label"/>
                                    <field name="woow_ai_assistant_id"
                                           class="col-lg-6"/>
                                </div>
                                <div class="mt8">
                                    <button name="action_test_ai_connection"
                                            type="object"
                                            string="Test Connection"
                                            class="btn-secondary"
                                            icon="fa-plug"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="MCP Servers" name="mcp_servers">
                        <setting string="MCP Server Management"
                                 help="Manage MCP (Model Context Protocol) servers that provide external tools for AI Assistants.">
                            <div class="content-group">
                                <div class="mt8">
                                    <button name="%(action_mcp_server)d"
                                            type="action"
                                            string="Manage MCP Servers"
                                            class="btn-link"
                                            icon="fa-arrow-right"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
