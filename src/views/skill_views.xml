<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Skill List View -->
    <record id="view_skill_list" model="ir.ui.view">
        <field name="name">woow_paas_platform.skill.list</field>
        <field name="model">woow_paas_platform.skill</field>
        <field name="arch" type="xml">
            <list string="Skills" create="false">
                <header>
                    <button name="action_open_upload_wizard" type="object"
                            string="Upload Skill" display="always"
                            class="btn-primary" icon="fa-cloud-upload"/>
                </header>
                <field name="project_id"/>
                <field name="name"/>
                <field name="version"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'published'"
                       decoration-warning="state == 'deprecated'"
                       decoration-muted="state == 'archived'"
                       decoration-info="state == 'draft'"/>
                <field name="is_latest" widget="boolean_toggle" readonly="1"/>
                <field name="bundle_size_kb"/>
                <field name="uploaded_by_uid"/>
                <field name="uploaded_at"/>
            </list>
        </field>
    </record>

    <!-- Skill Form View -->
    <record id="view_skill_form" model="ir.ui.view">
        <field name="name">woow_paas_platform.skill.form</field>
        <field name="model">woow_paas_platform.skill</field>
        <field name="arch" type="xml">
            <form string="Skill" create="false">
                <header>
                    <button name="action_publish"
                            type="object"
                            string="Publish"
                            class="btn-primary"
                            icon="fa-cloud-upload"
                            invisible="state not in ('draft', 'deprecated')"/>
                    <button name="action_deprecate"
                            type="object"
                            string="Deprecate"
                            class="btn-secondary"
                            icon="fa-ban"
                            invisible="state != 'published'"/>
                    <button name="action_archive_skill"
                            type="object"
                            string="Archive"
                            class="btn-secondary"
                            icon="fa-trash"
                            invisible="state == 'archived'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,published,deprecated,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h3><field name="version" readonly="1"/></h3>
                    </div>
                    <group>
                        <group string="Identity">
                            <field name="title" readonly="1"/>
                            <field name="is_latest" readonly="1"/>
                            <field name="project_id" readonly="1"/>
                        </group>
                        <group string="Bundle">
                            <field name="bundle_sha256" readonly="1"/>
                            <field name="bundle_size_kb" readonly="1"/>
                            <field name="uploaded_by_uid" readonly="1"/>
                            <field name="uploaded_at" readonly="1"/>
                            <field name="published_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" readonly="1" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Metadata" name="metadata">
                            <field name="skill_metadata" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Skill Search View（雙層架構：Configuration 選單 = 全域目錄。
         default filter 鎖 system scope 完成 catalog 語意；admin 移除 filter
         仍可管理 user-scope（soft filter，非 hard domain — 與 MCP action 的
         hard domain 不對稱是刻意的：Skills 選單 admin-only、MCP 選單 PM 可見）-->
    <record id="view_skill_search" model="ir.ui.view">
        <field name="name">woow_paas_platform.skill.search</field>
        <field name="model">woow_paas_platform.skill</field>
        <field name="arch" type="xml">
            <search string="Skills">
                <field name="name"/>
                <field name="project_id"/>
                <filter name="filter_scope_system" string="System (Global)"
                        domain="[('scope', '=', 'system')]"/>
                <filter name="filter_scope_user" string="Project-scoped"
                        domain="[('scope', '=', 'user')]"/>
                <separator/>
                <filter name="filter_published" string="Published"
                        domain="[('state', '=', 'published')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_project" string="Project"
                            context="{'group_by': 'project_id'}"/>
                    <filter name="group_by_state" string="State"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Skill Action -->
    <record id="action_skill" model="ir.actions.act_window">
        <field name="name">Skills</field>
        <field name="res_model">woow_paas_platform.skill</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_skill_search"/>
        <field name="context">{'create': False, 'search_default_filter_scope_system': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No skills yet
            </p>
            <p>
                Click <b>Upload Skill</b> to add your first system skill bundle
                (a <code>.tar.gz</code>), or push one through the agent-runtime
                API. Manage their publish / deprecate / archive lifecycle here.
            </p>
        </field>
    </record>

    <!-- Menu under Project > Configuration, admin only（會議決議 2026-06-03
         議題 D：Skill 設定 by project，移到原生 Project 模組）。
         groups=base.group_system 必須保留（test_skill_admin_views.py 守線）；
         注意：實際可見性 = base.group_system 且能 render 父選單
         project.menu_project_config（project.group_project_manager）兩者皆備 -->
    <menuitem
        id="menu_skills"
        name="Skills"
        parent="project.menu_project_config"
        action="action_skill"
        groups="base.group_system"
        sequence="91"/>

    <!-- Skill Upload Wizard -->
    <record id="view_skill_upload_wizard_form" model="ir.ui.view">
        <field name="name">woow_paas_platform.skill_upload_wizard.form</field>
        <field name="model">woow_paas_platform.skill_upload_wizard</field>
        <field name="arch" type="xml">
            <form string="Upload Skill">
                <p class="text-muted">
                    Upload a <code>.tar.gz</code> skill bundle. Name / version
                    must match the bundle's SKILL.md. The skill is created as
                    <b>draft</b> (system scope) — publish it afterwards.
                </p>
                <group>
                    <group>
                        <field name="name"/>
                        <field name="version"/>
                    </group>
                    <group>
                        <field name="title"/>
                    </group>
                </group>
                <group>
                    <field name="description"/>
                    <field name="bundle_file" filename="bundle_filename"
                           widget="binary"/>
                    <field name="bundle_filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_upload" type="object"
                            string="Upload" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_skill_upload_wizard" model="ir.actions.act_window">
        <field name="name">Upload Skill</field>
        <field name="res_model">woow_paas_platform.skill_upload_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_woow_paas_platform_skill"/>
        <field name="binding_view_types">list,form</field>
    </record>
</odoo>
