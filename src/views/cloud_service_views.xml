<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Cloud Service Form View -->
    <record id="view_cloud_service_form" model="ir.ui.view">
        <field name="name">woow_paas_platform.cloud_service.form</field>
        <field name="model">woow_paas_platform.cloud_service</field>
        <field name="arch" type="xml">
            <!-- #519：同 list view，後台不提供 Create（理由見 list 的註解）。 -->
            <form string="Cloud Service" create="false">
                <header>
                    <button name="action_redeploy" type="object"
                            string="Redeploy" icon="fa-refresh"
                            confirm="Re-apply this product's current chart version to the service (in-place helm upgrade; data volumes are kept). If the release no longer exists, the service is installed again. Continue?"
                            class="oe_highlight"
                            invisible="state in ('pending', 'deploying', 'deleting')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,deploying,running"/>
                </header>
                <sheet>
                    <!-- #1647：服務顯示 running，但某個 workload 期望有 Pod、實際一顆都沒有
                         （例：被 namespace quota 擋下）。由背景 cron 寫入、恢復後自動清掉；
                         不改 state。detail 含叢集原文，只給系統管理員。
                         第二個時間是 workload_checked_at＝最後一次**寫入**觀測結果的時間
                         （內容沒變的檢查不更新它），所以文字寫 last change recorded，
                         不寫 last checked。
                         代碼的標籤刻意短（列表的徽章放得下，瀏覽器實走 F5），完整的說明是
                         下面依代碼顯示的那一行——每個代碼各一行，新增代碼時要補。
                         ⚠ 這段可見文字會被拆成多個翻譯 term（<strong> 整段連標籤、兩段
                         <field/> 後面的文字、每個代碼的說明各一段），改字要同步
                         src/i18n/zh_TW.po。 -->
                    <div class="alert alert-danger" role="alert" groups="base.group_system"
                         invisible="not workload_fault_code">
                        <strong>This service is marked running, but a workload has no pods or none of its pods is ready.</strong>
                        <div>
                            <field name="workload_fault_code" nolabel="1"/> — first seen
                            <field name="workload_fault_since" nolabel="1"/>, last change recorded
                            <field name="workload_checked_at" nolabel="1"/>
                        </div>
                        <div invisible="workload_fault_code != 'quota_exceeded'">The namespace ResourceQuota rejected the pods (FailedCreate: exceeded quota).</div>
                        <div invisible="workload_fault_code != 'create_failed'">The cluster rejected the pods for a reason other than the quota (FailedCreate).</div>
                        <div invisible="workload_fault_code != 'no_pods'">The pods are missing and the cause is unknown: the cluster reported no FailedCreate condition and no recent warning event.</div>
                        <div invisible="workload_fault_code != 'oom_killed'">The pods exist but none of them is ready, and a container was last killed for running out of memory (OOMKilled): the memory limit is too small for the workload.</div>
                        <div invisible="workload_fault_code != 'crash_loop'">The pods exist but none of them is ready, and a container keeps crashing and restarting (CrashLoopBackOff): check the container logs.</div>
                        <div invisible="workload_fault_code != 'not_ready'">The pods exist but none of them is ready, and the cluster reported no crash: check the readiness probe and the container logs.</div>
                        <field name="workload_fault_detail" nolabel="1"/>
                    </div>
                    <!-- #1408：Redeploy 後 chart／image 與範本不符的提示（相符時為空、不顯示）。 -->
                    <div class="alert alert-warning" role="alert"
                         invisible="not redeploy_check_message">
                        <field name="redeploy_check_message" nolabel="1"/>
                    </div>
                    <!-- #1610：訂閱已回到 in_progress、服務仍停權——還有未付清的發票（付清或帳務
                         管理員在訂閱上人工確認付款後才復權）。 -->
                    <div class="alert alert-warning" role="alert" groups="base.group_system"
                         invisible="not resume_hold_reason">
                        <field name="resume_hold_reason" nolabel="1"/>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Service Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Basic Info">
                            <field name="workspace_id"/>
                            <field name="template_id"/>
                            <field name="reference_id"/>
                            <field name="subdomain"/>
                            <field name="custom_domain"/>
                        </group>
                        <group string="Timestamps">
                            <field name="deployed_at"/>
                            <field name="last_upgraded_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Helm Config" name="helm">
                            <group>
                                <group>
                                    <field name="helm_release_name"/>
                                    <field name="helm_namespace"/>
                                    <field name="helm_revision"/>
                                    <field name="helm_chart_version"/>
                                </group>
                            </group>
                            <group string="Helm Values">
                                <field name="helm_values" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Resources" name="resources">
                            <group>
                                <group>
                                    <field name="allocated_vcpu"/>
                                    <field name="allocated_ram_gb"/>
                                    <field name="allocated_storage_gb"/>
                                </group>
                            </group>
                        </page>
                        <page string="Odoo Addons" name="odoo_addons">
                            <field name="odoo_addon_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="technical_name"/>
                                    <field name="category"/>
                                    <field name="source_type"/>
                                </list>
                            </field>
                        </page>
                        <page string="Errors" name="errors"
                              invisible="not error_message and not init_error">
                            <group>
                                <field name="error_message"/>
                                <!-- #1416：有值＝這筆 error 是部署逾時寫的，背景仍在重查、就緒會自動恢復。 -->
                                <field name="transition_timeout_at"
                                       invisible="not transition_timeout_at"/>
                                <field name="init_error"/>
                                <field name="init_retries"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Cloud Service List View -->
    <record id="view_cloud_service_list" model="ir.ui.view">
        <field name="name">woow_paas_platform.cloud_service.list</field>
        <field name="model">woow_paas_platform.cloud_service</field>
        <field name="arch" type="xml">
            <!-- #519：後台不提供 Create。cloud_service 只能由平台的開通流程建立
                 （`create()` 的 sentinel 閘），後台裸建一筆沒有 helm release、
                 沒有訂閱的 service 本來就會被 deploy cron 撿去部署。閘加上去之後
                 那顆按鈕會固定報錯，留著只是誤導。 -->
            <list string="Cloud Services" create="false">
                <field name="name"/>
                <field name="workspace_id"/>
                <field name="template_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'running'"
                       decoration-info="state in ('pending', 'deploying', 'initializing', 'upgrading')"
                       decoration-danger="state == 'error'"
                       decoration-warning="state == 'deleting'"/>
                <!-- #1647：running 但 workload 沒有 Pod（空值時不顯示徽章）。 -->
                <field name="workload_fault_code" optional="show" widget="badge" decoration-danger="workload_fault_code"/>
                <field name="subdomain"/>
                <field name="helm_namespace"/>
                <field name="deployed_at"/>
                <button name="action_redeploy" type="object"
                        string="Redeploy" icon="fa-refresh"
                        confirm="Re-apply this product's current chart version to the service (in-place helm upgrade; data volumes are kept). If the release no longer exists, the service is installed again. Continue?"/>
            </list>
        </field>
    </record>

    <!-- Cloud Service Action -->
    <record id="action_cloud_service" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">woow_paas_platform.cloud_service</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No cloud services deployed yet
            </p>
            <p>
                Cloud services are deployed from application templates via the marketplace.
            </p>
        </field>
    </record>

    <!-- Menu under Cloud -->
    <menuitem
        id="menu_cloud_services"
        name="Services"
        parent="menu_cloud"
        action="action_cloud_service"
        sequence="20"/>
</odoo>
