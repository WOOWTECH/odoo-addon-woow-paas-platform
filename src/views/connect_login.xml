<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Website replaces the entire native login layout. Wrap the resolved
         outer call, so both Website installations and plain web keep their
         original layout for ordinary logins. The native auth form is t-out=0. -->
    <template id="connect_login_layout" inherit_id="web.login_layout" name="woowtech connect login" priority="90">
        <xpath expr="t" position="replace">
            <t t-if="request.env.context.get('woow_connect_login')">
                <t t-call="web.frontend_layout">
                    <t t-set="title" t-value="request.env.context.get('woow_connect_title', '智慧平台連結') + '｜woowtech'"/>
                    <t t-set="no_header" t-value="True"/>
                    <t t-set="no_footer" t-value="True"/>
                    <t t-set="body_classname" t-value="'o_woow_connect_login_page'"/>
                    <t t-set="head"><t t-out="head or ''"/><t t-call="woow_paas_platform.connect_assets"/></t>
                    <main class="o_woow_connect_login_wrap">
                        <div class="card border-0 o_woow_connect_login">
                            <div class="card-body">
                                <t t-call="woow_paas_platform.connect_brand"/>
                                <h1 t-out="request.env.context.get('woow_connect_title', '登入並連結智慧平台')"/>
                                <t t-out="0"/>
                            </div>
                        </div>
                    </main>
                </t>
            </t>
            <t t-else="">$0</t>
        </xpath>
    </template>
</odoo>
