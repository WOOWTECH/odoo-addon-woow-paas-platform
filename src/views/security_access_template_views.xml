<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Security Access Template Form View -->
    <record id="view_security_access_template_form" model="ir.ui.view">
        <field name="name">woow_paas_platform.security_access_template.form</field>
        <field name="model">woow_paas_platform.security_access_template</field>
        <field name="arch" type="xml">
            <form string="Security Access Template">
                <sheet>
                    <field name="icon" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Template Name (e.g., Security Access)"/>
                        </h1>
                        <field name="slug" placeholder="template-slug"/>
                    </div>
                    <group>
                        <group string="Catalog">
                            <field name="description" placeholder="Short description"/>
                            <field name="is_active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Subscription Plans" name="plans">
                            <field name="subscription_plan_ids" nolabel="1">
                                <list>
                                    <field name="name"/>
                                    <field name="sh_plan_price"/>
                                    <field name="sh_unit"/>
                                    <field name="sh_trial"/>
                                    <field name="sh_trial_duration"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="full_description" nolabel="1"
                                   placeholder="Detailed description with features and use cases"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Security Access Template List View -->
    <record id="view_security_access_template_list" model="ir.ui.view">
        <field name="name">woow_paas_platform.security_access_template.list</field>
        <field name="model">woow_paas_platform.security_access_template</field>
        <field name="arch" type="xml">
            <list string="Security Access Templates">
                <field name="name"/>
                <field name="slug"/>
                <field name="description"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <!-- Security Access Template Action -->
    <record id="action_security_access_template" model="ir.actions.act_window">
        <field name="name">Security Access Templates</field>
        <field name="res_model">woow_paas_platform.security_access_template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Security Access Template
            </p>
            <p>
                Security Access Templates define which subscription plans are available
                when end users create a new Security Access instance.
            </p>
        </field>
    </record>

    <!-- Menu under Woow PaaS → Security Access -->
    <menuitem
        id="menu_security_access_templates"
        name="Templates"
        parent="menu_security_access"
        action="action_security_access_template"
        sequence="10"/>
</odoo>
