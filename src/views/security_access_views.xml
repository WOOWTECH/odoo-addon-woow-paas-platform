<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Security Access Form View -->
    <record id="view_security_access_form" model="ir.ui.view">
        <field name="name">woow_paas_platform.security_access.form</field>
        <field name="model">woow_paas_platform.security_access</field>
        <field name="arch" type="xml">
            <form string="Security Access">
                <header>
                    <button name="action_provision" type="object"
                            string="Provision" icon="fa-cloud-upload"
                            class="oe_highlight"
                            invisible="state not in ('pending', 'error')"/>
                    <button name="action_refresh_status" type="object"
                            string="Refresh Status" icon="fa-refresh"
                            invisible="state != 'active'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,provisioning,active"/>
                </header>
                <sheet>
                    <!-- #1610：同 Cloud Service 表單——訂閱已恢復、還有未付清的發票所以仍停權。 -->
                    <div class="alert alert-warning" role="alert" groups="base.group_system"
                         invisible="not resume_hold_reason">
                        <field name="resume_hold_reason" nolabel="1"/>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nickname (e.g. secure-gateway)"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Identity">
                            <field name="workspace_id"/>
                            <field name="template_id"/>
                            <field name="reference_id" readonly="1"/>
                            <field name="canonical_name" readonly="1"/>
                        </group>
                        <group string="Tunnel">
                            <field name="tunnel_id" readonly="1"/>
                            <field name="tunnel_status" readonly="1"/>
                            <field name="connector_type" readonly="1"/>
                            <field name="connector_version" readonly="1"/>
                            <field name="edge_connection_count" readonly="1"/>
                            <field name="deployed_at" readonly="1"/>
                        </group>
                        <!-- #1766：一條 tunnel 只給一台 HA 接。connector_count
                             是機器數（distinct client_id），和上面的
                             edge_connection_count（一台預設 4 條）不是同一回事。 -->
                        <group string="Home Assistant Binding">
                            <field name="binding_state" readonly="1"/>
                            <field name="bound_instance_label" readonly="1"/>
                            <field name="bound_instance_uid" readonly="1"
                                   groups="base.group_system"/>
                            <field name="bound_at" readonly="1"/>
                            <field name="connector_count" readonly="1"/>
                            <field name="binding_conflict" readonly="1"
                                   invisible="not binding_conflict"
                                   decoration-danger="binding_conflict"/>
                            <div colspan="2" class="alert alert-danger" role="alert"
                                 invisible="not binding_conflict">
                                Two machines are attached to this tunnel. Cloudflare
                                sends each request to whichever answers first, so the
                                public address reaches the wrong machine about half the
                                time. Stop the tunnel on the machine that should not
                                have it; releasing the binding here does not disconnect
                                it (the token it already holds stays valid).
                            </div>
                            <button name="action_release_binding" type="object"
                                    string="Release binding"
                                    class="btn-secondary" colspan="2"
                                    confirm="The next Home Assistant that asks for this tunnel's token will be able to take it over. The installation that holds the token now is NOT disconnected by this — to cut it off you have to delete and recreate this access. Continue?"
                                    invisible="binding_state == 'unbound'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Application Routes" name="routes">
                            <field name="route_ids">
                                <list editable="bottom">
                                    <field name="subdomain_prefix"/>
                                    <field name="hostname" readonly="1"/>
                                    <field name="service_url"/>
                                    <field name="http_host_header"/>
                                    <field name="is_protected"/>
                                </list>
                            </field>
                        </page>
                        <page string="Subscription" name="subscription">
                            <group>
                                <field name="subscription_id" readonly="1"/>
                                <field name="subscription_state" readonly="1"/>
                                <field name="subscription_plan_name" readonly="1"/>
                                <field name="subscription_next_payment" readonly="1"/>
                            </group>
                        </page>
                        <page string="Errors" name="errors"
                              invisible="not error_message">
                            <field name="error_message" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Security Access List View -->
    <record id="view_security_access_list" model="ir.ui.view">
        <field name="name">woow_paas_platform.security_access.list</field>
        <field name="model">woow_paas_platform.security_access</field>
        <field name="arch" type="xml">
            <list string="Security Access"
                  decoration-success="state == 'active'"
                  decoration-warning="state == 'suspended'"
                  decoration-danger="state == 'error'">
                <field name="name"/>
                <field name="canonical_name"/>
                <field name="workspace_id"/>
                <field name="state" widget="badge"/>
                <field name="tunnel_status"/>
                <field name="route_count"/>
                <field name="subscription_state"/>
            </list>
        </field>
    </record>

    <!-- Action + Menu (platform ops only).
         The /woow frontend (BFF, role owner/admin + subscription gate) is the
         tenant entry point. The backend SA form exposes an editable route
         list + Provision button that walk the ORM directly, bypassing the BFF
         gates; restricting the action/menu to base.group_system removes that
         discoverable bypass surface for plain base.group_user members. The
         ir.rule read/write split (ir_rules.xml) is the authoritative defence
         even if the action is reached by URL. -->
    <record id="action_security_access" model="ir.actions.act_window">
        <field name="name">Security Access</field>
        <field name="res_model">woow_paas_platform.security_access</field>
        <field name="view_mode">list,form</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Security Access instances yet
            </p>
            <p>
                Security Access instances are normally created by users
                from the /woow frontend with a subscription.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_security_access_instances"
        name="Instances"
        parent="menu_security_access"
        action="action_security_access"
        groups="base.group_system"
        sequence="5"/>
</odoo>
