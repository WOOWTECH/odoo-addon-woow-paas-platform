<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="connect_assets" name="woowtech connect assets">
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600&amp;family=Outfit:wght@400;500;600&amp;family=Noto+Sans+TC:wght@400;500;600;700&amp;display=swap"/>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css"/>
        <link rel="stylesheet" href="/woow_paas_platform/static/src/connect/connect.css"/>
    </template>
    <template id="connect_brand" name="woowtech connect brand">
        <a href="/woow" class="oauth-logo" aria-label="woowtech 平台首頁">woowtech</a>
        <p class="oauth-eyebrow">智慧平台連結</p>
    </template>
    <template id="connect_scopes" name="woowtech permission list">
        <div class="oauth-scopes">
            <h2 class="oauth-scopes-title">允許後，這個應用程式可以：</h2>
            <t t-foreach="scopes" t-as="s">
                <div class="oauth-scope-item"><span class="mdi mdi-check" aria-hidden="true"/><span t-esc="s['description']"/></div>
            </t>
        </div>
        <p class="oauth-note" t-if="any(s['name'] == 'smarthome:provision' for s in scopes)">
            沒有工作區或所選類型的服務時，會自動建立並開始七天免費試用。
            試用到期後暫停，需主動選擇付費方案才會收費。
        </p>
    </template>
    <template id="oauth2_authorize" name="OAuth 2.0 Authorization">
        <html lang="zh-Hant"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><t t-call="woow_paas_platform.connect_assets"/><title>連結 Home Assistant｜woowtech</title></head>
            <body class="ww-connect"><main class="oauth-card"><t t-call="woow_paas_platform.connect_brand"/>
                <h1>連結你的 Home Assistant</h1>
                <p><span class="oauth-client-name" t-esc="client_name"/> 正在要求存取你的帳號。</p>
                <t t-call="woow_paas_platform.connect_scopes"/>
                <form method="POST" action="/oauth2/authorize">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token(None)"/>
                    <input type="hidden" name="client_id" t-att-value="client_id"/>
                    <input type="hidden" name="redirect_uri" t-att-value="redirect_uri"/>
                    <input type="hidden" name="scope" t-att-value="scope"/>
                    <input type="hidden" name="state" t-att-value="state"/>
                    <input type="hidden" name="response_type" t-att-value="response_type"/>
                    <input type="hidden" name="code_challenge" t-att-value="code_challenge"/>
                    <input type="hidden" name="code_challenge_method" t-att-value="code_challenge_method"/>
                    <div class="oauth-actions"><button type="submit" name="deny" value="1" class="oauth-btn oauth-btn-deny">取消</button><button type="submit" name="approve" value="1" class="oauth-btn oauth-btn-allow"><span class="mdi mdi-link-variant" aria-hidden="true"/>允許連結</button></div>
                </form>
                <div class="oauth-user-info">目前登入：<t t-esc="request.env.user.login"/></div>
            </main></body>
        </html>
    </template>
    <template id="oauth2_error" name="OAuth 2.0 Error">
        <html lang="zh-Hant"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><t t-call="woow_paas_platform.connect_assets"/><title>無法完成授權｜woowtech</title></head>
            <body class="ww-connect"><main class="oauth-card"><t t-call="woow_paas_platform.connect_brand"/>
                <span class="mdi mdi-alert-circle-outline status-icon" aria-hidden="true"/>
                <h1 t-esc="error_title"/><p t-esc="error_message"/>
                <p>請回到 Home Assistant 重新開始連結。</p>
            </main></body>
        </html>
    </template>
    <template id="device_verify" name="Device Verification">
        <html lang="zh-Hant"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><t t-call="woow_paas_platform.connect_assets"/><title>輸入裝置代碼｜woowtech</title></head>
            <body class="ww-connect"><main class="oauth-card"><t t-call="woow_paas_platform.connect_brand"/>
                <h1>連結你的裝置</h1><p>輸入 Home Assistant 畫面上的代碼，即可繼續授權。</p>
                <p t-if="error" class="err" role="alert" t-esc="error"/>
                <form method="POST" action="/device"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token(None)"/>
                    <label for="user_code">裝置代碼</label>
                    <input id="user_code" type="text" name="user_code" class="code-input" placeholder="XXXX-XXXX" t-att-value="user_code or ''" autocomplete="one-time-code" required="required"/>
                    <div class="oauth-actions"><button type="submit" name="verify" value="1" class="oauth-btn oauth-btn-allow">繼續</button></div>
                </form>
            </main></body>
        </html>
    </template>
    <template id="device_consent" name="Device Consent">
        <html lang="zh-Hant"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><t t-call="woow_paas_platform.connect_assets"/><title>確認裝置連結｜woowtech</title></head>
            <body class="ww-connect"><main class="oauth-card"><t t-call="woow_paas_platform.connect_brand"/>
                <h1>確認連結裝置</h1><p><span class="oauth-client-name" t-esc="client_name"/> 正在要求存取你的帳號。</p>
                <p>請確認下方代碼與你裝置上顯示的相同：</p><div class="device-code" t-esc="user_code"/>
                <t t-call="woow_paas_platform.connect_scopes"/>
                <form method="POST" action="/device"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token(None)"/><input type="hidden" name="user_code" t-att-value="user_code"/><div class="oauth-actions"><button type="submit" name="deny" value="1" class="oauth-btn oauth-btn-deny">取消</button><button type="submit" name="approve" value="1" class="oauth-btn oauth-btn-allow"><span class="mdi mdi-link-variant" aria-hidden="true"/>允許連結</button></div></form>
                <div class="oauth-user-info">目前登入：<t t-esc="request.env.user.login"/></div>
            </main></body>
        </html>
    </template>
    <template id="device_result" name="Device Result">
        <html lang="zh-Hant"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><t t-call="woow_paas_platform.connect_assets"/><title><t t-if="approved">授權已完成</t><t t-else="">已取消授權</t>｜woowtech</title></head>
            <body class="ww-connect"><main class="oauth-card"><t t-call="woow_paas_platform.connect_brand"/>
                <t t-if="approved">
                    <span class="mdi mdi-check-circle-outline status-icon" aria-hidden="true"/>
                    <h1>授權已完成</h1><p>請回到 Home Assistant，繼續選擇工作區與服務。連線狀態會在設定完成後顯示。</p>
                </t>
                <t t-else="">
                    <span class="mdi mdi-close-circle-outline status-icon" aria-hidden="true"/>
                    <h1>已取消授權</h1><p>如要連結，請回到 Home Assistant 重新開始設定。</p>
                </t>
            </main></body>
        </html>
    </template>
</odoo>
