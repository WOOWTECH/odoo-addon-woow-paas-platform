<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_llm_known_discrepancy_list" model="ir.ui.view">
        <field name="name">woow_paas_platform.llm_known_discrepancy.list</field>
        <field name="model">woow_paas_platform.llm_known_discrepancy</field>
        <field name="arch" type="xml">
            <list string="Known AI Quota Differences" create="0" edit="0" delete="0">
                <field name="created_at"/>
                <field name="account_id"/>
                <field name="quota_delta_text" string="Quota difference"/>
                <field name="created_uid"/>
                <field name="request_id" groups="base.group_system"/>
                <field name="llm_event_id" groups="base.group_system"/>
            </list>
        </field>
    </record>

    <record id="view_llm_known_discrepancy_form" model="ir.ui.view">
        <field name="name">woow_paas_platform.llm_known_discrepancy.form</field>
        <field name="model">woow_paas_platform.llm_known_discrepancy</field>
        <field name="arch" type="xml">
            <form string="Known AI Quota Difference" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="account_id"/>
                        <field name="quota_delta_text" string="Quota difference"/>
                        <field name="reason" groups="base.group_system"/>
                        <field name="created_uid"/>
                        <field name="created_at"/>
                        <field name="request_id" groups="base.group_system"/>
                        <field name="llm_event_id" groups="base.group_system"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_llm_known_discrepancies" model="ir.actions.act_window">
        <field name="name">Known Quota Differences</field>
        <field name="res_model">woow_paas_platform.llm_known_discrepancy</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_llm_known_discrepancies" name="Known Quota Differences"
              parent="menu_llm" action="action_llm_known_discrepancies"
              groups="base.group_system,account.group_account_manager" sequence="35"/>

    <record id="view_llm_known_discrepancy_wizard_form" model="ir.ui.view">
        <field name="name">woow_paas_platform.llm_known_discrepancy_wizard.form</field>
        <field name="model">woow_paas_platform.llm_known_discrepancy_wizard</field>
        <field name="arch" type="xml">
            <form string="Acknowledge Known Quota Difference">
                <group>
                    <field name="account_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="quota_delta" placeholder="Positive means new-api has more quota"/>
                    <field name="reason" placeholder="Explain the reconciliation evidence (10–2000 characters)."/>
                    <field name="request_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_acknowledge" type="object" string="Record difference"
                            class="btn-primary" groups="base.group_system"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_llm_account_discrepancy_action" model="ir.ui.view">
        <field name="name">woow_paas_platform.llm_account.discrepancy.action</field>
        <field name="model">woow_paas_platform.llm_account</field>
        <field name="inherit_id" ref="view_llm_account_backoffice_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="action_open_known_discrepancy_wizard" type="object"
                        string="Acknowledge quota difference" groups="base.group_system"/>
            </xpath>
        </field>
    </record>
</odoo>
